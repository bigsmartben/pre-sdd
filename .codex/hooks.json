{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/validate-harness.mjs\"",
            "commandWindows": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/validate-harness.mjs\"",
            "timeout": 30,
            "statusMessage": "Validating repository AI harness"
          }
        ]
      }
    ]
  }
}

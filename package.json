{
  "name": "pre-sdd",
  "version": "0.2.0",
  "description": "Harness-governed reusable Product Design and Architecture Design workspace scaffold",
  "type": "module",
  "bin": {
    "pre-sdd": "./bin/pre-sdd.mjs"
  },
  "files": [
    "bin/",
    "runtime/",
    "templates/workspace/",
    "README.md",
    "QUICKSTART.md"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "validate:harness": "node .psp/harness/scripts/validate-harness.mjs",
    "harness:resolve": "node .psp/harness/scripts/resolve-validation.mjs",
    "test:harness": "node --test .psp/harness/tests/scaffold/*.test.mjs",
    "test:package": "node --test tests/package/*.test.mjs",
    "test": "npm run test:harness && npm run test:package",
    "check": "npm run validate:harness && npm test && npm run pack:check",
    "pack:check": "npm pack --dry-run --json"
  },
  "dependencies": {
    "@playwright/test": "^1.61.1",
    "ajv": "^8.20.0",
    "axe-core": "^4.12.1",
    "lit": "^3.3.3",
    "msw": "^2.15.0",
    "picomatch": "^4.0.5",
    "toml": "^4.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "yaml": "^2.9.0"
  }
}

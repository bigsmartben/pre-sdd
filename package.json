{
  "name": "pre-sdd-maintainer",
  "version": "0.5.0",
  "description": "Maintainer tooling and domain tests for the sdd-pre workspace scaffold",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "test:python": "uv run --isolated python -B -m unittest discover -s tests/package -p test_*.py",
    "test:package": "node --test tests/package/png-assets.test.mjs tests/package/workspace.test.mjs",
    "test:product": "node templates/workspace/.agents/skills/product-design/tests/run-suite.mjs",
    "test:mockcase": "node --test templates/workspace/.agents/skills/mockcase/tests/*.test.mjs",
    "test:architecture": "node --test templates/workspace/.agents/skills/architecture-design/tests/*.test.mjs",
    "test:domain": "npm run test:product && npm run test:mockcase && npm run test:architecture",
    "test": "npm run test:python && npm run test:package && npm run test:domain",
    "check": "npm test && npm run pack:check",
    "pack:check": "uv run --isolated python tests/package/build_check.py"
  },
  "dependencies": {
    "@playwright/test": "^1.61.1",
    "ajv": "^8.20.0",
    "axe-core": "^4.12.1",
    "lit": "^3.3.3",
    "msw": "^2.15.0",
    "picomatch": "^4.0.5",
    "toml": "^4.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "yaml": "^2.9.0"
  },
  "project_id": "pre-sdd"
}

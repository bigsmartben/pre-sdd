{
  "$schema": ".psp/harness/schemas/harness-manifest.schema.json",
  "name": "pre-sdd-scaffold-harness",
  "version": "13.3.0",
  "repositoryKind": "scaffold",
  "entrypoints": {
    "instructions": "AGENTS.md",
    "protocol": ".psp/harness/HARNESS.md",
    "standard": ".psp/harness/HARNESS-BOUNDARY.md",
    "project": "psp.project.yaml",
    "manifest": ".psp/harness/harness.manifest.json",
    "repository": "README.md"
  },
  "schemas": {
    "manifest": ".psp/harness/schemas/harness-manifest.schema.json",
    "project": ".psp/harness/schemas/project.schema.json"
  },
  "adapters": {
    "codexProject": ".codex/config.toml",
    "hookConfig": ".codex/hooks.json",
    "hookScripts": [".codex/hooks/validate-harness.mjs"],
    "repositorySkills": [".agents/skills/apply-repository-harness/SKILL.md"]
  },
  "readOrder": [
    "AGENTS.md",
    "psp.project.yaml",
    ".psp/harness/HARNESS.md",
    ".psp/harness/HARNESS-BOUNDARY.md",
    ".psp/harness/harness.manifest.json",
    "package.json",
    "templates/workspace/AGENTS.md",
    "templates/workspace/psp.project.yaml"
  ],
  "scaffoldPolicy": {
    "governanceModel": {
      "maintainerHarness": {
        "projectKind": "PSPScaffoldProject",
        "purpose": "scaffold-maintenance",
        "authority": "scaffold-repository-local",
        "completion": "validated-scaffold-change"
      },
      "userHarness": {
        "projectKind": "PSPProject",
        "purpose": "generated-workspace-governance",
        "sourceRoot": "templates/workspace",
        "authority": "generated-workspace-local"
      },
      "lifecycleIsolation": {
        "rootDomainLifecycle": "forbidden",
        "rootDomainHandoff": "forbidden",
        "templateExternalLifecycle": "forbidden",
        "crossLifecycleControl": "forbidden"
      }
    },
    "rootSkills": {
      "root": ".agents/skills",
      "allowed": ["apply-repository-harness"]
    },
    "templateSkills": {
      "root": "templates/workspace/.agents/skills",
      "required": [
        "apply-repository-harness",
        "project-consistency",
        "product-design",
        "architecture-design",
        "capture-figma-design-source",
        "organize-figma-assets",
        "figma-component-from-design",
        "implement-figma-lit-page",
        "repair-canonical-ui-visual"
      ]
    },
    "textContracts": [
      {
        "id": "scaffold-instructions",
        "path": "AGENTS.md",
        "requiredText": ["脚手架源仓库（Scaffold Repository）", "Maintainer Harness（维护者治理层）", "PSPScaffoldProject", "不得改用包内模板副本"],
        "forbiddenText": ["仓库交付链为"]
      },
      {
        "id": "workspace-instructions",
        "path": "templates/workspace/AGENTS.md",
        "requiredText": ["生成工作区（Generated Workspace）", "User Harness（使用者治理层）", "Canonical UI Prototype", "PSPProject", "Manifest 未声明消费者时"],
        "forbiddenText": ["PSPScaffoldProject"]
      },
      {
        "id": "scaffold-standard",
        "path": ".psp/harness/HARNESS-BOUNDARY.md",
        "requiredText": ["双 Harness（双治理层）模型", "Maintainer Harness（维护者治理层）", "User Harness（使用者治理层）", "四层模型", "用户命令面与工作区生命周期", "生成仓库本地拥有运行配置、领域 Skill 与执行事实", "既有工作区不提供 update（更新）、upgrade（升级）、migrate（迁移）或 sync（同步）操作", "AIH_EXECUTOR_AUTHORITY_INVALID", "持续集成工作流从 Manifest"],
        "forbiddenText": ["根 Manifest 只登记领域"]
      },
      {
        "id": "scaffold-readme",
        "path": "README.md",
        "requiredText": ["开发者视角（Developer View）", "双 Harness（双治理层）模型", "Maintainer Harness（维护者治理层）", "User Harness（使用者治理层）", "脚手架源仓库（Scaffold Repository）", "工作区模板（Workspace Template）", "目标工作区本地文件", "既有工作区不提供更新或升级操作", "^20.19.0 || >=22.12.0", "最大门禁集合", ".psp/harness/scripts/run-ci-validation.mjs", "QUICKSTART.md"],
        "forbiddenText": ["根目录是软件包源码、开发 Harness 和仓库领域 Skill"]
      },
      {
        "id": "scaffold-quickstart",
        "path": "QUICKSTART.md",
        "requiredText": ["使用者视角（User View）", "会改变状态的公共操作只有三项", "npm install --global git+https://github.com/bigsmartben/pre-sdd.git", "pre-sdd init", "git init", "文件存在不等于", "01-product-design", "02-architecture-design", "架构设计拥有独立生命周期", "本轮只完成"],
        "forbiddenText": ["pre-sdd harness", "npm exec", "npm run", ".psp/harness/scripts/run-ci-validation.mjs"]
      },
      {
        "id": "workspace-readme",
        "path": "templates/workspace/README.md",
        "requiredText": ["生成工作区（Generated Workspace）", "User Harness（使用者治理层）", "不是 `pre-sdd` 脚手架源仓库", "文件已经存在不等于", "必须执行本次 handoff", "本地 Manifest 声明的路径加载", "本工作区不提供更新、升级、迁移或同步操作"],
        "forbiddenText": ["npm install --global"]
      },
      {
        "id": "workspace-harness-boundary",
        "path": "templates/workspace/.psp/harness/HARNESS-BOUNDARY.md",
        "requiredText": ["生成工作区 Harness 职责边界", "User Harness（使用者治理层）", "本地执行事实", "package.json` 与 `package-lock.json", "不提供更新、升级、迁移或同步操作", "不得改用包内 `templates/workspace/` 副本"],
        "forbiddenText": ["脚手架固化要求"]
      }
    ],
    "templatePurity": {
      "stageMarker": ".gitkeep",
      "forbiddenDirectoryNames": ["node_modules", "dist", ".vite", "evidence"]
    },
    "packageScripts": [
      "validate:harness",
      "harness:resolve",
      "test:harness",
      "test:template:harness",
      "test:template:product",
      "test:template:architecture",
      "test:workspace:harness",
      "test:workspace:product",
      "test:workspace:architecture",
      "test:package:fast",
      "test:package:slow",
      "test:package",
      "test",
      "check",
      "pack:check"
    ],
    "execution": {
      "runtimeAuthority": "generated-workspace-snapshot",
      "runtimeSnapshot": ".psp/runtime/pre-sdd",
      "executorAuthority": "generated-workspace-local",
      "dependencyAuthority": "generated-workspace-package-lock",
      "dependencyCache": "os-temporary-directory",
      "testWorkspace": "os-temporary-copy",
      "runtimeEvidence": "os-temporary-directory"
    },
    "continuousIntegration": {
      "workflow": ".github/workflows/harness-governance.yml",
      "runner": ".psp/harness/scripts/run-ci-validation.mjs",
      "intent": "checkpoint",
      "job": "harness-governance",
      "triggers": ["pull_request", "push"],
      "protectedBranches": ["main"],
      "runsOn": "ubuntu-latest",
      "nodeVersion": "22",
      "checkoutAction": "actions/checkout@v4",
      "setupNodeAction": "actions/setup-node@v4",
      "installCommand": "npm ci"
    },
    "releaseValidation": {
      "runner": ".psp/harness/scripts/run-ci-validation.mjs",
      "flag": "--release",
      "intent": "readiness"
    }
  },
  "commands": [
    {
      "id": "harness",
      "npmScript": "validate:harness",
      "run": "npm run validate:harness",
      "purpose": "校验脚手架项目绑定、模板纯净性、上下文隔离与工程命令",
      "blocking": true
    },
    {
      "id": "test-harness",
      "npmScript": "test:harness",
      "run": "npm run test:harness",
      "purpose": "运行脚手架硬治理回归测试",
      "blocking": true
    },
    {
      "id": "test-workspace-harness",
      "npmScript": "test:workspace:harness",
      "run": "npm run test:workspace:harness",
      "purpose": "在临时生成工作区运行 User Harness 回归测试",
      "blocking": true
    },
    {
      "id": "test-template-harness",
      "npmScript": "test:template:harness",
      "run": "npm run test:template:harness",
      "purpose": "在操作系统临时目录的模板副本运行 User Harness 快速测试",
      "blocking": true
    },
    {
      "id": "test-template-product",
      "npmScript": "test:template:product",
      "run": "npm run test:template:product",
      "purpose": "在操作系统临时目录的模板副本运行 Product Design 快速测试",
      "blocking": true
    },
    {
      "id": "test-template-architecture",
      "npmScript": "test:template:architecture",
      "run": "npm run test:template:architecture",
      "purpose": "在操作系统临时目录的模板副本运行 Architecture Design 快速测试",
      "blocking": true
    },
    {
      "id": "test-workspace-product",
      "npmScript": "test:workspace:product",
      "run": "npm run test:workspace:product",
      "purpose": "在临时生成工作区运行 Product Design 领域回归测试",
      "blocking": true
    },
    {
      "id": "test-workspace-architecture",
      "npmScript": "test:workspace:architecture",
      "run": "npm run test:workspace:architecture",
      "purpose": "在临时生成工作区运行 Architecture Design 领域回归测试",
      "blocking": true
    },
    {
      "id": "test-package",
      "npmScript": "test:package",
      "run": "npm run test:package",
      "purpose": "在临时目录验证初始化、生成工作区本地执行与包行为",
      "blocking": true
    },
    {
      "id": "test-package-fast",
      "npmScript": "test:package:fast",
      "run": "npm run test:package:fast",
      "purpose": "运行不含全局安装、浏览器和完整构建的包级快速测试",
      "blocking": true
    },
    {
      "id": "test-package-slow",
      "npmScript": "test:package:slow",
      "run": "npm run test:package:slow",
      "purpose": "运行隔离全局安装、浏览器与完整工作区构建包级慢测试",
      "blocking": true
    },
    {
      "id": "pack-check",
      "npmScript": "pack:check",
      "run": "npm run pack:check",
      "purpose": "校验 npm 包发布清单",
      "blocking": true
    }
  ],
  "validationProfiles": [
    {"id": "scaffold-structure", "commands": ["harness"]},
    {"id": "scaffold-governance", "commands": ["harness", "test-harness"]},
    {"id": "template-harness", "commands": ["harness", "test-template-harness"]},
    {"id": "template-product", "commands": ["harness", "test-template-product"]},
    {"id": "template-architecture", "commands": ["harness", "test-template-architecture"]},
    {"id": "template-shared-change", "commands": ["harness", "test-template-harness", "test-template-product", "test-template-architecture"]},
    {"id": "workspace-harness", "commands": ["harness", "test-workspace-harness"]},
    {"id": "workspace-product", "commands": ["harness", "test-workspace-product"]},
    {"id": "workspace-architecture", "commands": ["harness", "test-workspace-architecture"]},
    {"id": "workspace-template-checkpoint", "commands": ["harness", "test-workspace-harness", "test-workspace-product", "test-workspace-architecture"]},
    {"id": "scaffold-runtime", "commands": ["harness", "test-harness", "test-package"]},
    {"id": "scaffold-package", "commands": ["harness", "test-harness", "test-package", "pack-check"]}
  ],
  "scopes": [
    {
      "id": "scaffold-governance",
      "kind": "repository",
      "selectionGroup": "scaffold-governance",
      "priority": 100,
      "status": "active",
      "selector": {
        "type": "static",
        "paths": ["AGENTS.md", "README.md", "QUICKSTART.md", "psp.project.yaml", ".gitignore", ".agents/skills/**", ".codegraph/**", ".codex/**", ".github/**", ".psp/harness/**"]
      },
      "defaultProfile": "scaffold-governance",
      "checkpointProfile": "scaffold-governance",
      "readinessProfile": "scaffold-package"
    },
    {
      "id": "scaffold-runtime",
      "kind": "runtime",
      "selectionGroup": "scaffold-runtime",
      "priority": 100,
      "status": "active",
      "selector": {"type": "static", "paths": ["package.json", "package-lock.json", "bin/**", "runtime/**"]},
      "defaultProfile": "scaffold-governance",
      "checkpointProfile": "scaffold-runtime",
      "readinessProfile": "scaffold-package"
    },
    {
      "id": "workspace-product",
      "kind": "template",
      "selectionGroup": "workspace-template",
      "priority": 300,
      "status": "active",
      "selector": {"type": "static", "paths": ["templates/workspace/.agents/skills/product-design/**", "templates/workspace/.agents/skills/capture-figma-design-source/**", "templates/workspace/.agents/skills/organize-figma-assets/**", "templates/workspace/.agents/skills/figma-component-from-design/**", "templates/workspace/.agents/skills/implement-figma-lit-page/**", "templates/workspace/.agents/skills/repair-canonical-ui-visual/**"]},
      "defaultProfile": "template-product",
      "checkpointProfile": "workspace-product",
      "readinessProfile": "scaffold-package"
    },
    {
      "id": "workspace-architecture",
      "kind": "template",
      "selectionGroup": "workspace-template",
      "priority": 300,
      "status": "active",
      "selector": {"type": "static", "paths": ["templates/workspace/.agents/skills/architecture-design/**"]},
      "defaultProfile": "template-architecture",
      "checkpointProfile": "workspace-architecture",
      "readinessProfile": "scaffold-package"
    },
    {
      "id": "workspace-user-harness",
      "kind": "template",
      "selectionGroup": "workspace-template",
      "priority": 300,
      "status": "active",
      "selector": {"type": "static", "paths": ["templates/workspace/.psp/harness/**", "templates/workspace/.agents/skills/apply-repository-harness/**"]},
      "defaultProfile": "template-harness",
      "checkpointProfile": "workspace-template-checkpoint",
      "readinessProfile": "scaffold-package"
    },
    {
      "id": "workspace-template",
      "kind": "template",
      "selectionGroup": "workspace-template",
      "priority": 100,
      "status": "active",
      "selector": {"type": "static", "paths": ["templates/workspace/**"]},
      "defaultProfile": "template-shared-change",
      "checkpointProfile": "workspace-template-checkpoint",
      "readinessProfile": "scaffold-package"
    },
    {
      "id": "package-tests",
      "kind": "tests",
      "selectionGroup": "package-tests",
      "priority": 100,
      "status": "active",
      "selector": {"type": "static", "paths": ["tests/package/**"]},
      "defaultProfile": "scaffold-runtime",
      "checkpointProfile": "scaffold-runtime",
      "readinessProfile": "scaffold-package"
    }
  ],
  "evidenceReport": {
    "requiredFields": ["scope", "changes", "validation", "residuals"],
    "validationStates": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"]
  },
  "blockers": [
    {"code": "AIH_PROJECT_BINDING_INVALID", "severity": "blocker", "owner": "scaffold-harness", "meaning": "脚手架项目绑定缺失、越界或引用无效"},
    {"code": "AIH_MANIFEST_UNREADABLE", "severity": "blocker", "owner": "scaffold-harness", "meaning": "脚手架 Manifest 缺失或不是有效 JSON"},
    {"code": "AIH_SCHEMA_INVALID", "severity": "blocker", "owner": "scaffold-harness", "meaning": "脚手架或工作区模板的 Schema 校验失败"},
    {"code": "AIH_ENTRYPOINT_MISSING", "severity": "high", "owner": "scaffold-harness", "meaning": "声明的脚手架、模板或运行时入口不存在"},
    {"code": "AIH_COMMAND_INVALID", "severity": "high", "owner": "scaffold-harness", "meaning": "工程命令缺失、重复或与 package.json 不一致"},
    {"code": "AIH_PROFILE_INVALID", "severity": "high", "owner": "scaffold-harness", "meaning": "验证 Profile 重复或引用未知工程命令"},
    {"code": "AIH_SCOPE_INVALID", "severity": "high", "owner": "scaffold-harness", "meaning": "Scope 重复或引用未知验证 Profile"},
    {"code": "AIH_SCOPE_UNRESOLVED", "severity": "blocker", "owner": "scaffold-harness", "meaning": "变更路径无法归入任何脚手架 Scope"},
    {"code": "AIH_PATH_INVALID", "severity": "high", "owner": "scaffold-harness", "meaning": "输入路径不是合法的仓库相对 POSIX 路径"},
    {"code": "AIH_PATH_OUTSIDE_ROOT", "severity": "blocker", "owner": "scaffold-harness", "meaning": "解析路径位于脚手架仓库根目录之外"},
    {"code": "AIH_SCAFFOLD_CONTEXT_INVALID", "severity": "blocker", "owner": "scaffold-harness", "meaning": "脚手架根仓库与生成工作区职责或 Agent 入口发生混用"},
    {"code": "AIH_HARNESS_BOUNDARY_INVALID", "severity": "blocker", "owner": "scaffold-harness", "meaning": "Maintainer Harness 与 User Harness 的项目绑定、权威来源或生命周期隔离发生混用"},
    {"code": "AIH_EXTERNAL_FRAMEWORK_BOUNDARY_INVALID", "severity": "blocker", "owner": "scaffold-harness", "meaning": "工作区模板绑定了脚手架范围外的外部框架生命周期"},
    {"code": "AIH_TEMPLATE_INVALID", "severity": "blocker", "owner": "scaffold-harness", "meaning": "工作区模板绑定、初始阶段状态或本地治理结构无效"},
    {"code": "AIH_TEMPLATE_POLLUTED", "severity": "blocker", "owner": "scaffold-harness", "meaning": "工作区模板含用户实例、依赖目录、构建输出或运行证据"},
    {"code": "AIH_EXECUTOR_AUTHORITY_INVALID", "severity": "blocker", "owner": "scaffold-harness", "meaning": "运行时没有执行生成工作区 Manifest 声明的本地执行器"},
    {"code": "AIH_CI_POLICY_INVALID", "severity": "blocker", "owner": "scaffold-harness", "meaning": "持续集成工作流未按 Manifest 调用 Resolver 驱动的统一门禁"},
    {"code": "AIH_RELEASE_INTENT_REQUIRED", "severity": "blocker", "owner": "scaffold-harness", "meaning": "readiness 未通过显式发布入口请求，或发布标记被用于非 readiness 意图"},
    {"code": "AIH_VALIDATION_FAILED", "severity": "blocker", "owner": "scaffold-harness", "meaning": "必需脚手架工程门禁返回非零"}
  ]
}

{
  "$schema": ".psp/harness/schemas/harness-manifest.schema.json",
  "name": "pre-sdd-scaffold-harness",
  "version": "12.0.0",
  "repositoryKind": "scaffold",
  "entrypoints": {
    "instructions": "AGENTS.md",
    "protocol": ".psp/harness/HARNESS.md",
    "standard": ".psp/harness/HARNESS-BOUNDARY.md",
    "project": "psp.project.yaml",
    "manifest": ".psp/harness/harness.manifest.json",
    "repository": "README.md"
  },
  "schemas": {
    "manifest": ".psp/harness/schemas/harness-manifest.schema.json",
    "project": ".psp/harness/schemas/project.schema.json"
  },
  "adapters": {
    "codexProject": ".codex/config.toml",
    "hookConfig": ".codex/hooks.json",
    "hookScripts": [".codex/hooks/validate-harness.mjs"],
    "repositorySkills": [".agents/skills/apply-repository-harness/SKILL.md"]
  },
  "readOrder": [
    "AGENTS.md",
    "psp.project.yaml",
    ".psp/harness/HARNESS.md",
    ".psp/harness/HARNESS-BOUNDARY.md",
    ".psp/harness/harness.manifest.json",
    "package.json",
    "templates/workspace/AGENTS.md",
    "templates/workspace/psp.project.yaml"
  ],
  "scaffoldPolicy": {
    "rootSkills": {
      "root": ".agents/skills",
      "allowed": ["apply-repository-harness"]
    },
    "templateSkills": {
      "root": "templates/workspace/.agents/skills",
      "required": ["apply-repository-harness", "product-design", "architecture-design"]
    },
    "textContracts": [
      {
        "id": "scaffold-instructions",
        "path": "AGENTS.md",
        "requiredText": ["脚手架源仓库（Scaffold Repository）", "PSPScaffoldProject", "不得改用包内模板副本"],
        "forbiddenText": ["仓库交付链为"]
      },
      {
        "id": "workspace-instructions",
        "path": "templates/workspace/AGENTS.md",
        "requiredText": ["生成工作区（Generated Workspace）", "Canonical UI Prototype", "PSPProject"],
        "forbiddenText": ["PSPScaffoldProject"]
      },
      {
        "id": "scaffold-standard",
        "path": ".psp/harness/HARNESS-BOUNDARY.md",
        "requiredText": ["四层模型", "用户命令面与工作区生命周期", "生成仓库本地拥有运行配置、领域 Skill 与执行事实", "既有工作区不提供 update（更新）、upgrade（升级）、migrate（迁移）或 sync（同步）操作", "AIH_EXECUTOR_AUTHORITY_INVALID", "持续集成工作流从 Manifest"],
        "forbiddenText": ["根 Manifest 只登记领域"]
      },
      {
        "id": "scaffold-readme",
        "path": "README.md",
        "requiredText": ["开发者视角（Developer View）", "脚手架源仓库（Scaffold Repository）", "工作区模板（Workspace Template）", "目标工作区本地文件", "既有工作区不提供更新或升级操作", ".psp/harness/scripts/run-ci-validation.mjs", "QUICKSTART.md"],
        "forbiddenText": ["根目录是软件包源码、开发 Harness 和仓库领域 Skill"]
      },
      {
        "id": "scaffold-quickstart",
        "path": "QUICKSTART.md",
        "requiredText": ["使用者视角（User View）", "用户命令只有三项", "npm update --global pre-sdd", "pre-sdd init", "目标工作区本地文件"],
        "forbiddenText": ["pre-sdd harness", "npm exec", "npm run", ".psp/harness/scripts/run-ci-validation.mjs"]
      },
      {
        "id": "workspace-readme",
        "path": "templates/workspace/README.md",
        "requiredText": ["生成工作区（Generated Workspace）", "不是 `pre-sdd` 脚手架源仓库", "本地 Manifest 声明的路径加载", "本工作区不提供更新、升级、迁移或同步操作"],
        "forbiddenText": ["npm install --global"]
      },
      {
        "id": "workspace-harness-boundary",
        "path": "templates/workspace/.psp/harness/HARNESS-BOUNDARY.md",
        "requiredText": ["生成工作区 Harness 职责边界", "本地执行事实", "package.json` 与 `package-lock.json", "不提供更新、升级、迁移或同步操作", "不得改用包内 `templates/workspace/` 副本"],
        "forbiddenText": ["脚手架固化要求"]
      }
    ],
    "templatePurity": {
      "stageMarker": ".gitkeep",
      "forbiddenDirectoryNames": ["node_modules", "dist", ".vite", "evidence"]
    },
    "packageScripts": [
      "validate:harness",
      "harness:resolve",
      "test:harness",
      "test:package",
      "test",
      "check",
      "pack:check"
    ],
    "execution": {
      "executorAuthority": "generated-workspace-local",
      "dependencyAuthority": "generated-workspace-package-lock",
      "testWorkspace": "os-temporary-copy",
      "runtimeEvidence": "os-temporary-directory"
    },
    "continuousIntegration": {
      "workflow": ".github/workflows/harness-governance.yml",
      "runner": ".psp/harness/scripts/run-ci-validation.mjs",
      "job": "harness-governance",
      "triggers": ["pull_request", "push"],
      "protectedBranches": ["main"],
      "runsOn": "ubuntu-latest",
      "nodeVersion": "22",
      "checkoutAction": "actions/checkout@v4",
      "setupNodeAction": "actions/setup-node@v4",
      "installCommand": "npm ci"
    }
  },
  "commands": [
    {
      "id": "harness",
      "npmScript": "validate:harness",
      "run": "npm run validate:harness",
      "purpose": "校验脚手架项目绑定、模板纯净性、上下文隔离与工程命令",
      "blocking": true
    },
    {
      "id": "test-harness",
      "npmScript": "test:harness",
      "run": "npm run test:harness",
      "purpose": "运行脚手架硬治理回归测试",
      "blocking": true
    },
    {
      "id": "test-package",
      "npmScript": "test:package",
      "run": "npm run test:package",
      "purpose": "在临时目录验证初始化、生成工作区本地执行与包行为",
      "blocking": true
    },
    {
      "id": "pack-check",
      "npmScript": "pack:check",
      "run": "npm run pack:check",
      "purpose": "校验 npm 包发布清单",
      "blocking": true
    }
  ],
  "validationProfiles": [
    {"id": "scaffold-governance", "commands": ["harness", "test-harness"]},
    {"id": "scaffold-runtime", "commands": ["harness", "test-harness", "test-package"]},
    {"id": "scaffold-package", "commands": ["harness", "test-harness", "test-package", "pack-check"]}
  ],
  "scopes": [
    {
      "id": "scaffold-governance",
      "kind": "repository",
      "selectionGroup": "scaffold-governance",
      "priority": 100,
      "status": "active",
      "selector": {
        "type": "static",
        "paths": ["AGENTS.md", "README.md", "QUICKSTART.md", "psp.project.yaml", ".gitignore", ".agents/skills/**", ".codex/**", ".github/**", ".psp/harness/**"]
      },
      "defaultProfile": "scaffold-governance",
      "readinessProfile": "scaffold-governance"
    },
    {
      "id": "scaffold-runtime",
      "kind": "runtime",
      "selectionGroup": "scaffold-runtime",
      "priority": 100,
      "status": "active",
      "selector": {"type": "static", "paths": ["package.json", "package-lock.json", "bin/**", "runtime/**"]},
      "defaultProfile": "scaffold-runtime",
      "readinessProfile": "scaffold-runtime"
    },
    {
      "id": "workspace-template",
      "kind": "template",
      "selectionGroup": "workspace-template",
      "priority": 100,
      "status": "active",
      "selector": {"type": "static", "paths": ["templates/workspace/**"]},
      "defaultProfile": "scaffold-package",
      "readinessProfile": "scaffold-package"
    },
    {
      "id": "package-tests",
      "kind": "tests",
      "selectionGroup": "package-tests",
      "priority": 100,
      "status": "active",
      "selector": {"type": "static", "paths": ["tests/package/**"]},
      "defaultProfile": "scaffold-package",
      "readinessProfile": "scaffold-package"
    }
  ],
  "evidenceReport": {
    "requiredFields": ["scope", "changes", "validation", "residuals"],
    "validationStates": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"]
  },
  "blockers": [
    {"code": "AIH_PROJECT_BINDING_INVALID", "severity": "blocker", "owner": "scaffold-harness", "meaning": "脚手架项目绑定缺失、越界或引用无效"},
    {"code": "AIH_MANIFEST_UNREADABLE", "severity": "blocker", "owner": "scaffold-harness", "meaning": "脚手架 Manifest 缺失或不是有效 JSON"},
    {"code": "AIH_SCHEMA_INVALID", "severity": "blocker", "owner": "scaffold-harness", "meaning": "脚手架或工作区模板的 Schema 校验失败"},
    {"code": "AIH_ENTRYPOINT_MISSING", "severity": "high", "owner": "scaffold-harness", "meaning": "声明的脚手架、模板或运行时入口不存在"},
    {"code": "AIH_COMMAND_INVALID", "severity": "high", "owner": "scaffold-harness", "meaning": "工程命令缺失、重复或与 package.json 不一致"},
    {"code": "AIH_PROFILE_INVALID", "severity": "high", "owner": "scaffold-harness", "meaning": "验证 Profile 重复或引用未知工程命令"},
    {"code": "AIH_SCOPE_INVALID", "severity": "high", "owner": "scaffold-harness", "meaning": "Scope 重复或引用未知验证 Profile"},
    {"code": "AIH_SCOPE_UNRESOLVED", "severity": "blocker", "owner": "scaffold-harness", "meaning": "变更路径无法归入任何脚手架 Scope"},
    {"code": "AIH_PATH_INVALID", "severity": "high", "owner": "scaffold-harness", "meaning": "输入路径不是合法的仓库相对 POSIX 路径"},
    {"code": "AIH_PATH_OUTSIDE_ROOT", "severity": "blocker", "owner": "scaffold-harness", "meaning": "解析路径位于脚手架仓库根目录之外"},
    {"code": "AIH_SCAFFOLD_CONTEXT_INVALID", "severity": "blocker", "owner": "scaffold-harness", "meaning": "脚手架根仓库与生成工作区职责或 Agent 入口发生混用"},
    {"code": "AIH_TEMPLATE_INVALID", "severity": "blocker", "owner": "scaffold-harness", "meaning": "工作区模板绑定、初始阶段状态或本地治理结构无效"},
    {"code": "AIH_TEMPLATE_POLLUTED", "severity": "blocker", "owner": "scaffold-harness", "meaning": "工作区模板含用户实例、依赖目录、构建输出或运行证据"},
    {"code": "AIH_EXECUTOR_AUTHORITY_INVALID", "severity": "blocker", "owner": "scaffold-harness", "meaning": "运行时没有执行生成工作区 Manifest 声明的本地执行器"},
    {"code": "AIH_CI_POLICY_INVALID", "severity": "blocker", "owner": "scaffold-harness", "meaning": "持续集成工作流未按 Manifest 调用 Resolver 驱动的统一门禁"},
    {"code": "AIH_VALIDATION_FAILED", "severity": "blocker", "owner": "scaffold-harness", "meaning": "必需脚手架工程门禁返回非零"}
  ]
}

{
  "$schema": ".psp/harness/schemas/harness-manifest.schema.json",
  "name": "pre-sdd-scaffold-harness",
  "version": "14.0.0",
  "standardProjectionRegistry": {
    "authority": ".psp/harness/HARNESS-BOUNDARY.md",
    "enforcementOwners": [
      {
        "id": "projection-schema",
        "kind": "schema",
        "path": ".psp/harness/schemas/harness-manifest.schema.json"
      },
      {
        "id": "projection-validator",
        "kind": "validator",
        "path": ".agents/skills/scaffold-consistency/scripts/check.mjs"
      },
      {
        "id": "projection-tests",
        "kind": "test",
        "path": ".psp/harness/tests/scaffold/scaffold.test.mjs"
      }
    ],
    "clauses": [
      {
        "clauseId": "AIH-STD-AUTHORITY-001",
        "authorityAnchor": "aih-std-authority-001",
        "targets": [
          {
            "path": ".psp/harness/HARNESS.md",
            "role": "profile",
            "requiredText": ["本文件是 [Harness Standard v3](./HARNESS-BOUNDARY.md) 的 Maintainer Harness（维护者治理层）执行投影"],
            "forbiddenText": ["本文件是 `pre-sdd-harness/v3` 的唯一规范权威"]
          },
          {
            "path": "templates/workspace/.psp/harness/HARNESS-BOUNDARY.md",
            "role": "profile",
            "requiredText": ["本文件是根 Harness Standard v3 的 User Harness（使用者治理层）投影，不是新的平行上位规范"],
            "forbiddenText": ["本文件是 `pre-sdd-harness/v3` 的唯一规范权威"]
          }
        ],
        "enforcementOwnerIds": ["projection-schema", "projection-validator", "projection-tests"]
      },
      {
        "clauseId": "AIH-STD-TERMINOLOGY-001",
        "authorityAnchor": "aih-std-terminology-001",
        "targets": [
          {
            "path": "templates/workspace/.psp/harness/HARNESS-BOUNDARY.md",
            "role": "profile",
            "requiredText": ["Harness（执行控制体系）", "Artifact Operation（产物操作）"],
            "forbiddenText": []
          },
          {
            "path": "templates/workspace/.psp/harness/HARNESS.md",
            "role": "runtime-contract",
            "requiredText": ["Scope、Changes、Validation、Residuals"],
            "forbiddenText": []
          }
        ],
        "enforcementOwnerIds": ["projection-schema", "projection-validator", "projection-tests"]
      },
      {
        "clauseId": "AIH-STD-GATE-MODEL-001",
        "authorityAnchor": "aih-std-gate-model-001",
        "targets": [
          {
            "path": "templates/workspace/.psp/harness/HARNESS-BOUNDARY.md",
            "role": "profile",
            "requiredText": ["Safety/Structure Blocker", "Domain Diagnostic"],
            "forbiddenText": []
          },
          {
            "path": "templates/workspace/.psp/harness/HARNESS.md",
            "role": "runtime-contract",
            "requiredText": ["Domain Diagnostic 可由用户逐项接受，Safety/Structure Blocker 永不可覆盖"],
            "forbiddenText": []
          }
        ],
        "enforcementOwnerIds": ["projection-schema", "projection-validator", "projection-tests"]
      },
      {
        "clauseId": "AIH-STD-DEPENDENCY-HANDOFF-001",
        "authorityAnchor": "aih-std-dependency-handoff-001",
        "targets": [
          {
            "path": "templates/workspace/.psp/harness/HARNESS-BOUNDARY.md",
            "role": "profile",
            "requiredText": ["`dependency` 是数据关系，只进入 Dependency 闭包、拓扑和 `project-consistency`", "`handoff` 是用户授权关系，只提供合法消费者候选"],
            "forbiddenText": []
          },
          {
            "path": "templates/workspace/.agents/skills/project-consistency/SKILL.md",
            "role": "skill",
            "requiredText": ["Treat only `dependency` edges as data relationships", "Ignore `handoff` edges for closure and topological order"],
            "forbiddenText": []
          }
        ],
        "enforcementOwnerIds": ["projection-schema", "projection-validator", "projection-tests"]
      },
      {
        "clauseId": "AIH-STD-CONSISTENCY-001",
        "authorityAnchor": "aih-std-consistency-001",
        "targets": [
          {
            "path": ".agents/skills/scaffold-consistency/SKILL.md",
            "role": "skill",
            "requiredText": ["只读一致性分析", "保持 `changes` 为空"],
            "forbiddenText": ["发现问题时自动修复"]
          },
          {
            "path": "templates/workspace/.agents/skills/project-consistency/SKILL.md",
            "role": "skill",
            "requiredText": ["Never infer modification authority from a finding", "Keep `changes` empty"],
            "forbiddenText": []
          }
        ],
        "enforcementOwnerIds": ["projection-schema", "projection-validator", "projection-tests"]
      },
      {
        "clauseId": "AIH-STD-HANDOFF-STATE-001",
        "authorityAnchor": "aih-std-handoff-state-001",
        "targets": [
          {
            "path": "templates/workspace/AGENTS.md",
            "role": "instruction",
            "requiredText": ["Handoff 只在用户显式请求时执行 preflight", "只有显式确认才写入 Receipt"],
            "forbiddenText": []
          },
          {
            "path": "templates/workspace/.psp/harness/HARNESS.md",
            "role": "runtime-contract",
            "requiredText": ["正式 Handoff 必须经过 preflight", "`downstreamAction` 都是 `NOT_RUN`"],
            "forbiddenText": []
          }
        ],
        "enforcementOwnerIds": ["projection-schema", "projection-validator", "projection-tests"]
      },
      {
        "clauseId": "AIH-STD-EXECUTION-EVIDENCE-001",
        "authorityAnchor": "aih-std-execution-evidence-001",
        "targets": [
          {
            "path": ".psp/harness/HARNESS.md",
            "role": "runtime-contract",
            "requiredText": ["`local-edit` 只能调度 quick 成本", "失败后的计划项标记 `NOT_RUN`"],
            "forbiddenText": []
          },
          {
            "path": "templates/workspace/.psp/harness/HARNESS.md",
            "role": "runtime-contract",
            "requiredText": ["一次 Operation 内按 `commandId + inputDigest + profileVersion` 去重", "失败后剩余命令为 `NOT_RUN`"],
            "forbiddenText": []
          }
        ],
        "enforcementOwnerIds": ["projection-schema", "projection-validator", "projection-tests"]
      },
      {
        "clauseId": "AIH-STD-DUAL-HARNESS-001",
        "authorityAnchor": "aih-std-dual-harness-001",
        "targets": [
          {
            "path": "AGENTS.md",
            "role": "instruction",
            "requiredText": ["根 `.psp/harness/` 是 Maintainer Harness（维护者治理层）", "模板项目绑定必须是 `PSPProject`"],
            "forbiddenText": []
          },
          {
            "path": "templates/workspace/AGENTS.md",
            "role": "instruction",
            "requiredText": ["本地 `.psp/harness/` 是 User Harness（使用者治理层）", "不得反向控制脚手架模板、运行时或发布流程"],
            "forbiddenText": []
          }
        ],
        "enforcementOwnerIds": ["projection-schema", "projection-validator", "projection-tests"]
      },
      {
        "clauseId": "AIH-STD-RUNTIME-AUTHORITY-001",
        "authorityAnchor": "aih-std-runtime-authority-001",
        "targets": [
          {
            "path": "README.md",
            "role": "documentation",
            "requiredText": ["目标工作区本地文件拥有运行与执行事实"],
            "forbiddenText": []
          },
          {
            "path": "templates/workspace/.psp/harness/HARNESS-BOUNDARY.md",
            "role": "profile",
            "requiredText": ["当前生成工作区的运行权威是本地 `psp.project.yaml`"],
            "forbiddenText": []
          }
        ],
        "enforcementOwnerIds": ["projection-schema", "projection-validator", "projection-tests"]
      },
      {
        "clauseId": "AIH-STD-COMPLETION-001",
        "authorityAnchor": "aih-std-completion-001",
        "targets": [
          {
            "path": ".psp/harness/HARNESS.md",
            "role": "profile",
            "requiredText": ["这不是用户产物移交", "不生成产品或架构 handoff 凭证"],
            "forbiddenText": []
          },
          {
            "path": "AGENTS.md",
            "role": "instruction",
            "requiredText": ["根 Harness 没有领域移交边"],
            "forbiddenText": []
          }
        ],
        "enforcementOwnerIds": ["projection-schema", "projection-validator", "projection-tests"]
      },
      {
        "clauseId": "AIH-STD-COMMAND-SURFACE-001",
        "authorityAnchor": "aih-std-command-surface-001",
        "targets": [
          {
            "path": "QUICKSTART.md",
            "role": "documentation",
            "requiredText": ["会改变状态的公共操作只有三项", "pre-sdd init"],
            "forbiddenText": ["pre-sdd harness"]
          },
          {
            "path": "README.md",
            "role": "documentation",
            "requiredText": ["既有工作区由 `.psp/runtime/pre-sdd/` 中的初始化版本快照"],
            "forbiddenText": []
          }
        ],
        "enforcementOwnerIds": ["projection-schema", "projection-validator", "projection-tests"]
      },
      {
        "clauseId": "AIH-STD-RESPONSIBILITY-001",
        "authorityAnchor": "aih-std-responsibility-001",
        "targets": [
          {
            "path": "AGENTS.md",
            "role": "instruction",
            "requiredText": ["根仓库只处理脚手架工程"],
            "forbiddenText": []
          },
          {
            "path": "templates/workspace/AGENTS.md",
            "role": "instruction",
            "requiredText": ["Harness 只拥有与产品语义和内容效果无关的硬治理"],
            "forbiddenText": []
          }
        ],
        "enforcementOwnerIds": ["projection-schema", "projection-validator", "projection-tests"]
      },
      {
        "clauseId": "AIH-STD-ROOT-BOUNDARY-001",
        "authorityAnchor": "aih-std-root-boundary-001",
        "targets": [
          {
            "path": "AGENTS.md",
            "role": "instruction",
            "requiredText": ["根项目绑定必须是 `PSPScaffoldProject`", "根 `.agents/skills/` 不得保存或自动发现这些领域 Skill"],
            "forbiddenText": []
          },
          {
            "path": ".psp/harness/HARNESS.md",
            "role": "profile",
            "requiredText": ["根项目不得出现 `stages`", "根 Manifest 不得出现领域注册"],
            "forbiddenText": []
          }
        ],
        "enforcementOwnerIds": ["projection-schema", "projection-validator", "projection-tests"]
      },
      {
        "clauseId": "AIH-STD-TEMPLATE-BOUNDARY-001",
        "authorityAnchor": "aih-std-template-boundary-001",
        "targets": [
          {
            "path": ".psp/harness/HARNESS.md",
            "role": "profile",
            "requiredText": ["模板不得包含用户实例、依赖目录、构建输出或运行证据"],
            "forbiddenText": []
          },
          {
            "path": "templates/workspace/README.md",
            "role": "documentation",
            "requiredText": ["不是 `pre-sdd` 脚手架源仓库", "文件已经存在不等于"],
            "forbiddenText": []
          }
        ],
        "enforcementOwnerIds": ["projection-schema", "projection-validator", "projection-tests"]
      },
      {
        "clauseId": "AIH-STD-RUNTIME-RULES-001",
        "authorityAnchor": "aih-std-runtime-rules-001",
        "targets": [
          {
            "path": "AGENTS.md",
            "role": "instruction",
            "requiredText": ["Manifest 声明的模块或测试执行器必须从目标工作区本地路径执行", "不得改用包内模板副本"],
            "forbiddenText": []
          },
          {
            "path": "templates/workspace/.psp/harness/HARNESS-BOUNDARY.md",
            "role": "runtime-contract",
            "requiredText": ["不得执行包内 `templates/workspace/` 副本", "AIH_PROTOCOL_UNSUPPORTED"],
            "forbiddenText": []
          }
        ],
        "enforcementOwnerIds": ["projection-schema", "projection-validator", "projection-tests"]
      },
      {
        "clauseId": "AIH-STD-CI-CD-001",
        "authorityAnchor": "aih-std-ci-cd-001",
        "targets": [
          {
            "path": ".psp/harness/HARNESS.md",
            "role": "profile",
            "requiredText": ["CI Adapter 分别请求 `pull-request` 或 `main`", "只有隔离的发布 workflow 可以请求 `release`"],
            "forbiddenText": []
          },
          {
            "path": "README.md",
            "role": "documentation",
            "requiredText": ["PR 使用受影响范围 `pull-request`", "两者都不会请求发布级 `release`"],
            "forbiddenText": []
          }
        ],
        "enforcementOwnerIds": ["projection-schema", "projection-validator", "projection-tests"]
      }
    ]
  },
  "repositoryKind": "scaffold",
  "entrypoints": {
    "instructions": "AGENTS.md",
    "protocol": ".psp/harness/HARNESS.md",
    "standard": ".psp/harness/HARNESS-BOUNDARY.md",
    "project": "psp.project.yaml",
    "manifest": ".psp/harness/harness.manifest.json",
    "repository": "README.md"
  },
  "schemas": {
    "manifest": ".psp/harness/schemas/harness-manifest.schema.json",
    "project": ".psp/harness/schemas/project.schema.json",
    "consistencyReport": ".psp/harness/schemas/consistency-report.schema.json",
    "evidenceReport": ".psp/harness/schemas/evidence-report.schema.json"
  },
  "adapters": {
    "codexProject": ".codex/config.toml",
    "hookConfig": ".codex/hooks.json",
    "hookScripts": [
      ".codex/hooks/validate-harness.mjs"
    ],
    "repositorySkills": [
      ".agents/skills/apply-repository-harness/SKILL.md",
      ".agents/skills/scaffold-consistency/SKILL.md"
    ]
  },
  "readOrder": [
    "AGENTS.md",
    "psp.project.yaml",
    ".psp/harness/HARNESS.md",
    ".psp/harness/HARNESS-BOUNDARY.md",
    ".psp/harness/harness.manifest.json",
    "package.json",
    "templates/workspace/AGENTS.md",
    "templates/workspace/psp.project.yaml"
  ],
  "scaffoldPolicy": {
    "governanceModel": {
      "maintainerHarness": {
        "projectKind": "PSPScaffoldProject",
        "purpose": "scaffold-maintenance",
        "authority": "scaffold-repository-local",
        "completion": "validated-scaffold-change"
      },
      "userHarness": {
        "projectKind": "PSPProject",
        "purpose": "generated-workspace-governance",
        "sourceRoot": "templates/workspace",
        "authority": "generated-workspace-local"
      },
      "lifecycleIsolation": {
        "rootDomainLifecycle": "forbidden",
        "rootDomainHandoff": "forbidden",
        "templateExternalLifecycle": "forbidden",
        "crossLifecycleControl": "forbidden"
      }
    },
    "rootSkills": {
      "root": ".agents/skills",
      "allowed": [
        "apply-repository-harness",
        "scaffold-consistency"
      ]
    },
    "templateSkills": {
      "root": "templates/workspace/.agents/skills",
      "required": [
        "apply-repository-harness",
        "project-consistency",
        "product-design",
        "architecture-design",
        "capture-figma-design-source",
        "organize-figma-assets",
        "figma-component-from-design",
        "implement-figma-lit-page",
        "repair-canonical-ui",
        "mockcase"
      ]
    },
    "textContracts": [
      {
        "id": "scaffold-instructions",
        "path": "AGENTS.md",
        "requiredText": [
          "脚手架源仓库（Scaffold Repository）",
          "Maintainer Harness（维护者治理层）",
          "PSPScaffoldProject",
          "不得改用包内模板副本"
        ],
        "forbiddenText": [
          "仓库交付链为"
        ]
      },
      {
        "id": "workspace-instructions",
        "path": "templates/workspace/AGENTS.md",
        "requiredText": [
          "生成工作区（Generated Workspace）",
          "User Harness（使用者治理层）",
          "Canonical UI Prototype",
          "PSPProject",
          "Handoff 只在用户显式请求时"
        ],
        "forbiddenText": [
          "PSPScaffoldProject"
        ]
      },
      {
        "id": "scaffold-standard",
        "path": ".psp/harness/HARNESS-BOUNDARY.md",
        "requiredText": [
          "Harness Standard v3（Harness 上位规范）",
          "Maintainer Harness（维护者治理层）",
          "User Harness（使用者治理层）",
          "四层模型",
          "用户命令面与工作区生命周期",
          "生成仓库本地拥有运行配置、领域 Skill 与执行事实",
          "既有工作区不提供 update（更新）、upgrade（升级）、migrate（迁移）或 sync（同步）操作",
          "AIH_EXECUTOR_AUTHORITY_INVALID",
          "PR、main 与 Release Adapter"
        ],
        "forbiddenText": [
          "根 Manifest 只登记领域"
        ]
      },
      {
        "id": "scaffold-readme",
        "path": "README.md",
        "requiredText": [
          "开发者视角（Developer View）",
          "双 Harness（双治理层）模型",
          "Maintainer Harness（维护者治理层）",
          "User Harness（使用者治理层）",
          "脚手架源仓库（Scaffold Repository）",
          "工作区模板（Workspace Template）",
          "目标工作区本地文件",
          "既有工作区不提供更新或升级操作",
          "^20.19.0 || >=22.12.0",
          "最大门禁集合",
          ".psp/harness/scripts/run-ci-validation.mjs",
          "QUICKSTART.md"
        ],
        "forbiddenText": [
          "根目录是软件包源码、开发 Harness 和仓库领域 Skill"
        ]
      },
      {
        "id": "scaffold-quickstart",
        "path": "QUICKSTART.md",
        "requiredText": [
          "使用者视角（User View）",
          "会改变状态的公共操作只有三项",
          "npm install --global git+https://github.com/bigsmartben/pre-sdd.git",
          "pre-sdd init",
          "git init",
          "文件存在不等于",
          "01-product-design",
          "02-architecture-design",
          "架构设计拥有独立生命周期",
          "本轮只完成"
        ],
        "forbiddenText": [
          "pre-sdd harness",
          "npm exec",
          "npm run",
          ".psp/harness/scripts/run-ci-validation.mjs"
        ]
      },
      {
        "id": "workspace-readme",
        "path": "templates/workspace/README.md",
        "requiredText": [
          "生成工作区（Generated Workspace）",
          "User Harness（使用者治理层）",
          "不是 `pre-sdd` 脚手架源仓库",
          "文件已经存在不等于",
          "只有使用者显式请求时才运行 preflight",
          "本地 Manifest 声明的路径加载",
          "本工作区不提供更新、升级、迁移或同步操作"
        ],
        "forbiddenText": [
          "npm install --global"
        ]
      },
      {
        "id": "workspace-harness-boundary",
        "path": "templates/workspace/.psp/harness/HARNESS-BOUNDARY.md",
        "requiredText": [
          "Harness Standard v3 — User Harness Profile",
          "User Harness（使用者治理层）",
          "本地运行事实",
          "package.json",
          "不初始化、不修改、不执行下游",
          "不得执行包内 `templates/workspace/` 副本"
        ],
        "forbiddenText": [
          "脚手架固化要求"
        ]
      }
    ],
    "templatePurity": {
      "stageMarker": ".gitkeep",
      "forbiddenDirectoryNames": [
        "node_modules",
        "dist",
        ".vite",
        "evidence"
      ]
    },
    "packageScripts": [
      "validate:harness",
      "harness:resolve",
      "test:harness",
      "test:template:harness",
      "test:template:product",
      "test:template:mockcase",
      "test:template:architecture",
      "test:workspace:harness",
      "test:workspace:product",
      "test:workspace:mockcase",
      "test:workspace:architecture",
      "test:package:fast",
      "test:package:slow",
      "test:package",
      "test",
      "check",
      "pack:check",
      "check:scaffold-consistency"
    ],
    "execution": {
      "runtimeAuthority": "generated-workspace-snapshot",
      "runtimeSnapshot": ".psp/runtime/pre-sdd",
      "executorAuthority": "generated-workspace-local",
      "dependencyAuthority": "generated-workspace-package-lock",
      "dependencyCache": "os-temporary-directory",
      "testWorkspace": "os-temporary-copy",
      "runtimeEvidence": "os-temporary-directory"
    },
    "continuousIntegration": {
      "workflow": ".github/workflows/harness-governance.yml",
      "runner": ".psp/harness/scripts/run-ci-validation.mjs",
      "contexts": {
        "pullRequest": {
          "trigger": "pull_request",
          "executionContext": "pull-request",
          "scope": "affected"
        },
        "main": {
          "trigger": "push:main",
          "executionContext": "main",
          "scope": "repository"
        }
      },
      "job": "harness-governance",
      "runsOn": "ubuntu-latest",
      "nodeVersion": "22",
      "checkoutAction": "actions/checkout@v4",
      "setupNodeAction": "actions/setup-node@v4",
      "installCommand": "npm ci",
      "browserInstallCommand": "npx playwright install --with-deps chromium",
      "timeoutMinutes": 60
    },
    "releaseValidation": {
      "workflow": ".github/workflows/harness-release.yml",
      "runner": ".psp/harness/scripts/run-ci-validation.mjs",
      "executionContext": "release",
      "scope": "repository",
      "credential": "validated-scaffold-change",
      "publishes": false
    }
  },
  "commands": [
    {
      "id": "harness",
      "npmScript": "validate:harness",
      "run": "npm run validate:harness",
      "purpose": "校验脚手架项目绑定、模板纯净性、上下文隔离与工程命令",
      "blocking": true,
      "costClass": "quick",
      "allowedContexts": [
        "local-edit",
        "explicit-consistency",
        "pull-request",
        "main",
        "release"
      ],
      "timeoutMs": 120000,
      "cache": {
        "mode": "content-addressed"
      }
    },
    {
      "id": "scaffold-consistency",
      "npmScript": "check:scaffold-consistency",

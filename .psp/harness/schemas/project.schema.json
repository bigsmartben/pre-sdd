{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psp.dev/schemas/scaffold-project.schema.json",
  "title": "pre-sdd Scaffold Project Binding",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "harness", "template", "runtime"],
  "properties": {
    "apiVersion": {"const": "psp.dev/v1"},
    "kind": {"const": "PSPScaffoldProject"},
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest"],
      "properties": {"manifest": {"$ref": "#/$defs/path"}}
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "project", "manifest"],
      "properties": {
        "root": {"$ref": "#/$defs/path"},
        "project": {"$ref": "#/$defs/path"},
        "manifest": {"$ref": "#/$defs/path"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entrypoint", "dispatcher"],
      "properties": {
        "entrypoint": {"$ref": "#/$defs/path"},
        "dispatcher": {"$ref": "#/$defs/path"}
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[*!?\\[\\]{}]).+$"
    }
  }
}

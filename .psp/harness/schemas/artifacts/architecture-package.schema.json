{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psp.dev/schemas/artifacts/architecture-package.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "upstream", "overview", "artifactOrder", "gates", "gaps"],
  "properties": {
    "apiVersion": {"const": "psp.dev/v1"},
    "kind": {"const": "ArchitecturePackage"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "artifact", "version"],
      "properties": {
        "stage": {"const": "product-design"},
        "artifact": {"const": "capabilities"},
        "version": {"$ref": "#/$defs/nullableVersion"}
      }
    },
    "overview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["systemName", "architectureGoal", "constraints"],
      "properties": {
        "systemName": {"$ref": "#/$defs/nullableText"},
        "architectureGoal": {"$ref": "#/$defs/nullableText"},
        "constraints": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "artifactOrder": {"const": ["system-boundary", "conceptual-model", "technical-validation"]},
    "gates": {"$ref": "#/$defs/gates"},
    "gaps": {"$ref": "#/$defs/gaps"}
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "version"],
      "properties": {
        "status": {"enum": ["draft", "ready"]},
        "version": {"$ref": "#/$defs/version"}
      }
    },
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "nullableVersion": {"type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "nullableText": {"type": ["string", "null"], "minLength": 1},
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "checked"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "label": {"type": "string", "minLength": 1},
        "checked": {"type": "boolean"}
      }
    },
    "gates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/gate"}},
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "field", "reason"],
      "properties": {
        "id": {"type": "string", "pattern": "^GAP-[0-9]{3}$"},
        "field": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}}
  }
}

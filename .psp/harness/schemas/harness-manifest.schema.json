{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psp.dev/schemas/v3/scaffold-harness-manifest.schema.json",
  "title": "pre-sdd Harness Standard v3 Maintainer Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "name", "version", "standard", "standardProjectionRegistry", "repositoryKind", "entrypoints", "schemas", "adapters", "readOrder", "scaffoldPolicy", "commands", "validationProfiles", "scopes", "evidenceReport", "blockers"],
  "properties": {
    "$schema": {"type": "string"},
    "name": {"$ref": "#/$defs/identifier"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "standard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "version", "authority", "profile"],
      "properties": {
        "protocol": {"const": "pre-sdd-harness/v3"},
        "version": {"const": "3.0.0"},
        "authority": {"const": ".psp/harness/HARNESS-BOUNDARY.md"},
        "profile": {"const": "maintainer"}
      }
    },
    "standardProjectionRegistry": {"$ref": "#/$defs/standardProjectionRegistry"},
    "repositoryKind": {"const": "scaffold"},
    "entrypoints": {"type": "object", "required": ["instructions", "protocol", "standard", "project", "manifest", "repository"], "additionalProperties": {"$ref": "#/$defs/path"}},
    "schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "project", "consistencyReport", "evidenceReport"],
      "properties": {
        "manifest": {"$ref": "#/$defs/path"},
        "project": {"$ref": "#/$defs/path"},
        "consistencyReport": {"$ref": "#/$defs/path"},
        "evidenceReport": {"$ref": "#/$defs/path"}
      }
    },
    "adapters": {"type": "object", "required": ["codexProject", "hookConfig", "hookScripts", "repositorySkills"], "additionalProperties": true},
    "readOrder": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "scaffoldPolicy": {"type": "object", "required": ["governanceModel", "rootSkills", "templateSkills", "textContracts", "templatePurity", "packageScripts", "execution", "continuousIntegration", "releaseValidation"], "additionalProperties": true},
    "commands": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/command"}},
    "validationProfiles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/profile"}},
    "scopes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scope"}},
    "evidenceReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "requiredFields", "validationStates", "metrics"],
      "properties": {
        "schema": {"$ref": "#/$defs/path"},
        "requiredFields": {"const": ["scope", "changes", "validation", "residuals"]},
        "validationStates": {"const": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"]},
        "metrics": {"const": ["plannedCommandCount", "executedCommandCount", "cacheHitCount", "notRunCount", "totalDurationMs"]}
      }
    },
    "blockers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/blocker"}}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[*!?\\[\\]{}]).+$"},
    "globPath": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+$"},
    "context": {"enum": ["local-edit", "explicit-consistency", "pull-request", "main", "release"]},
    "cachePolicy": {"type": "object", "additionalProperties": false, "required": ["mode"], "properties": {"mode": {"enum": ["disabled", "operation", "content-addressed"]}}},
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "npmScript", "run", "purpose", "blocking", "allowedContexts", "costClass", "timeoutMs", "cache"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "npmScript": {"type": "string"},
        "run": {"type": "string", "pattern": "^npm run "},
        "purpose": {"type": "string"},
        "blocking": {"const": true},
        "allowedContexts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/context"}},
        "costClass": {"enum": ["quick", "standard", "full"]},
        "timeoutMs": {"type": "integer", "minimum": 1000},
        "cache": {"$ref": "#/$defs/cachePolicy"}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "commands", "allowedContexts", "costClass", "timeoutMs", "cache"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "commands": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "allowedContexts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/context"}},
        "costClass": {"enum": ["quick", "standard", "full"]},
        "timeoutMs": {"type": "integer", "minimum": 1000},
        "cache": {"$ref": "#/$defs/cachePolicy"}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "selectionGroup", "priority", "status", "selector", "defaultProfile", "consistencyProfile", "checkpointProfile", "mainProfile", "readinessProfile"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "kind": {"enum": ["repository", "runtime", "template", "tests"]},
        "selectionGroup": {"$ref": "#/$defs/identifier"},
        "priority": {"type": "integer", "minimum": 0},
        "status": {"const": "active"},
        "selector": {"type": "object", "required": ["type", "paths"], "properties": {"type": {"const": "static"}, "paths": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/globPath"}}}},
        "defaultProfile": {"$ref": "#/$defs/identifier"},
        "consistencyProfile": {"$ref": "#/$defs/identifier"},
        "checkpointProfile": {"$ref": "#/$defs/identifier"},
        "mainProfile": {"$ref": "#/$defs/identifier"},
        "readinessProfile": {"$ref": "#/$defs/identifier"}
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "owner", "gateClass", "meaning"],
      "properties": {
        "code": {"type": "string", "pattern": "^AIH_[A-Z0-9_]+$"},
        "severity": {"enum": ["blocker", "high", "medium", "low"]},
        "owner": {"const": "scaffold-harness"},
        "gateClass": {"enum": ["safety-structure", "domain-diagnostic", "ci-cd-policy"]},
        "meaning": {"type": "string"}
      }
    },
    "standardProjectionRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "enforcementOwners", "clauses"],
      "properties": {
        "authority": {"const": ".psp/harness/HARNESS-BOUNDARY.md"},
        "enforcementOwners": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "allOf": [
            {"contains": {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "schema"}}}},
            {"contains": {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "validator"}}}},
            {"contains": {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "test"}}}}
          ],
          "items": {"$ref": "#/$defs/projectionEnforcementOwner"}
        },
        "clauses": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/standardProjectionClause"}
        }
      }
    },
    "projectionEnforcementOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "kind": {"enum": ["schema", "validator", "test"]},
        "path": {"$ref": "#/$defs/path"}
      }
    },
    "standardProjectionClause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clauseId", "authorityAnchor", "targets", "enforcementOwnerIds"],
      "properties": {
        "clauseId": {"type": "string", "pattern": "^AIH-STD-[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
        "authorityAnchor": {"type": "string", "pattern": "^aih-std-[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/standardProjectionTarget"}
        },
        "enforcementOwnerIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "standardProjectionTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "requiredText", "forbiddenText"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "role": {"enum": ["profile", "runtime-contract", "instruction", "skill", "documentation"]},
        "requiredText": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "forbiddenText": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}

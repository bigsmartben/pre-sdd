{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psp.dev/schemas/scaffold-harness-manifest.schema.json",
  "title": "pre-sdd Scaffold Harness Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "name", "version", "repositoryKind", "entrypoints", "schemas", "adapters", "readOrder", "scaffoldPolicy", "commands", "validationProfiles", "scopes", "evidenceReport", "blockers"],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "name": {"$ref": "#/$defs/identifier"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "repositoryKind": {"const": "scaffold"},
    "entrypoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instructions", "protocol", "standard", "project", "manifest", "repository"],
      "properties": {
        "instructions": {"$ref": "#/$defs/path"},
        "protocol": {"$ref": "#/$defs/path"},
        "standard": {"$ref": "#/$defs/path"},
        "project": {"$ref": "#/$defs/path"},
        "manifest": {"$ref": "#/$defs/path"},
        "repository": {"$ref": "#/$defs/path"}
      }
    },
    "schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "project"],
      "properties": {
        "manifest": {"$ref": "#/$defs/path"},
        "project": {"$ref": "#/$defs/path"}
      }
    },
    "adapters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codexProject", "hookConfig", "hookScripts", "repositorySkills"],
      "properties": {
        "codexProject": {"$ref": "#/$defs/path"},
        "hookConfig": {"$ref": "#/$defs/path"},
        "hookScripts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
        "repositorySkills": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}}
      }
    },
    "readOrder": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "scaffoldPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["governanceModel", "rootSkills", "templateSkills", "textContracts", "templatePurity", "packageScripts", "execution", "continuousIntegration"],
      "properties": {
        "governanceModel": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maintainerHarness", "userHarness", "lifecycleIsolation"],
          "properties": {
            "maintainerHarness": {
              "type": "object",
              "additionalProperties": false,
              "required": ["projectKind", "purpose", "authority", "completion"],
              "properties": {
                "projectKind": {"const": "PSPScaffoldProject"},
                "purpose": {"const": "scaffold-maintenance"},
                "authority": {"const": "scaffold-repository-local"},
                "completion": {"const": "validated-scaffold-change"}
              }
            },
            "userHarness": {
              "type": "object",
              "additionalProperties": false,
              "required": ["projectKind", "purpose", "sourceRoot", "authority"],
              "properties": {
                "projectKind": {"const": "PSPProject"},
                "purpose": {"const": "generated-workspace-governance"},
                "sourceRoot": {"$ref": "#/$defs/path"},
                "authority": {"const": "generated-workspace-local"}
              }
            },
            "lifecycleIsolation": {
              "type": "object",
              "additionalProperties": false,
              "required": ["rootDomainLifecycle", "rootDomainHandoff", "templateExternalLifecycle", "crossLifecycleControl"],
              "properties": {
                "rootDomainLifecycle": {"const": "forbidden"},
                "rootDomainHandoff": {"const": "forbidden"},
                "templateExternalLifecycle": {"const": "forbidden"},
                "crossLifecycleControl": {"const": "forbidden"}
              }
            }
          }
        },
        "rootSkills": {"$ref": "#/$defs/skillPolicy"},
        "templateSkills": {"$ref": "#/$defs/requiredSkillPolicy"},
        "textContracts": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "path", "requiredText", "forbiddenText"],
            "properties": {
              "id": {"$ref": "#/$defs/identifier"},
              "path": {"$ref": "#/$defs/path"},
              "requiredText": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "forbiddenText": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            }
          }
        },
        "templatePurity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stageMarker", "forbiddenDirectoryNames"],
          "properties": {
            "stageMarker": {"type": "string", "minLength": 1},
            "forbiddenDirectoryNames": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        },
        "packageScripts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/npmScript"}},
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["runtimeAuthority", "runtimeSnapshot", "executorAuthority", "dependencyAuthority", "dependencyCache", "testWorkspace", "runtimeEvidence"],
          "properties": {
            "runtimeAuthority": {"const": "generated-workspace-snapshot"},
            "runtimeSnapshot": {"const": ".psp/runtime/pre-sdd"},
            "executorAuthority": {"const": "generated-workspace-local"},
            "dependencyAuthority": {"const": "generated-workspace-package-lock"},
            "dependencyCache": {"const": "os-temporary-directory"},
            "testWorkspace": {"const": "os-temporary-copy"},
            "runtimeEvidence": {"const": "os-temporary-directory"}
          }
        },
        "continuousIntegration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workflow", "runner", "job", "triggers", "protectedBranches", "runsOn", "nodeVersion", "checkoutAction", "setupNodeAction", "installCommand"],
          "properties": {
            "workflow": {"$ref": "#/$defs/path"},
            "runner": {"$ref": "#/$defs/path"},
            "job": {"$ref": "#/$defs/identifier"},
            "triggers": {"type": "array", "const": ["pull_request", "push"]},
            "protectedBranches": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "runsOn": {"const": "ubuntu-latest"},
            "nodeVersion": {"type": "string", "pattern": "^[0-9]+$"},
            "checkoutAction": {"type": "string", "pattern": "^actions/checkout@v[0-9]+$"},
            "setupNodeAction": {"type": "string", "pattern": "^actions/setup-node@v[0-9]+$"},
            "installCommand": {"const": "npm ci"}
          }
        }
      }
    },
    "commands": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/command"}},
    "validationProfiles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/profile"}},
    "scopes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scope"}},
    "evidenceReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredFields", "validationStates"],
      "properties": {
        "requiredFields": {"type": "array", "const": ["scope", "changes", "validation", "residuals"]},
        "validationStates": {"type": "array", "const": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"]}
      }
    },
    "blockers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/blocker"}}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "npmScript": {"type": "string", "pattern": "^[a-z][a-z0-9:-]*$"},
    "blockerCode": {"type": "string", "pattern": "^AIH_[A-Z0-9_]+$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[*!?\\[\\]{}]).+$"},
    "globPath": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+$"},
    "skillPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "allowed"],
      "properties": {
        "root": {"$ref": "#/$defs/path"},
        "allowed": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
      }
    },
    "requiredSkillPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "required"],
      "properties": {
        "root": {"$ref": "#/$defs/path"},
        "required": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "npmScript", "run", "purpose", "blocking"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "npmScript": {"$ref": "#/$defs/npmScript"},
        "run": {"type": "string", "pattern": "^npm run [a-z][a-z0-9:-]*$"},
        "purpose": {"type": "string", "minLength": 1},
        "blocking": {"const": true}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "commands"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "commands": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "selectionGroup", "priority", "status", "selector", "defaultProfile", "checkpointProfile", "readinessProfile"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "kind": {"enum": ["repository", "runtime", "template", "tests"]},
        "selectionGroup": {"$ref": "#/$defs/identifier"},
        "priority": {"type": "integer", "minimum": 0},
        "status": {"const": "active"},
        "selector": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "paths"],
          "properties": {
            "type": {"const": "static"},
            "paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/globPath"}}
          }
        },
        "defaultProfile": {"$ref": "#/$defs/identifier"},
        "checkpointProfile": {"$ref": "#/$defs/identifier"},
        "readinessProfile": {"$ref": "#/$defs/identifier"}
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "owner", "meaning"],
      "properties": {
        "code": {"$ref": "#/$defs/blockerCode"},
        "severity": {"enum": ["blocker", "high", "medium", "low"]},
        "owner": {"const": "scaffold-harness"},
        "meaning": {"type": "string", "minLength": 1}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psp.dev/schemas/lit-visual-coverage.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "metadata", "sourceLocks", "litSource", "items", "gaps"],
  "properties": {
    "schemaVersion": {"const": "psp.dev/visual-spec/v1"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "sourceLocks": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/lock"}},
    "litSource": {"$ref": "#/$defs/litSource"},
    "items": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "revision", "status"],
      "properties": {
        "artifactId": {"const": "LIT-VISUAL-COVERAGE"},
        "revision": {"type": "integer", "minimum": 1},
        "status": {"enum": ["draft", "ready", "stale"]}
      }
    },
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "path", "revision", "digest"],
      "properties": {
        "artifactId": {"enum": ["VISUAL-SPEC-READY-AUTHORIZATION", "FIGMA-COVERAGE", "FIGMA-EVIDENCE"]},
        "path": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "litSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "srcUiDigest"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[a-f0-9]{7,64}$"},
        "srcUiDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemId", "status", "route", "component", "viewports", "states", "variants", "contentCases", "tokenRefs", "assetRefs", "motionRefs", "scenarioIds"],
      "properties": {
        "itemId": {"type": "string", "pattern": "^VSI-FDBI-[0-9]{3}-[A-Z]+-[0-9]{2}$"},
        "status": {"enum": ["pending", "implemented", "reviewing", "accepted", "stale"]},
        "route": {"type": ["string", "null"], "pattern": "^/"},
        "component": {"type": "string", "minLength": 1},
        "viewports": {"$ref": "#/$defs/names"},
        "states": {"$ref": "#/$defs/names"},
        "variants": {"$ref": "#/$defs/names"},
        "contentCases": {"$ref": "#/$defs/names"},
        "tokenRefs": {"$ref": "#/$defs/names"},
        "assetRefs": {"$ref": "#/$defs/names"},
        "motionRefs": {"$ref": "#/$defs/names"},
        "scenarioIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "names": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "itemId", "reason"],
      "properties": {
        "code": {"type": "string", "pattern": "^LVC_[A-Z0-9_]+$"},
        "itemId": {"type": "string", "pattern": "^VSI-FDBI-[0-9]{3}-[A-Z]+-[0-9]{2}$"},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psp.dev/schemas/user-path-coverage.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "metadata", "sourceLocks", "litSource", "paths", "gaps"],
  "properties": {
    "schemaVersion": {"const": "psp.dev/visual-spec/v1"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "revision", "status"],
      "properties": {
        "artifactId": {"const": "USER-PATH-COVERAGE"},
        "revision": {"type": "integer", "minimum": 1},
        "status": {"enum": ["draft", "ready", "stale"]}
      }
    },
    "sourceLocks": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/lock"}},
    "litSource": {"$ref": "#/$defs/litSource"},
    "paths": {"type": "array", "items": {"$ref": "#/$defs/path"}},
    "gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "path", "revision", "digest"],
      "properties": {
        "artifactId": {"enum": ["USER-PATH-PLAN", "LIT-VISUAL-COVERAGE", "MOCK-SCENARIO-SUITE"]},
        "path": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "litSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "srcUiDigest"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[a-f0-9]{7,64}$"},
        "srcUiDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pathId", "testCaseRef", "checklistItemRefs", "status", "steps", "traceDigest"],
      "properties": {
        "pathId": {"type": "string", "pattern": "^UP-TC-[0-9]{3}$"},
        "testCaseRef": {"type": "string", "pattern": "^TC-[0-9]{3}$"},
        "checklistItemRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^VSI-FDBI-[0-9]{3}-[A-Z]+-[0-9]{2}$"}},
        "status": {"enum": ["pending", "implemented", "verifying", "accepted", "stale"]},
        "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}},
        "traceDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pathStepId", "route", "component", "scenarioSlot", "checkpoint", "assertion", "passed"],
      "properties": {
        "pathStepId": {"type": "string", "pattern": "^UP-TC-[0-9]{3}-STEP-[0-9]{2}$"},
        "route": {"type": "string", "pattern": "^/"},
        "component": {"type": "string", "minLength": 1},
        "scenarioSlot": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "checkpoint": {"type": "string", "minLength": 1},
        "assertion": {"type": "string", "minLength": 1},
        "passed": {"type": "boolean"}
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "pathId", "reason"],
      "properties": {
        "code": {"type": "string", "pattern": "^UPC_[A-Z0-9_]+$"},
        "pathId": {"type": "string", "pattern": "^UP-TC-[0-9]{3}$"},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psp.dev/schemas/uihtml-production.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "metadata", "deliveryLock", "litSource", "adapter", "bundle", "dependencies"],
  "properties": {
    "schemaVersion": {"const": "psp.dev/visual-spec/v1"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "revision", "status"],
      "properties": {
        "artifactId": {"const": "UIHTML-PRODUCTION"},
        "revision": {"type": "integer", "minimum": 1},
        "status": {"enum": ["built", "accepted", "stale"]}
      }
    },
    "deliveryLock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "path", "revision", "digest"],
      "properties": {
        "artifactId": {"const": "VISUAL-SPEC-DELIVERY"},
        "path": {"const": ".psp/visual-spec/delivery-manifest.json"},
        "revision": {"type": "integer", "minimum": 1},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "litSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "srcUiDigest"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[a-f0-9]{7,64}$"},
        "srcUiDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "adapter": {"const": "real"},
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": {"const": "UIHTML"},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(src/product-main\\.ts|src/ui(?:/.*)?|src/adapters/real(?:/.*)?)$"}
    }
  }
}

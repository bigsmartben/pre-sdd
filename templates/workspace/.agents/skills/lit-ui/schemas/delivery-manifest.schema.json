{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psp.dev/schemas/delivery-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "metadata", "sourceLocks", "litSource", "reviewBuild", "entry", "items", "reviewAcceptance"],
  "properties": {
    "schemaVersion": {"const": "psp.dev/visual-spec/v1"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "revision", "status"],
      "properties": {
        "artifactId": {"const": "VISUAL-SPEC-DELIVERY"},
        "revision": {"type": "integer", "minimum": 1},
        "status": {"enum": ["draft", "reviewing", "accepted", "stale"]}
      }
    },
    "sourceLocks": {
      "type": "array",
      "minItems": 4,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/lock"}
    },
    "litSource": {"$ref": "#/$defs/litSource"},
    "reviewBuild": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": {"const": ".psp/review-dist"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mode"],
      "properties": {
        "path": {"const": "review.html"},
        "mode": {"const": "real-lit"}
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["itemId", "deliveryLevel", "route", "component", "scenarioIds"],
        "properties": {
          "itemId": {"type": "string", "pattern": "^VSI-FDBI-[0-9]{3}-[A-Z]+-[0-9]{2}$"},
          "deliveryLevel": {"enum": ["VISUAL", "USER_PATH"]},
          "route": {"type": ["string", "null"], "pattern": "^/"},
          "component": {"type": "string", "minLength": 1},
          "scenarioIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "reviewAcceptance": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["acceptedBy", "acceptedAt"],
          "properties": {
            "acceptedBy": {"type": "string", "minLength": 1},
            "acceptedAt": {"type": "string", "format": "date-time"}
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"metadata": {"properties": {"status": {"const": "accepted"}}, "required": ["status"]}}},
      "then": {"properties": {"reviewAcceptance": {"type": "object"}}}
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "path", "revision", "digest"],
      "properties": {
        "artifactId": {"enum": ["VISUAL-SPEC-CHECKLIST", "FIGMA-COVERAGE", "FIGMA-EVIDENCE", "LIT-VISUAL-COVERAGE", "USER-PATH-COVERAGE"]},
        "path": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "litSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "srcUiDigest"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[a-f0-9]{7,64}$"},
        "srcUiDigest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}

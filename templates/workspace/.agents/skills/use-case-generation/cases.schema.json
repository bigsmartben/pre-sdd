{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "psp.dev/ui-cases/v1",
  "type": "object",
  "required": ["schemaVersion", "businessCases", "componentCases", "gaps"],
  "properties": {
    "schemaVersion": { "const": "psp.dev/ui-cases/v1" },
    "businessCases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["caseId", "name", "sourceRefs", "steps"],
        "properties": {
          "caseId": { "type": "string", "pattern": "^BUSINESS-CASE-" },
          "name": { "type": "string", "minLength": 1 },
          "sourceRefs": { "$ref": "#/$defs/sourceRefs" },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["kind", "conceptId", "sourceRef"],
              "properties": {
                "kind": { "enum": ["route", "page", "component", "event", "port", "state"] },
                "conceptId": { "type": "string" },
                "sourceRef": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "componentCases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["caseId", "name", "componentConceptId", "sourceRefs", "checks"],
        "properties": {
          "caseId": { "type": "string", "pattern": "^COMPONENT-CASE-" },
          "name": { "type": "string", "minLength": 1 },
          "componentConceptId": { "type": "string" },
          "sourceRefs": { "$ref": "#/$defs/sourceRefs" },
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["kind", "sourceRef"],
              "properties": {
                "kind": { "enum": ["property", "attribute", "slot", "component-state", "event", "motion", "viewport"] },
                "sourceRef": { "type": "string" },
                "value": {}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gapId", "conceptId", "question"],
        "properties": {
          "gapId": { "type": "string" },
          "conceptId": { "type": "string" },
          "question": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "sourceRefs": {
      "type": "array",
      "contains": { "type": "string", "pattern": "^uc:" },
      "allOf": [
        { "contains": { "type": "string", "pattern": "^mapping:" } },
        { "contains": { "type": "string", "pattern": "^framework:" } }
      ]
    }
  },
  "additionalProperties": false
}

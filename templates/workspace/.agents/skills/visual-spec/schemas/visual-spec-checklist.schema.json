{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psp.dev/schemas/visual-spec/v1/visual-spec-checklist.schema.json",
  "title": "Visual Spec Checklist",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "metadata", "sourceLocks", "items", "gaps"],
  "properties": {
    "schemaVersion": {"const": "psp.dev/visual-spec/v1"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "revision", "status"],
      "properties": {
        "artifactId": {"const": "VISUAL-SPEC-CHECKLIST"},
        "revision": {"type": "integer", "minimum": 1},
        "status": {"enum": ["draft", "ready", "stale"]}
      }
    },
    "sourceLocks": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/sourceLock"}
    },
    "items": {
      "type": "array",
      "items": {"$ref": "#/$defs/item"}
    },
    "gaps": {
      "type": "array",
      "items": {"$ref": "#/$defs/gap"}
    }
  },
  "$defs": {
    "sourceLock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "path", "revision", "digest"],
      "properties": {
        "artifactId": {"enum": ["PRODUCT-USE-CASES", "FUNCTIONAL-DELIVERY-BASELINE", "TEST-CASE-CATALOG"]},
        "path": {"type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "revision": {"type": "integer", "minimum": 1},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemId", "baselineItemRef", "requirementRefs", "target", "requiredDeliveryLevel", "testCaseRefs", "dimensions", "dependencyDigest", "status"],
      "properties": {
        "itemId": {"type": "string", "pattern": "^VSI-FDBI-[0-9]{3}-(PAGE|COMPONENT|STATE|VARIANT|VIEWPORT|TOKEN|ASSET|MOTION)-[0-9]{2}$"},
        "baselineItemRef": {"type": "string", "pattern": "^FDBI-[0-9]{3}$"},
        "requirementRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+$"}
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "ref", "name"],
          "properties": {
            "kind": {"enum": ["PAGE", "COMPONENT", "STATE", "VARIANT", "VIEWPORT", "TOKEN", "ASSET", "MOTION"]},
            "ref": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+$"},
            "name": {"type": "string", "minLength": 1}
          }
        },
        "requiredDeliveryLevel": {"enum": ["VISUAL", "USER_PATH"]},
        "testCaseRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^TC-[0-9]{3}$"}
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["viewports", "states", "variants", "contentCases", "tokens", "assets", "motions"],
          "properties": {
            "viewports": {"$ref": "#/$defs/names"},
            "states": {"$ref": "#/$defs/names"},
            "variants": {"$ref": "#/$defs/names"},
            "contentCases": {"$ref": "#/$defs/names"},
            "tokens": {"$ref": "#/$defs/names"},
            "assets": {"$ref": "#/$defs/names"},
            "motions": {"$ref": "#/$defs/names"}
          }
        },
        "dependencyDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "status": {"enum": ["pending", "stale"]}
      },
      "allOf": [
        {
          "if": {"properties": {"requiredDeliveryLevel": {"const": "USER_PATH"}}, "required": ["requiredDeliveryLevel"]},
          "then": {"properties": {"testCaseRefs": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"requiredDeliveryLevel": {"const": "VISUAL"}}, "required": ["requiredDeliveryLevel"]},
          "then": {"properties": {"testCaseRefs": {"maxItems": 0}}}
        }
      ]
    },
    "names": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "baselineItemRef", "reason", "missingDimensions"],
      "properties": {
        "code": {"type": "string", "pattern": "^VSC_[A-Z0-9_]+$"},
        "baselineItemRef": {"type": ["string", "null"], "pattern": "^FDBI-[0-9]{3}$"},
        "reason": {"type": "string", "minLength": 1},
        "missingDimensions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}

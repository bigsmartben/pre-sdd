{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MockCase Coverage Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "actor", "scope", "inputHash", "targetModelHash", "candidateHash", "existingCaseIds", "generatedCases", "staleCaseIds", "coverageBefore", "coverageAfter", "gaps"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "status": {"enum": ["PASS", "BLOCKED"]},
    "actor": {"type": "string", "pattern": "^ACTOR-[0-9]{3}$"},
    "scope": {"$ref": "#/$defs/scope"},
    "inputHash": {"$ref": "#/$defs/hash"},
    "targetModelHash": {"$ref": "#/$defs/hash"},
    "candidateHash": {"$ref": "#/$defs/hash"},
    "existingCaseIds": {"$ref": "#/$defs/ids"},
    "generatedCases": {"type": "array", "items": {"$ref": "#/$defs/mockCase"}},
    "staleCaseIds": {"$ref": "#/$defs/ids"},
    "coverageBefore": {"$ref": "#/$defs/coverage"},
    "coverageAfter": {"$ref": "#/$defs/coverage"},
    "gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"},
    "ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routeIds", "useCaseIds", "scenarioIds"],
      "properties": {
        "routeIds": {"$ref": "#/$defs/ids"},
        "useCaseIds": {"$ref": "#/$defs/ids"},
        "scenarioIds": {"$ref": "#/$defs/ids"}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredScenarios", "coveredScenarios"],
      "properties": {
        "requiredScenarios": {"type": "integer", "minimum": 0},
        "coveredScenarios": {"type": "integer", "minimum": 0}
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {"kind": {"enum": ["request", "control-event", "input"]}, "controlId": {"$ref": "#/$defs/id"}},
      "allOf": [
        {
          "if": {"properties": {"kind": {"enum": ["control-event", "input"]}}, "required": ["kind"]},
          "then": {"properties": {"controlId": {}}, "required": ["controlId"]}
        }
      ]
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetInstanceId", "mockBehaviorIds", "activation", "expectedStateMatrixEntryId"],
      "properties": {
        "targetInstanceId": {"$ref": "#/$defs/id"},
        "mockBehaviorIds": {"$ref": "#/$defs/ids"},
        "activation": {"$ref": "#/$defs/activation"},
        "expectedStateMatrixEntryId": {"$ref": "#/$defs/id"}
      }
    },
    "mockCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label", "routeId", "scenarioId", "effects", "isDefault"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"const": "business"},
        "label": {"type": "string", "minLength": 1},
        "routeId": {"$ref": "#/$defs/id"},
        "scenarioId": {"$ref": "#/$defs/id"},
        "effects": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/effect"}},
        "isDefault": {"type": "boolean"}
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "feedbackClass", "message", "targetDomain", "targetArtifact", "targetOperation"],
      "properties": {
        "code": {"const": "AIH_MOCKCASE_UPSTREAM_GAP"},
        "feedbackClass": {"const": "behavior"},
        "useCaseId": {"$ref": "#/$defs/id"},
        "scenarioId": {"$ref": "#/$defs/id"},
        "message": {"type": "string", "minLength": 1},
        "targetDomain": {"const": "product-design"},
        "targetArtifact": {"const": "capabilities"},
        "targetOperation": {"const": "apply-product-artifact"}
      }
    }
  }
}

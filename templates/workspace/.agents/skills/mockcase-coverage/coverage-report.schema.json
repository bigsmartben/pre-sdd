{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MockCase Coverage Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "actor", "scope", "inputHash", "targetModelHash", "existingCaseIds", "generatableScenarioIds", "staleCaseIds", "coverageBefore", "coverageAfter", "gaps"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "status": {"enum": ["PASS", "BLOCKED"]},
    "actor": {"type": "string", "pattern": "^ACTOR-[0-9]{3}$"},
    "scope": {"$ref": "#/$defs/scope"},
    "inputHash": {"$ref": "#/$defs/hash"},
    "targetModelHash": {"$ref": "#/$defs/hash"},
    "existingCaseIds": {"$ref": "#/$defs/ids"},
    "generatableScenarioIds": {"$ref": "#/$defs/ids"},
    "staleCaseIds": {"$ref": "#/$defs/ids"},
    "coverageBefore": {"$ref": "#/$defs/coverage"},
    "coverageAfter": {"$ref": "#/$defs/coverage"},
    "gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"},
    "ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routeIds", "useCaseIds", "scenarioIds"],
      "properties": {"routeIds": {"$ref": "#/$defs/ids"}, "useCaseIds": {"$ref": "#/$defs/ids"}, "scenarioIds": {"$ref": "#/$defs/ids"}}
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredScenarios", "coveredScenarios"],
      "properties": {"requiredScenarios": {"type": "integer", "minimum": 0}, "coveredScenarios": {"type": "integer", "minimum": 0}}
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "feedbackClass", "message", "targetDomain", "targetArtifact", "targetOperation"],
      "properties": {
        "code": {"const": "AIH_MOCKCASE_UPSTREAM_GAP"},
        "feedbackClass": {"const": "behavior"},
        "useCaseId": {"$ref": "#/$defs/id"},
        "scenarioId": {"$ref": "#/$defs/id"},
        "message": {"type": "string", "minLength": 1},
        "targetDomain": {"const": "product-design"},
        "targetArtifact": {"const": "capabilities"},
        "targetOperation": {"const": "apply-product-artifact"}
      }
    }
  }
}

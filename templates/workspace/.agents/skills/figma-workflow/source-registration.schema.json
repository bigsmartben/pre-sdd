{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psp.dev/skills/figma-workflow/source-registration.schema.json",
  "title": "Figma Source Registration Packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sourceId", "sourceVersion", "evidencePath", "evidenceSha256", "capturePlan", "designContext", "ingestReceipt", "componentHandshake", "assets", "gaps"],
  "properties": {
    "version": {"const": "3.0.0"},
    "sourceId": {"$ref": "#/$defs/id"},
    "sourceVersion": {"$ref": "#/$defs/sourceVersion"},
    "evidencePath": {"$ref": "#/$defs/path"},
    "evidenceSha256": {"$ref": "#/$defs/sha256"},
    "capturePlan": {"$ref": "#/$defs/fileReference"},
    "designContext": {"$ref": "#/$defs/fileReference"},
    "ingestReceipt": {"$ref": "#/$defs/fileReference"},
    "componentHandshake": {"type": "array", "items": {"$ref": "#/$defs/componentHandshake"}},
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sourceNodeId", "assetBoundaryNodeId", "assetKind", "captureScope", "containsDynamicContent", "strategy", "format", "scale", "cropBounds", "transparentPadding", "expectedDimensions", "sha256", "downloadOperation", "consumerTargets", "status"],
        "properties": {
          "path": {"type": "string", "pattern": "^public/assets/[^/]+/[^/]+\\.(?:png|svg)$"},
          "sourceNodeId": {"$ref": "#/$defs/nodeId"},
          "assetBoundaryNodeId": {"$ref": "#/$defs/nodeId"},
          "assetKind": {"enum": ["icon", "logo", "illustration", "photo", "effect", "other"]},
          "captureScope": {"enum": ["layer", "artwork-subtree"]},
          "containsDynamicContent": {"const": false},
          "strategy": {"const": "asset"},
          "format": {"enum": ["png", "svg"]},
          "scale": {"type": "number", "exclusiveMinimum": 0},
          "cropBounds": {"$ref": "#/$defs/bounds"},
          "transparentPadding": {"$ref": "#/$defs/padding"},
          "expectedDimensions": {"$ref": "#/$defs/dimensions"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "downloadOperation": {"type": "string", "pattern": "^figma:[a-z][a-z0-9-]*$"},
          "consumerTargets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
          "status": {"const": "verified"}
        }
      }
    },
    "gaps": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"},
    "nodeId": {"type": "string", "pattern": "^[0-9]+:[0-9]+$"},
    "path": {"type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "sourceVersion": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "figma-file-version"}, "value": {"type": "string", "minLength": 1}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "remote-last-modified"}, "value": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "node-fingerprint"}, "value": {"$ref": "#/$defs/sha256"}}}
      ]
    },
    "fileReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "componentHandshake": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposalId", "decision", "finalNodeIds", "structureSignatures", "figmaComponentContract", "usageBindings", "baselineEvidenceItemIds"],
      "properties": {
        "proposalId": {"$ref": "#/$defs/id"},
        "decision": {"enum": ["shared-component", "primitive-only", "local-structure"]},
        "finalNodeIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nodeId"}},
        "structureSignatures": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
        "figmaComponentContract": {"$ref": "#/$defs/figmaComponentContract"},
        "usageBindings": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/usageBinding"}},
        "baselineEvidenceItemIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "figmaComponentNodeId": {"$ref": "#/$defs/nodeId"},
        "variantDefinitionNodeIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nodeId"}},
        "variantUsageInstanceNodeIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nodeId"}}
      },
      "allOf": [
        {
          "if": {"properties": {"decision": {"const": "shared-component"}}, "required": ["decision"]},
          "then": {
            "required": ["figmaComponentNodeId", "variantDefinitionNodeIds", "variantUsageInstanceNodeIds"],
            "properties": {
              "figmaComponentNodeId": {},
              "variantDefinitionNodeIds": {},
              "variantUsageInstanceNodeIds": {}
            }
          },
          "else": {"not": {"anyOf": [{"required": ["figmaComponentNodeId"]}, {"required": ["variantDefinitionNodeIds"]}, {"required": ["variantUsageInstanceNodeIds"]}]}}
        }
      ]
    },
    "usageBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instanceNodeId", "screenId"],
      "properties": {"instanceNodeId": {"$ref": "#/$defs/nodeId"}, "screenId": {"$ref": "#/$defs/id"}}
    },
    "figmaComponentContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "properties", "variantAxes", "contentRegions", "nestedComponentNodeIds", "sizeBehavior"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "properties": {"type": "array", "items": {"$ref": "#/$defs/figmaProperty"}},
        "variantAxes": {"type": "array", "items": {"$ref": "#/$defs/variantAxis"}},
        "contentRegions": {"type": "array", "items": {"$ref": "#/$defs/contentRegion"}},
        "nestedComponentNodeIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nodeId"}},
        "sizeBehavior": {"$ref": "#/$defs/sizeBehavior"}
      }
    },
    "figmaProperty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "values"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["variant", "text", "boolean", "instance-swap"]},
        "values": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "variantAxis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "values"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "values": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "contentRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role"],
      "properties": {"name": {"type": "string", "minLength": 1}, "role": {"type": "string", "minLength": 1}}
    },
    "sizeBehavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "wrap"],
      "properties": {
        "width": {"enum": ["fixed", "hug", "fill", "content", "mixed"]},
        "height": {"enum": ["fixed", "hug", "fill", "content", "mixed"]},
        "wrap": {"enum": ["none", "text", "content", "mixed"]}
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}}
    },
    "padding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["top", "right", "bottom", "left"],
      "properties": {"top": {"type": "integer", "minimum": 0}, "right": {"type": "integer", "minimum": 0}, "bottom": {"type": "integer", "minimum": 0}, "left": {"type": "integer", "minimum": 0}}
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {"width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}
    }
  }
}

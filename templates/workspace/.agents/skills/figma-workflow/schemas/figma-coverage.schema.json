{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psp.dev/schemas/figma-coverage.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "metadata", "checklistLock", "source", "items", "gaps"],
  "properties": {
    "schemaVersion": {"const": "psp.dev/visual-spec/v1"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "revision", "status"],
      "properties": {
        "artifactId": {"const": "FIGMA-COVERAGE"},
        "revision": {"type": "integer", "minimum": 1},
        "status": {"enum": ["draft", "ready", "stale"]}
      }
    },
    "checklistLock": {"$ref": "#/$defs/lock"},
    "source": {"$ref": "#/$defs/source"},
    "items": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "path", "revision", "digest"],
      "properties": {
        "artifactId": {"const": "VISUAL-SPEC-CHECKLIST"},
        "path": {"const": ".psp/visual-spec/checklist.json"},
        "revision": {"type": "integer", "minimum": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "fileId", "locator", "scope", "revision", "digest", "capturedAt"],
      "properties": {
        "provider": {"const": "figma"},
        "fileId": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "pattern": "^figma://[^\\s]+$"},
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "refs"],
          "properties": {
            "kind": {"enum": ["file", "page", "node"]},
            "refs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "revision": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"},
        "capturedAt": {"type": "string", "format": "date-time"}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemId", "status", "anchors"],
      "properties": {
        "itemId": {"type": "string", "pattern": "^VSI-FDBI-[0-9]{3}-[A-Z]+-[0-9]{2}$"},
        "status": {"enum": ["covered", "missing", "stale"]},
        "anchors": {
          "type": "array",
          "items": {"$ref": "#/$defs/anchor"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "covered"}}, "required": ["status"]},
          "then": {"properties": {"anchors": {"minItems": 1}}}
        }
      ]
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "nodeDigest", "role", "viewport", "state", "variant", "contentCase", "properties"],
      "properties": {
        "nodeId": {"type": "string", "minLength": 1},
        "nodeDigest": {"$ref": "#/$defs/digest"},
        "role": {"enum": ["page", "component", "state", "variant", "viewport", "token", "asset", "motion"]},
        "viewport": {"type": ["string", "null"], "minLength": 1},
        "state": {"type": ["string", "null"], "minLength": 1},
        "variant": {"type": ["string", "null"], "minLength": 1},
        "contentCase": {"type": ["string", "null"], "minLength": 1},
        "properties": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["geometry", "layout", "appearance", "typography", "state", "variant", "viewport", "asset", "token", "motion"]}
        }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "itemId", "reason"],
      "properties": {
        "code": {"enum": ["FGC_ITEM_MISSING", "FGC_PROPERTY_MISSING", "FGC_SOURCE_STALE", "FGC_UNSUPPORTED"]},
        "itemId": {"type": "string", "pattern": "^VSI-FDBI-[0-9]{3}-[A-Z]+-[0-9]{2}$"},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}

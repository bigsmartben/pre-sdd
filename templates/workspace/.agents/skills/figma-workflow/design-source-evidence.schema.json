{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psp.dev/domains/product-design/design-source-evidence.schema.json",
  "title": "Figma Design Source Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sourceId", "kind", "location", "capturedAt", "items"],
  "properties": {
    "version": {"const": "6.0.0"},
    "sourceId": {"$ref": "#/$defs/id"},
    "kind": {"enum": ["figma", "screenshot", "export", "other"]},
    "location": {"type": "string", "minLength": 1},
    "capturedAt": {"$ref": "#/$defs/timestamp"},
    "nodeId": {"$ref": "#/$defs/nodeId"},
    "sourceVersion": {"$ref": "#/$defs/sourceVersion"},
    "items": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/item"}}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "figma"}}, "required": ["kind"]},
      "then": {
        "required": ["nodeId", "sourceVersion"],
        "properties": {
          "nodeId": {"$ref": "#/$defs/nodeId"},
          "sourceVersion": {"$ref": "#/$defs/sourceVersion"},
          "location": {"$ref": "#/$defs/figmaLocation"},
          "items": {
            "type": "array",
            "allOf": [
              {"contains": {"type": "object", "properties": {"role": {"const": "raw-design-context"}}, "required": ["role"]}, "minContains": 1, "maxContains": 1},
              {"contains": {"type": "object", "properties": {"role": {"const": "design-context"}}, "required": ["role"]}, "minContains": 1, "maxContains": 1},
              {"contains": {"type": "object", "properties": {"role": {"const": "screenshot"}}, "required": ["role"]}},
              {"contains": {"type": "object", "properties": {"role": {"const": "capture-plan"}}, "required": ["role"]}, "minContains": 1, "maxContains": 1},
              {"contains": {"type": "object", "properties": {"role": {"const": "ingest-receipt"}}, "required": ["role"]}, "minContains": 1, "maxContains": 1}
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"},
    "nodeId": {"type": "string", "pattern": "^[0-9]+:[0-9]+$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
    "figmaLocation": {"type": "string", "pattern": "^https://(?:www\\.)?figma\\.com/design/[^/?#]+/[^?#]+\\?[^#]*node-id=[0-9]+[-:][0-9]+(?:&[^#]*)?$"},
    "path": {"type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "bounds": {"type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"], "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}}},
    "padding": {"type": "object", "additionalProperties": false, "required": ["top", "right", "bottom", "left"], "properties": {"top": {"type": "integer", "minimum": 0}, "right": {"type": "integer", "minimum": 0}, "bottom": {"type": "integer", "minimum": 0}, "left": {"type": "integer", "minimum": 0}}},
    "dimensions": {"type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": {"width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}},
    "sourceVersion": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {"const": "figma-file-version"},
            "value": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {"const": "remote-last-modified"},
            "value": {"$ref": "#/$defs/timestamp"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {"const": "node-fingerprint"},
            "value": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "path", "sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "role": {"enum": ["raw-design-context", "design-context", "screenshot", "variable-definitions", "capture-plan", "ingest-receipt", "asset", "code-connect-map"]},
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "schema": {"type": "string", "minLength": 1},
        "sourceNodeId": {"$ref": "#/$defs/nodeId"},
        "assetBoundaryNodeId": {"$ref": "#/$defs/nodeId"},
        "assetKind": {"enum": ["icon", "logo", "illustration", "photo", "effect", "other"]},
        "captureScope": {"enum": ["layer", "artwork-subtree"]},
        "containsDynamicContent": {"const": false},
        "strategy": {"const": "asset"},
        "format": {"enum": ["png", "svg"]},
        "scale": {"type": "number", "exclusiveMinimum": 0},
        "cropBounds": {"$ref": "#/$defs/bounds"},
        "transparentPadding": {"$ref": "#/$defs/padding"},
        "expectedDimensions": {"$ref": "#/$defs/dimensions"},
        "downloadOperation": {"type": "string", "pattern": "^figma:[a-z][a-z0-9-]*$"},
        "consumerTargets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "status": {"const": "verified"}
      },
      "allOf": [
        {
          "if": {"properties": {"role": {"enum": ["design-context", "capture-plan", "ingest-receipt"]}}, "required": ["role"]},
          "then": {"properties": {"schema": {}}, "required": ["schema"]}
        },
        {
          "if": {"properties": {"role": {"const": "asset"}}, "required": ["role"]},
          "then": {
            "properties": {
              "sourceNodeId": {},
              "assetBoundaryNodeId": {},
              "assetKind": {},
              "captureScope": {},
              "containsDynamicContent": {},
              "strategy": {},
              "format": {},
              "scale": {},
              "cropBounds": {},
              "transparentPadding": {},
              "expectedDimensions": {},
              "downloadOperation": {},
              "consumerTargets": {},
              "status": {}
            },
            "required": ["sourceNodeId", "assetBoundaryNodeId", "assetKind", "captureScope", "containsDynamicContent", "strategy", "format", "scale", "cropBounds", "transparentPadding", "expectedDimensions", "downloadOperation", "consumerTargets", "status"]
          }
        }
      ]
    }
  }
}

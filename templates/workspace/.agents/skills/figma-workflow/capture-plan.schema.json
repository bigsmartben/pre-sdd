{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psp.dev/skills/figma-workflow/capture-plan.schema.json",
  "title": "Figma Workflow Capture Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "sourceId",
    "rootNodeId",
    "sourceVersion",
    "scopeAudit",
    "writebackApproval",
    "writebackReceipt",
    "finalFigmaAcceptance",
    "frozenAt",
    "formalCapture",
    "candidateVisualNodes"
  ],
  "properties": {
    "version": {"const": "3.0.0"},
    "sourceId": {"$ref": "#/$defs/id"},
    "rootNodeId": {"$ref": "#/$defs/nodeId"},
    "sourceVersion": {"$ref": "#/$defs/sourceVersion"},
    "scopeAudit": {"$ref": "#/$defs/scopeAudit"},
    "writebackApproval": {"$ref": "#/$defs/writebackApproval"},
    "writebackReceipt": {"$ref": "#/$defs/writebackReceipt"},
    "finalFigmaAcceptance": {"$ref": "#/$defs/finalFigmaAcceptance"},
    "frozenAt": {"$ref": "#/$defs/timestamp"},
    "formalCapture": {"$ref": "#/$defs/formalCapture"},
    "candidateVisualNodes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/candidateVisualNode"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"},
    "nodeId": {"type": "string", "pattern": "^[0-9]+:[0-9]+$"},
    "humanIdentity": {"type": "string", "pattern": "^user:[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
    "sourceVersion": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "figma-file-version"}, "value": {"type": "string", "minLength": 1}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "remote-last-modified"}, "value": {"$ref": "#/$defs/timestamp"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "node-fingerprint"}, "value": {"$ref": "#/$defs/sha256"}}}
      ]
    },
    "status": {"enum": ["PASS", "FAIL", "EXCLUDED"]},
    "auditReason": {"type": "string", "minLength": 1},
    "scanInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scannedAt", "sourceVersion", "rootNodeId", "nodes"],
      "properties": {
        "scannedAt": {"$ref": "#/$defs/timestamp"},
        "sourceVersion": {"$ref": "#/$defs/sourceVersion"},
        "rootNodeId": {"$ref": "#/$defs/nodeId"},
        "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scannedNode"}}
      }
    },
    "scannedNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "nodeId", "name", "visible"],
      "properties": {
        "kind": {"enum": ["page", "section", "frame", "group", "component-set", "component", "instance", "image", "visual"]},
        "nodeId": {"$ref": "#/$defs/nodeId"},
        "name": {"type": "string", "minLength": 1},
        "visible": {"type": "boolean"},
        "parentNodeId": {"$ref": "#/$defs/nodeId"}
      }
    },
    "scopeNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "nodeId", "name"],
      "properties": {
        "kind": {"enum": ["page", "section", "frame", "group", "component-set", "component", "instance", "image", "visual"]},
        "nodeId": {"$ref": "#/$defs/nodeId"},
        "name": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "screenBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["screenId", "figmaRootNodeId", "viewportId", "scenarioId", "stateIds"],
      "properties": {
        "screenId": {"$ref": "#/$defs/id"},
        "figmaRootNodeId": {"$ref": "#/$defs/nodeId"},
        "viewportId": {"$ref": "#/$defs/id"},
        "scenarioId": {"$ref": "#/$defs/id"},
        "stateIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "pageCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedPageId", "status"],
      "properties": {
        "expectedPageId": {"$ref": "#/$defs/id"},
        "figmaPageNodeId": {"oneOf": [{"$ref": "#/$defs/nodeId"}, {"type": "null"}]},
        "status": {"$ref": "#/$defs/status"},
        "reason": {"$ref": "#/$defs/auditReason"}
      }
    },
    "groupIntegrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["groupNodeId", "memberNodeIds", "containsVisualContent", "assetBoundaryNodeId", "status"],
      "properties": {
        "groupNodeId": {"$ref": "#/$defs/nodeId"},
        "memberNodeIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nodeId"}},
        "containsVisualContent": {"type": "boolean"},
        "assetBoundaryNodeId": {"oneOf": [{"$ref": "#/$defs/nodeId"}, {"type": "null"}]},
        "status": {"$ref": "#/$defs/status"},
        "reason": {"$ref": "#/$defs/auditReason"}
      }
    },
    "imageGroupCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["imageNodeId", "ownerGroupNodeId", "expectedGroupNodeId", "status"],
      "properties": {
        "imageNodeId": {"$ref": "#/$defs/nodeId"},
        "ownerGroupNodeId": {"oneOf": [{"$ref": "#/$defs/nodeId"}, {"type": "null"}]},
        "expectedGroupNodeId": {"$ref": "#/$defs/nodeId"},
        "status": {"$ref": "#/$defs/status"},
        "reason": {"$ref": "#/$defs/auditReason"}
      }
    },
    "stateCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["screenId", "stateId", "figmaNodeIds", "status"],
      "properties": {
        "screenId": {"$ref": "#/$defs/id"},
        "stateId": {"$ref": "#/$defs/id"},
        "figmaNodeIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nodeId"}},
        "status": {"$ref": "#/$defs/status"},
        "reason": {"$ref": "#/$defs/auditReason"}
      }
    },
    "variantCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposalId", "axisName", "expectedValues", "observedValues", "definitionNodeIds", "status"],
      "properties": {
        "proposalId": {"$ref": "#/$defs/id"},
        "axisName": {"type": "string", "minLength": 1},
        "expectedValues": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "observedValues": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "definitionNodeIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nodeId"}},
        "status": {"$ref": "#/$defs/status"},
        "reason": {"$ref": "#/$defs/auditReason"}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "nodeIds", "message", "resolved"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["page", "group", "image-group", "state", "variant", "other"]},
        "nodeIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nodeId"}},
        "message": {"type": "string", "minLength": 1},
        "resolved": {"type": "boolean"}
      }
    },
    "writebackOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "targetNodeIds", "reason"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["rename", "group", "reorder", "replace-component", "create-component", "create-component-set", "create-variant", "create-variable", "detach-instance"]},
        "targetNodeIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nodeId"}},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "componentProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nodeIds", "decision", "structureSignatures", "componentBoundary", "figmaComponentContract"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "nodeIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nodeId"}},
        "decision": {"enum": ["shared-component", "primitive-only", "local-structure"]},
        "structureSignatures": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
        "componentBoundary": {"$ref": "#/$defs/componentBoundary"},
        "figmaComponentContract": {"$ref": "#/$defs/figmaComponentContract"}
      }
    },
    "componentBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "rootNodeId", "nestedComponentNodeIds"],
      "properties": {
        "kind": {"enum": ["single-component", "component-set", "nested-components"]},
        "rootNodeId": {"$ref": "#/$defs/nodeId"},
        "nestedComponentNodeIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nodeId"}}
      }
    },
    "figmaComponentContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "properties", "variantAxes", "contentRegions", "nestedComponentNodeIds", "sizeBehavior"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "properties": {"type": "array", "items": {"$ref": "#/$defs/figmaProperty"}},
        "variantAxes": {"type": "array", "items": {"$ref": "#/$defs/variantAxis"}},
        "contentRegions": {"type": "array", "items": {"$ref": "#/$defs/contentRegion"}},
        "nestedComponentNodeIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nodeId"}},
        "sizeBehavior": {"$ref": "#/$defs/sizeBehavior"}
      }
    },
    "figmaProperty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "values"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["variant", "text", "boolean", "instance-swap"]},
        "values": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "variantAxis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "values"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "values": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "contentRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1}
      }
    },
    "sizeBehavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "wrap"],
      "properties": {
        "width": {"enum": ["fixed", "hug", "fill", "content", "mixed"]},
        "height": {"enum": ["fixed", "hug", "fill", "content", "mixed"]},
        "wrap": {"enum": ["none", "text", "content", "mixed"]}
      }
    },
    "scopeAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256",
        "scopeMode",
        "sourceVersion",
        "rootNodeId",
        "scanInventory",
        "screenBindings",
        "includedNodes",
        "excludedNodes",
        "pageCoverage",
        "groupIntegrity",
        "imageGroupCoverage",
        "stateCoverage",
        "variantCoverage",
        "findings",
        "writebackPlan",
        "componentProposals"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "scopeMode": {"enum": ["file", "selection"]},
        "sourceVersion": {"$ref": "#/$defs/sourceVersion"},
        "rootNodeId": {"$ref": "#/$defs/nodeId"},
        "scanInventory": {"$ref": "#/$defs/scanInventory"},
        "screenBindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/screenBinding"}},
        "includedNodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scopeNode"}},
        "excludedNodes": {"type": "array", "items": {"$ref": "#/$defs/scopeNode"}},
        "pageCoverage": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pageCoverage"}},
        "groupIntegrity": {"type": "array", "items": {"$ref": "#/$defs/groupIntegrity"}},
        "imageGroupCoverage": {"type": "array", "items": {"$ref": "#/$defs/imageGroupCoverage"}},
        "stateCoverage": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stateCoverage"}},
        "variantCoverage": {"type": "array", "items": {"$ref": "#/$defs/variantCoverage"}},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "writebackPlan": {"type": "array", "items": {"$ref": "#/$defs/writebackOperation"}},
        "componentProposals": {"type": "array", "items": {"$ref": "#/$defs/componentProposal"}}
      }
    },
    "detachApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instanceNodeId", "blockingReason"],
      "properties": {
        "instanceNodeId": {"$ref": "#/$defs/nodeId"},
        "blockingReason": {"type": "string", "minLength": 1}
      }
    },
    "writebackApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256", "confirmedBy", "confirmedAt", "sourceVersion", "scopeAuditId", "scopeAuditSha256", "operationIds", "detachApprovals"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "confirmedBy": {"$ref": "#/$defs/humanIdentity"},
        "confirmedAt": {"$ref": "#/$defs/timestamp"},
        "sourceVersion": {"$ref": "#/$defs/sourceVersion"},
        "scopeAuditId": {"$ref": "#/$defs/id"},
        "scopeAuditSha256": {"$ref": "#/$defs/sha256"},
        "operationIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "detachApprovals": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/detachApproval"}}
      }
    },
    "postWriteAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scanInventory", "pageCoverage", "groupIntegrity", "imageGroupCoverage", "stateCoverage", "variantCoverage", "findings"],
      "properties": {
        "scanInventory": {"$ref": "#/$defs/scanInventory"},
        "pageCoverage": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pageCoverage"}},
        "groupIntegrity": {"type": "array", "items": {"$ref": "#/$defs/groupIntegrity"}},
        "imageGroupCoverage": {"type": "array", "items": {"$ref": "#/$defs/imageGroupCoverage"}},
        "stateCoverage": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stateCoverage"}},
        "variantCoverage": {"type": "array", "items": {"$ref": "#/$defs/variantCoverage"}},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
      }
    },
    "writebackReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256", "writebackApprovalId", "writebackApprovalSha256", "sourceVersionBefore", "sourceVersionAfter", "operationIds", "beforeInventorySha256", "afterInventorySha256", "screenshotEvidenceItemIds", "postWriteAudit", "completedAt"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "writebackApprovalId": {"$ref": "#/$defs/id"},
        "writebackApprovalSha256": {"$ref": "#/$defs/sha256"},
        "sourceVersionBefore": {"$ref": "#/$defs/sourceVersion"},
        "sourceVersionAfter": {"$ref": "#/$defs/sourceVersion"},
        "operationIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "beforeInventorySha256": {"$ref": "#/$defs/sha256"},
        "afterInventorySha256": {"$ref": "#/$defs/sha256"},
        "screenshotEvidenceItemIds": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "postWriteAudit": {"$ref": "#/$defs/postWriteAudit"},
        "completedAt": {"$ref": "#/$defs/timestamp"}
      }
    },
    "finalFigmaAcceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256", "confirmedBy", "confirmedAt", "sourceVersion", "writebackReceiptId", "writebackReceiptSha256", "result"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "confirmedBy": {"$ref": "#/$defs/humanIdentity"},
        "confirmedAt": {"$ref": "#/$defs/timestamp"},
        "sourceVersion": {"$ref": "#/$defs/sourceVersion"},
        "writebackReceiptId": {"$ref": "#/$defs/id"},
        "writebackReceiptSha256": {"$ref": "#/$defs/sha256"},
        "result": {"const": "accepted"}
      }
    },
    "formalCapture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "startedAt", "completedAt", "sourceVersionBefore", "sourceVersionAfter"],
      "properties": {
        "ordinal": {"const": 1},
        "startedAt": {"$ref": "#/$defs/timestamp"},
        "completedAt": {"$ref": "#/$defs/timestamp"},
        "sourceVersionBefore": {"$ref": "#/$defs/sourceVersion"},
        "sourceVersionAfter": {"$ref": "#/$defs/sourceVersion"}
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"},
        "width": {"type": "number", "exclusiveMinimum": 0},
        "height": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "padding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["top", "right", "bottom", "left"],
      "properties": {
        "top": {"type": "integer", "minimum": 0},
        "right": {"type": "integer", "minimum": 0},
        "bottom": {"type": "integer", "minimum": 0},
        "left": {"type": "integer", "minimum": 0}
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "assetExport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "scale", "cropBounds", "transparentPadding", "expectedDimensions", "targetPath", "downloadOperation"],
      "properties": {
        "format": {"enum": ["png", "svg"]},
        "scale": {"type": "number", "exclusiveMinimum": 0},
        "cropBounds": {"$ref": "#/$defs/bounds"},
        "transparentPadding": {"$ref": "#/$defs/padding"},
        "expectedDimensions": {"$ref": "#/$defs/dimensions"},
        "targetPath": {"type": "string", "pattern": "^public/assets/[^/]+/[^/]+\\.(?:png|svg)$"},
        "downloadOperation": {"type": "string", "pattern": "^figma:[a-z][a-z0-9-]*$"},
        "previousSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "candidateVisualNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "name", "strategy", "assetBoundaryNodeId"],
      "properties": {
        "nodeId": {"$ref": "#/$defs/nodeId"},
        "name": {"type": "string", "minLength": 1},
        "strategy": {"enum": ["asset", "layout", "dynamic", "ignored"]},
        "assetBoundaryNodeId": {"oneOf": [{"$ref": "#/$defs/nodeId"}, {"type": "null"}]},
        "assetKind": {"enum": ["icon", "logo", "illustration", "photo", "effect", "other"]},
        "captureScope": {"enum": ["layer", "artwork-subtree"]},
        "containsDynamicContent": {"const": false},
        "consumerTargets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "assetExport": {"$ref": "#/$defs/assetExport"},
        "reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"strategy": {"const": "asset"}}, "required": ["strategy"]},
          "then": {
            "required": ["assetKind", "captureScope", "containsDynamicContent", "consumerTargets", "assetExport"],
            "properties": {
              "assetBoundaryNodeId": {"$ref": "#/$defs/nodeId"},
              "assetKind": {},
              "captureScope": {},
              "containsDynamicContent": {},
              "consumerTargets": {},
              "assetExport": {}
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {"required": ["assetKind"]},
                {"required": ["captureScope"]},
                {"required": ["containsDynamicContent"]},
                {"required": ["consumerTargets"]},
                {"required": ["assetExport"]}
              ]
            }
          }
        },
        {
          "if": {"properties": {"strategy": {"enum": ["dynamic", "ignored"]}}, "required": ["strategy"]},
          "then": {"required": ["reason"], "properties": {"reason": {}}}
        }
      ]
    }
  }
}

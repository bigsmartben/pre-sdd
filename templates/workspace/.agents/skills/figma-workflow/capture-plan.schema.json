{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psp.dev/adapters/figma/capture-plan.schema.json",
  "title": "Figma Deterministic Asset Capture Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sourceId", "rootNodeId", "sourceVersion", "scopeConfirmation", "highImpactConfirmation", "writebackBoundary", "frozenAt", "formalCapture", "candidateVisualNodes"],
  "properties": {
    "version": {"const": "2.0.0"},
    "sourceId": {"$ref": "#/$defs/id"},
    "rootNodeId": {"$ref": "#/$defs/nodeId"},
    "sourceVersion": {"$ref": "#/$defs/sourceVersion"},
    "scopeConfirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256", "confirmedBy", "confirmedAt", "sourceVersion", "rootNodeId", "scanInventory", "screenBindings", "includedNodes", "excludedNodes", "viewportIds", "scenarioIds", "stateIds", "counts"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "confirmedBy": {"$ref": "#/$defs/humanIdentity"},
        "confirmedAt": {"$ref": "#/$defs/timestamp"},
        "sourceVersion": {"$ref": "#/$defs/sourceVersion"},
        "rootNodeId": {"$ref": "#/$defs/nodeId"},
        "scanInventory": {"$ref": "#/$defs/scanInventory"},
        "screenBindings": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/screenBinding"}
        },
        "includedNodes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/scopeNode"}},
        "excludedNodes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/excludedScopeNode"}},
        "viewportIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "scenarioIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "stateIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pages", "components", "visualNodes", "viewports", "scenarios", "states"],
          "properties": {
            "pages": {"type": "integer", "minimum": 0},
            "components": {"type": "integer", "minimum": 0},
            "visualNodes": {"type": "integer", "minimum": 0},
            "viewports": {"type": "integer", "minimum": 1},
            "scenarios": {"type": "integer", "minimum": 1},
            "states": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "highImpactConfirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256", "confirmedBy", "confirmedAt", "sourceVersion", "scopeConfirmationId", "scopeConfirmationSha256", "componentProposals", "stateAxes", "resourceAmbiguities", "writebackOperations", "detachApprovals"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "confirmedBy": {"$ref": "#/$defs/humanIdentity"},
        "confirmedAt": {"$ref": "#/$defs/timestamp"},
        "sourceVersion": {"$ref": "#/$defs/sourceVersion"},
        "scopeConfirmationId": {"$ref": "#/$defs/id"},
        "scopeConfirmationSha256": {"$ref": "#/$defs/sha256"},
        "componentProposals": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/componentProposal"}},
        "stateAxes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/stateAxis"}},
        "resourceAmbiguities": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/resourceAmbiguity"}},
        "writebackOperations": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/writebackOperation"}},
        "detachApprovals": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/detachApproval"}}
      }
    },
    "writebackBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scopeConfirmationId", "highImpactConfirmationId", "highImpactConfirmationSha256", "sourceVersionBefore", "sourceVersionAfter", "operationIds", "completedAt", "formalCaptureOrdinal", "recaptureTriggers"],
      "properties": {
        "scopeConfirmationId": {"$ref": "#/$defs/id"},
        "highImpactConfirmationId": {"$ref": "#/$defs/id"},
        "highImpactConfirmationSha256": {"$ref": "#/$defs/sha256"},
        "sourceVersionBefore": {"$ref": "#/$defs/sourceVersion"},
        "sourceVersionAfter": {"$ref": "#/$defs/sourceVersion"},
        "operationIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "completedAt": {"$ref": "#/$defs/timestamp"},
        "formalCaptureOrdinal": {"const": 1},
        "recaptureTriggers": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"enum": ["scope-change", "source-version-change", "post-freeze-writeback"]},
          "allOf": [
            {"contains": {"const": "scope-change"}},
            {"contains": {"const": "source-version-change"}},
            {"contains": {"const": "post-freeze-writeback"}}
          ]
        }
      }
    },
    "frozenAt": {"$ref": "#/$defs/timestamp"},
    "formalCapture": {"$ref": "#/$defs/formalCapture"},
    "candidateVisualNodes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/candidateVisualNode"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"},
    "nodeId": {"type": "string", "pattern": "^[0-9]+:[0-9]+$"},
    "humanIdentity": {"type": "string", "pattern": "^user:[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "path": {"type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
    "sourceVersion": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "figma-file-version"}, "value": {"type": "string", "minLength": 1}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "remote-last-modified"}, "value": {"$ref": "#/$defs/timestamp"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "node-fingerprint"}, "value": {"$ref": "#/$defs/sha256"}}}
      ]
    },
    "scanInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scannedAt", "sourceVersion", "rootNodeId", "nodes"],
      "properties": {
        "scannedAt": {"$ref": "#/$defs/timestamp"},
        "sourceVersion": {"$ref": "#/$defs/sourceVersion"},
        "rootNodeId": {"$ref": "#/$defs/nodeId"},
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/scannedNode"}
        }
      }
    },
    "scannedNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "nodeId", "name"],
      "properties": {
        "kind": {"enum": ["page", "component", "visual"]},
        "nodeId": {"$ref": "#/$defs/nodeId"},
        "name": {"type": "string", "minLength": 1},
        "parentNodeId": {"$ref": "#/$defs/nodeId"}
      }
    },
    "screenBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["screenId", "figmaRootNodeId", "viewportId", "scenarioId", "stateIds"],
      "properties": {
        "screenId": {"$ref": "#/$defs/id"},
        "figmaRootNodeId": {"$ref": "#/$defs/nodeId"},
        "viewportId": {"$ref": "#/$defs/id"},
        "scenarioId": {"$ref": "#/$defs/id"},
        "stateIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        }
      }
    },
    "formalCapture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "startedAt", "completedAt", "sourceVersionBefore", "sourceVersionAfter"],
      "properties": {
        "ordinal": {"const": 1},
        "startedAt": {"$ref": "#/$defs/timestamp"},
        "completedAt": {"$ref": "#/$defs/timestamp"},
        "sourceVersionBefore": {"$ref": "#/$defs/sourceVersion"},
        "sourceVersionAfter": {"$ref": "#/$defs/sourceVersion"}
      }
    },
    "scopeNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "nodeId", "name"],
      "properties": {
        "kind": {"enum": ["page", "component", "visual"]},
        "nodeId": {"$ref": "#/$defs/nodeId"},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "excludedScopeNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "nodeId", "name", "reason"],
      "properties": {
        "kind": {"enum": ["page", "component", "visual"]},
        "nodeId": {"$ref": "#/$defs/nodeId"},
        "name": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "componentProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nodeIds", "decision", "semanticRole", "structureSignatures", "reason", "counterexample", "componentBoundary", "sizeBehavior", "interfaceProposal"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "nodeIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nodeId"}
        },
        "decision": {"enum": ["shared-component", "primitive-only", "local-structure"]},
        "componentName": {"type": "string", "minLength": 1},
        "semanticRole": {"type": "string", "minLength": 1},
        "structureSignatures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "reason": {"type": "string", "minLength": 1},
        "counterexample": {"type": "string", "minLength": 1},
        "componentBoundary": {"$ref": "#/$defs/componentBoundary"},
        "sizeBehavior": {"$ref": "#/$defs/sizeBehavior"},
        "interfaceProposal": {"$ref": "#/$defs/interfaceProposal"}
      },
      "allOf": [
        {
          "if": {"properties": {"decision": {"const": "shared-component"}}, "required": ["decision"]},
          "then": {"properties": {"componentName": {}}, "required": ["componentName"]},
          "else": {"not": {"required": ["componentName"]}}
        }
      ]
    },
    "stateAxis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "proposalId", "kind", "name", "values"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "proposalId": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["variant", "runtime-state", "interaction-state", "content-override"]},
        "name": {"type": "string", "minLength": 1},
        "values": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "componentBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "rootNodeId", "nestedComponentNodeIds"],
      "properties": {
        "kind": {"enum": ["single-component", "component-set", "nested-components"]},
        "rootNodeId": {"$ref": "#/$defs/nodeId"},
        "nestedComponentNodeIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nodeId"}
        }
      }
    },
    "sizeBehavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "wrap"],
      "properties": {
        "width": {"$ref": "#/$defs/sizeDimension"},
        "height": {"$ref": "#/$defs/sizeDimension"},
        "wrap": {"enum": ["none", "text", "content", "mixed"]}
      }
    },
    "sizeDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "min", "max"],
      "properties": {
        "mode": {"enum": ["fixed", "hug", "fill", "content", "mixed"]},
        "min": {"type": ["number", "null"], "minimum": 0},
        "max": {"type": ["number", "null"], "exclusiveMinimum": 0}
      }
    },
    "interfaceProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["properties", "slots", "events"],
      "properties": {
        "properties": {
          "type": "array",
          "items": {"$ref": "#/$defs/interfaceProperty"}
        },
        "slots": {
          "type": "array",
          "items": {"$ref": "#/$defs/interfaceSlot"}
        },
        "events": {
          "type": "array",
          "items": {"$ref": "#/$defs/interfaceEvent"}
        }
      }
    },
    "interfaceProperty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "figmaProperty", "litProperty", "litAttribute", "values"],
      "properties": {
        "kind": {"enum": ["variant", "text", "boolean", "instance-swap"]},
        "figmaProperty": {"type": "string", "minLength": 1},
        "litProperty": {"$ref": "#/$defs/litName"},
        "litAttribute": {
          "oneOf": [
            {"$ref": "#/$defs/litName"},
            {"type": "null"}
          ]
        },
        "values": {
          "type": "array",
          "items": {"$ref": "#/$defs/interfacePropertyValue"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "variant"}}, "required": ["kind"]},
          "then": {
            "properties": {
              "litAttribute": {"$ref": "#/$defs/litName"},
              "values": {"type": "array", "minItems": 1}
            }
          }
        }
      ]
    },
    "interfacePropertyValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["figmaValue", "litValue"],
      "properties": {
        "figmaValue": {"type": "string", "minLength": 1},
        "litValue": {"type": "string", "minLength": 1}
      }
    },
    "interfaceSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["figmaProperty", "litSlot", "contentRole"],
      "properties": {
        "figmaProperty": {"type": "string", "minLength": 1},
        "litSlot": {"$ref": "#/$defs/litName"},
        "contentRole": {"type": "string", "minLength": 1}
      }
    },
    "interfaceEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "trigger", "litEvent"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "trigger": {"type": "string", "minLength": 1},
        "litEvent": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}
      }
    },
    "litName": {"type": "string", "pattern": "^[a-z][A-Za-z0-9]*$"},
    "resourceAmbiguity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "decision", "reason"],
      "properties": {
        "nodeId": {"$ref": "#/$defs/nodeId"},
        "decision": {"enum": ["asset", "dom-css", "dynamic", "ignored"]},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "writebackOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "targetNodeIds", "reason"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["rename", "group", "reorder", "replace-component", "create-component", "create-component-set", "create-variant", "create-variable", "detach-instance"]},
        "targetNodeIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nodeId"}},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "detachApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instanceNodeId", "blockingReason"],
      "properties": {
        "instanceNodeId": {"$ref": "#/$defs/nodeId"},
        "blockingReason": {"type": "string", "minLength": 1}
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"},
        "width": {"type": "number", "exclusiveMinimum": 0},
        "height": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "padding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["top", "right", "bottom", "left"],
      "properties": {
        "top": {"type": "integer", "minimum": 0},
        "right": {"type": "integer", "minimum": 0},
        "bottom": {"type": "integer", "minimum": 0},
        "left": {"type": "integer", "minimum": 0}
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "assetExport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "scale", "cropBounds", "transparentPadding", "expectedDimensions", "targetPath", "downloadOperation"],
      "properties": {
        "format": {"enum": ["png", "svg"]},
        "scale": {"type": "number", "exclusiveMinimum": 0},
        "cropBounds": {"$ref": "#/$defs/bounds"},
        "transparentPadding": {"$ref": "#/$defs/padding"},
        "expectedDimensions": {"$ref": "#/$defs/dimensions"},
        "targetPath": {"type": "string", "pattern": "^public/assets/[^/]+/[^/]+\\.(?:png|svg)$"},
        "downloadOperation": {"type": "string", "pattern": "^figma:[a-z][a-z0-9-]*$"},
        "previousSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "candidateVisualNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "name", "strategy"],
      "properties": {
        "nodeId": {"$ref": "#/$defs/nodeId"},
        "name": {"type": "string", "minLength": 1},
        "strategy": {"enum": ["asset", "dom-css", "dynamic", "ignored"]},
        "assetKind": {"enum": ["icon", "logo", "illustration", "photo", "effect", "other"]},
        "captureScope": {"enum": ["layer", "artwork-subtree"]},
        "containsDynamicContent": {"const": false},
        "consumerTargets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "assetExport": {"$ref": "#/$defs/assetExport"},
        "reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"strategy": {"const": "asset"}}, "required": ["strategy"]},
          "then": {
            "properties": {
              "assetKind": {},
              "captureScope": {},
              "containsDynamicContent": {},
              "consumerTargets": {},
              "assetExport": {}
            },
            "required": ["assetKind", "captureScope", "containsDynamicContent", "consumerTargets", "assetExport"]
          },
          "else": {
            "not": {
              "anyOf": [
                {"required": ["assetKind"]},
                {"required": ["captureScope"]},
                {"required": ["containsDynamicContent"]},
                {"required": ["consumerTargets"]},
                {"required": ["assetExport"]}
              ]
            }
          }
        },
        {
          "if": {"properties": {"strategy": {"const": "ignored"}}, "required": ["strategy"]},
          "then": {"properties": {"reason": {}}, "required": ["reason"]}
        }
      ]
    }
  }
}

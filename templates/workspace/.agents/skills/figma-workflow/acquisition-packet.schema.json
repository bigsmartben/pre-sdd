{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psp.dev/adapters/figma/acquisition-packet.schema.json",
  "title": "Figma Asset Acquisition Packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sourceId", "sourceVersion", "capturePlanSha256", "downloadedAt", "downloadOperation", "files"],
  "properties": {
    "version": {"const": "1.0.0"},
    "sourceId": {"$ref": "#/$defs/id"},
    "sourceVersion": {"$ref": "#/$defs/sourceVersion"},
    "capturePlanSha256": {"$ref": "#/$defs/sha256"},
    "downloadedAt": {"$ref": "#/$defs/timestamp"},
    "downloadOperation": {"type": "string", "pattern": "^figma:[a-z][a-z0-9-]*$"},
    "files": {"type": "array", "items": {"$ref": "#/$defs/file"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"},
    "nodeId": {"type": "string", "pattern": "^[0-9]+:[0-9]+$"},
    "path": {"type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
    "sourceVersion": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "figma-file-version"}, "value": {"type": "string", "minLength": 1}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "remote-last-modified"}, "value": {"$ref": "#/$defs/timestamp"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "node-fingerprint"}, "value": {"$ref": "#/$defs/sha256"}}}
      ]
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}}
    },
    "padding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["top", "right", "bottom", "left"],
      "properties": {"top": {"type": "integer", "minimum": 0}, "right": {"type": "integer", "minimum": 0}, "bottom": {"type": "integer", "minimum": 0}, "left": {"type": "integer", "minimum": 0}}
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {"width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceNodeId", "path", "targetPath", "assetKind", "captureScope", "containsDynamicContent", "format", "scale", "cropBounds", "transparentPadding", "dimensions", "sha256"],
      "properties": {
        "sourceNodeId": {"$ref": "#/$defs/nodeId"},
        "path": {"$ref": "#/$defs/path"},
        "targetPath": {"type": "string", "pattern": "^public/assets/[^/]+/[^/]+\\.(?:png|svg)$"},
        "assetKind": {"enum": ["icon", "logo", "illustration", "photo", "effect", "other"]},
        "captureScope": {"enum": ["layer", "artwork-subtree"]},
        "containsDynamicContent": {"const": false},
        "format": {"enum": ["png", "svg"]},
        "scale": {"type": "number", "exclusiveMinimum": 0},
        "cropBounds": {"$ref": "#/$defs/bounds"},
        "transparentPadding": {"$ref": "#/$defs/padding"},
        "dimensions": {"$ref": "#/$defs/dimensions"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psp.dev/private/figma-intake.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "items", "assets", "tokens", "motions"],
  "properties": {
    "schemaVersion": {"const": "psp.dev/figma-intake/v1"},
    "source": {"$ref": "#/$defs/source"},
    "items": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "assets": {"type": "array", "items": {"$ref": "#/$defs/asset"}},
    "tokens": {"type": "array", "items": {"$ref": "#/$defs/token"}},
    "motions": {"type": "array", "items": {"$ref": "#/$defs/motion"}}
  },
  "$defs": {
    "itemRefs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^VSI-FDBI-[0-9]{3}-[A-Z]+-[0-9]{2}$"}
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "fileId", "locator", "scope", "revision", "capturedAt", "payload", "nodes"],
      "properties": {
        "provider": {"const": "figma"},
        "fileId": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "pattern": "^figma://[^\\s]+$"},
        "scope": {
          "type": "object", "additionalProperties": false, "required": ["kind", "refs"],
          "properties": {
            "kind": {"enum": ["file", "page", "node"]},
            "refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        },
        "revision": {"type": "string", "minLength": 1},
        "capturedAt": {"type": "string", "format": "date-time"},
        "payload": {"type": "object"},
        "nodes": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["nodeId", "pageId", "payload"],
            "properties": {
              "nodeId": {"type": "string", "minLength": 1},
              "pageId": {"type": "string", "minLength": 1},
              "payload": {"type": "object"}
            }
          }
        }
      }
    },
    "anchor": {
      "type": "object", "additionalProperties": false,
      "required": ["nodeId", "role", "viewport", "state", "variant", "contentCase", "properties"],
      "properties": {
        "nodeId": {"type": "string", "minLength": 1},
        "role": {"enum": ["page", "component", "state", "variant", "viewport", "token", "asset", "motion"]},
        "viewport": {"type": ["string", "null"], "minLength": 1},
        "state": {"type": ["string", "null"], "minLength": 1},
        "variant": {"type": ["string", "null"], "minLength": 1},
        "contentCase": {"type": ["string", "null"], "minLength": 1},
        "properties": {"type": "array", "uniqueItems": true, "items": {"enum": ["geometry", "layout", "appearance", "typography", "state", "variant", "viewport", "asset", "token", "motion"]}}
      }
    },
    "item": {
      "type": "object", "additionalProperties": false, "required": ["itemId", "status", "anchors"],
      "properties": {
        "itemId": {"type": "string", "pattern": "^VSI-FDBI-[0-9]{3}-[A-Z]+-[0-9]{2}$"},
        "status": {"enum": ["covered", "missing", "stale"]},
        "reason": {"type": "string", "minLength": 1},
        "anchors": {"type": "array", "items": {"$ref": "#/$defs/anchor"}}
      }
    },
    "asset": {
      "type": "object", "additionalProperties": false,
      "required": ["assetId", "nodeId", "sourcePath", "path", "format", "itemRefs"],
      "properties": {
        "assetId": {"type": "string", "pattern": "^ASSET-[A-Z0-9-]+$"},
        "nodeId": {"type": "string", "minLength": 1},
        "sourcePath": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^assets/(?!.*\\\\)(?!.*\\.\\.).+$"},
        "format": {"enum": ["svg", "png", "webp", "jpg", "woff", "woff2"]},
        "itemRefs": {"$ref": "#/$defs/itemRefs"}
      }
    },
    "token": {
      "type": "object", "additionalProperties": false,
      "required": ["tokenId", "kind", "value", "sourceNodeId", "itemRefs"],
      "properties": {
        "tokenId": {"type": "string", "pattern": "^TOKEN-[A-Z0-9-]+$"},
        "kind": {"enum": ["spacing", "typography", "paint", "effect", "radius"]},
        "value": {}, "sourceNodeId": {"type": "string", "minLength": 1}, "itemRefs": {"$ref": "#/$defs/itemRefs"}
      }
    },
    "motion": {
      "type": "object", "additionalProperties": false,
      "required": ["motionId", "sourceNodeId", "trigger", "durationMs", "easing", "interruption", "reducedMotion", "itemRefs"],
      "properties": {
        "motionId": {"type": "string", "pattern": "^MOTION-[A-Z0-9-]+$"},
        "sourceNodeId": {"type": "string", "minLength": 1},
        "trigger": {"type": "string", "minLength": 1},
        "durationMs": {"type": "integer", "minimum": 0},
        "easing": {"type": "string", "minLength": 1},
        "interruption": {"type": "string", "minLength": 1},
        "reducedMotion": {"type": "string", "minLength": 1},
        "itemRefs": {"$ref": "#/$defs/itemRefs"}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psp.dev/schemas/figma-evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "metadata", "coverageLock", "source", "assets", "tokens", "motions", "gaps"],
  "properties": {
    "schemaVersion": {"const": "psp.dev/visual-spec/v1"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "revision", "status"],
      "properties": {
        "artifactId": {"const": "FIGMA-EVIDENCE"},
        "revision": {"type": "integer", "minimum": 1},
        "status": {"enum": ["draft", "ready", "stale"]}
      }
    },
    "coverageLock": {"$ref": "#/$defs/coverageLock"},
    "source": {"$ref": "#/$defs/source"},
    "assets": {"type": "array", "items": {"$ref": "#/$defs/asset"}},
    "tokens": {"type": "array", "items": {"$ref": "#/$defs/token"}},
    "motions": {"type": "array", "items": {"$ref": "#/$defs/motion"}},
    "gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "itemRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^VSI-FDBI-[0-9]{3}-[A-Z]+-[0-9]{2}$"}
    },
    "coverageLock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "path", "revision", "digest"],
      "properties": {
        "artifactId": {"const": "FIGMA-COVERAGE"},
        "path": {"const": ".psp/visual-spec/figma-coverage.json"},
        "revision": {"type": "integer", "minimum": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "fileId", "locator", "scope", "revision", "digest", "capturedAt"],
      "properties": {
        "provider": {"const": "figma"},
        "fileId": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "pattern": "^figma://[^\\s]+$"},
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "refs"],
          "properties": {
            "kind": {"enum": ["file", "page", "node"]},
            "refs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "revision": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"},
        "capturedAt": {"type": "string", "format": "date-time"}
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "nodeId", "nodeDigest", "path", "format", "width", "height", "digest", "itemRefs"],
      "properties": {
        "assetId": {"type": "string", "pattern": "^ASSET-[A-Z0-9-]+$"},
        "nodeId": {"type": "string", "minLength": 1},
        "nodeDigest": {"$ref": "#/$defs/digest"},
        "path": {"type": "string", "pattern": "^assets/(?!.*\\\\)(?!.*\\.\\.).+$"},
        "format": {"enum": ["svg", "png", "webp", "jpg", "woff", "woff2"]},
        "width": {"type": ["integer", "null"], "minimum": 1},
        "height": {"type": ["integer", "null"], "minimum": 1},
        "digest": {"$ref": "#/$defs/digest"},
        "itemRefs": {"$ref": "#/$defs/itemRefs"}
      },
      "allOf": [
        {
          "if": {"properties": {"format": {"enum": ["svg", "png", "webp", "jpg"]}}, "required": ["format"]},
          "then": {
            "properties": {
              "width": {"type": "integer", "minimum": 1},
              "height": {"type": "integer", "minimum": 1}
            }
          }
        },
        {
          "if": {"properties": {"format": {"enum": ["woff", "woff2"]}}, "required": ["format"]},
          "then": {
            "properties": {
              "width": {"type": "null"},
              "height": {"type": "null"}
            }
          }
        }
      ]
    },
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokenId", "kind", "value", "sourceNodeId", "digest", "itemRefs"],
      "properties": {
        "tokenId": {"type": "string", "pattern": "^TOKEN-[A-Z0-9-]+$"},
        "kind": {"enum": ["spacing", "typography", "paint", "effect", "radius"]},
        "value": {},
        "sourceNodeId": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"},
        "itemRefs": {"$ref": "#/$defs/itemRefs"}
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["motionId", "sourceNodeId", "trigger", "durationMs", "easing", "interruption", "reducedMotion", "digest", "itemRefs"],
      "properties": {
        "motionId": {"type": "string", "pattern": "^MOTION-[A-Z0-9-]+$"},
        "sourceNodeId": {"type": "string", "minLength": 1},
        "trigger": {"type": "string", "minLength": 1},
        "durationMs": {"type": "integer", "minimum": 0},
        "easing": {"type": "string", "minLength": 1},
        "interruption": {"type": "string", "minLength": 1},
        "reducedMotion": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"},
        "itemRefs": {"$ref": "#/$defs/itemRefs"}
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "itemId", "dimension", "reason"],
      "properties": {
        "code": {"enum": ["FGC_ASSET_MISSING", "FGC_TOKEN_MISSING", "FGC_MOTION_MISSING", "FGC_SOURCE_STALE"]},
        "itemId": {"type": "string", "pattern": "^VSI-FDBI-[0-9]{3}-[A-Z]+-[0-9]{2}$"},
        "dimension": {"enum": ["asset", "token", "motion", "source"]},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}

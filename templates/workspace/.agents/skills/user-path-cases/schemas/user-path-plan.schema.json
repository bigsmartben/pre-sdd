{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psp.dev/schemas/user-path-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "metadata", "sourceLocks", "paths", "gaps"],
  "properties": {
    "schemaVersion": {"const": "psp.dev/visual-spec/v1"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "revision", "status"],
      "properties": {
        "artifactId": {"const": "USER-PATH-PLAN"},
        "revision": {"type": "integer", "minimum": 1},
        "status": {"enum": ["draft", "ready", "stale"]}
      }
    },
    "sourceLocks": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/sourceLock"}
    },
    "paths": {"type": "array", "items": {"$ref": "#/$defs/path"}},
    "gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}}
  },
  "$defs": {
    "sourceLock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "path", "revision", "digest"],
      "properties": {
        "artifactId": {"enum": ["TEST-CASE-CATALOG", "VISUAL-SPEC-CHECKLIST"]},
        "path": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 1},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pathId", "checklistItemRefs", "testCaseRef", "steps", "scenarioSlots"],
      "properties": {
        "pathId": {"type": "string", "pattern": "^UP-TC-[0-9]{3}$"},
        "checklistItemRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^VSI-FDBI-[0-9]{3}-[A-Z]+-[0-9]{2}$"}
        },
        "testCaseRef": {"type": "string", "pattern": "^TC-[0-9]{3}$"},
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pathStepId", "testCaseStepRef", "action", "expectedOutcome", "checkpoint", "assertion"],
            "properties": {
              "pathStepId": {"type": "string", "pattern": "^UP-TC-[0-9]{3}-STEP-[0-9]{2}$"},
              "testCaseStepRef": {"type": "string", "pattern": "^TC-[0-9]{3}-STEP-[0-9]{2}$"},
              "action": {"type": "string", "minLength": 1},
              "expectedOutcome": {"type": "string", "minLength": 1},
              "checkpoint": {"type": "string", "minLength": 1},
              "assertion": {"type": "string", "minLength": 1}
            }
          }
        },
        "scenarioSlots": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}}
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "testCaseRef", "reason"],
      "properties": {
        "code": {"type": "string", "pattern": "^UPC_[A-Z0-9_]+$"},
        "testCaseRef": {"type": ["string", "null"], "pattern": "^TC-[0-9]{3}$"},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}

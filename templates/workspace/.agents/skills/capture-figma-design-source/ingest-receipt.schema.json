{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psp.dev/adapters/figma/ingest-receipt.schema.json",
  "title": "Figma Asset Ingest Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sourceId", "sourceVersion", "capturePlan", "downloadOperation", "ingestedAt", "assets", "status"],
  "properties": {
    "version": {"const": "1.0.0"},
    "sourceId": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"},
    "sourceVersion": {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"enum": ["figma-file-version", "remote-last-modified", "node-fingerprint"]}, "value": {"type": "string", "minLength": 1}}},
    "capturePlan": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "pattern": "^design-sources/[^/]+/capture-plan\\.json$"}, "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}},
    "downloadOperation": {"type": "string", "pattern": "^figma:[a-z][a-z0-9-]*$"},
    "ingestedAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceNodeId", "path", "format", "scale", "cropBounds", "transparentPadding", "expectedDimensions", "sha256", "consumerTargets", "status"],
        "properties": {
          "sourceNodeId": {"type": "string", "pattern": "^[0-9]+:[0-9]+$"},
          "path": {"type": "string", "pattern": "^public/assets/[^/]+/[^/]+\\.(?:png|svg)$"},
          "format": {"enum": ["png", "svg"]},
          "scale": {"type": "number", "exclusiveMinimum": 0},
          "cropBounds": {"$ref": "#/$defs/bounds"},
          "transparentPadding": {"$ref": "#/$defs/padding"},
          "expectedDimensions": {"$ref": "#/$defs/dimensions"},
          "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
          "consumerTargets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"}},
          "status": {"const": "verified"}
        }
      }
    },
    "status": {"const": "PASS"}
  },
  "$defs": {
    "bounds": {"type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"], "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}}},
    "padding": {"type": "object", "additionalProperties": false, "required": ["top", "right", "bottom", "left"], "properties": {"top": {"type": "integer", "minimum": 0}, "right": {"type": "integer", "minimum": 0}, "bottom": {"type": "integer", "minimum": 0}, "left": {"type": "integer", "minimum": 0}}},
    "dimensions": {"type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": {"width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psp.dev/schemas/artifacts/interactions.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "siteMap", "wireflows", "screens", "interactionStates", "gates", "gaps"],
  "properties": {
    "apiVersion": {"const": "psp.dev/v1"},
    "kind": {"const": "WireflowMidSpecification"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "siteMap": {"$ref": "#/$defs/siteMap"},
    "wireflows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "useCase", "name", "coveredScenarios", "entry", "completionStates", "steps"],
        "properties": {
          "id": {"$ref": "#/$defs/wireflowId"},
          "useCase": {"$ref": "#/$defs/useCaseId"},
          "name": {"type": "string", "minLength": 1},
          "coveredScenarios": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"oneOf": [{"const": "main"}, {"$ref": "#/$defs/useCaseScenarioId"}]}
          },
          "entry": {"$ref": "#/$defs/endpoint"},
          "completionStates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/stateId"}
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/wireflowStep"}
          }
        }
      }
    },
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "purpose", "useCases", "layoutTree", "regions"],
        "properties": {
          "id": {"$ref": "#/$defs/screenId"},
          "name": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "useCases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/useCaseId"}},
          "layoutTree": {"$ref": "#/$defs/layoutContainer"},
          "regions": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/region"}
          }
        }
      }
    },
    "interactionStates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "screen", "type", "condition", "stateDelta", "terminal"],
        "properties": {
          "id": {"$ref": "#/$defs/stateId"},
          "screen": {"$ref": "#/$defs/screenId"},
          "type": {"enum": ["default", "loading", "empty", "error", "success", "validation", "disabled"]},
          "condition": {"type": "string", "minLength": 1},
          "stateDelta": {"$ref": "#/$defs/stateDelta"},
          "terminal": {"type": "boolean"}
        }
      }
    },
    "gates": {"$ref": "#/$defs/gates"},
    "gaps": {"$ref": "#/$defs/gaps"}
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "version", "upstreamArtifact", "actor"],
      "properties": {
        "status": {"enum": ["draft", "ready"]},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "upstreamArtifact": {"const": "capabilities"},
        "actor": {"$ref": "#/$defs/actorId"}
      }
    },
    "nullableText": {"type": ["string", "null"], "minLength": 1},
    "actorId": {"type": "string", "pattern": "^ACTOR-[0-9]{3}$"},
    "useCaseId": {"type": "string", "pattern": "^UC-[0-9]{3}$"},
    "useCaseScenarioId": {"type": "string", "pattern": "^UC-[0-9]{3}-(ALT|EXC)-[0-9]{2}$"},
    "useCaseStepId": {"type": "string", "pattern": "^UC-[0-9]{3}(-(ALT|EXC)-[0-9]{2})?-STEP-[0-9]{2}$"},
    "wireflowId": {"type": "string", "pattern": "^WF-[0-9]{3}$"},
    "wireflowStepId": {"type": "string", "pattern": "^WF-[0-9]{3}-STEP-[0-9]{2}$"},
    "screenId": {"type": "string", "pattern": "^SCREEN-[0-9]{3}$"},
    "regionId": {"type": "string", "pattern": "^REGION-[0-9]{3}$"},
    "controlId": {"type": "string", "pattern": "^CONTROL-[0-9]{3}$"},
    "stateId": {"type": "string", "pattern": "^WF-STATE-[0-9]{3}$"},
    "regionOrControlId": {
      "oneOf": [{"$ref": "#/$defs/regionId"}, {"$ref": "#/$defs/controlId"}]
    },
    "siteMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entryScreen", "nodes"],
      "properties": {
        "entryScreen": {"oneOf": [{"$ref": "#/$defs/screenId"}, {"type": "null"}]},
        "nodes": {
          "type": "array",
          "items": {"$ref": "#/$defs/siteMapNode"}
        }
      }
    },
    "siteMapNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["screen", "parent"],
      "properties": {
        "screen": {"$ref": "#/$defs/screenId"},
        "parent": {"oneOf": [{"$ref": "#/$defs/screenId"}, {"type": "null"}]}
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["screen", "state"],
      "properties": {
        "screen": {"$ref": "#/$defs/screenId"},
        "state": {"$ref": "#/$defs/stateId"}
      }
    },
    "layoutContainer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "children"],
      "properties": {
        "type": {"enum": ["vertical", "horizontal"]},
        "children": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/layoutNode"}
        }
      }
    },
    "layoutRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "region"],
      "properties": {
        "type": {"const": "region"},
        "region": {"$ref": "#/$defs/regionId"}
      }
    },
    "layoutNode": {
      "oneOf": [
        {"$ref": "#/$defs/layoutContainer"},
        {"$ref": "#/$defs/layoutRegion"}
      ]
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "label", "purpose", "dataBinding", "action"],
      "properties": {
        "id": {"$ref": "#/$defs/controlId"},
        "type": {"enum": ["display", "input", "action", "navigation", "selection"]},
        "label": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "dataBinding": {"$ref": "#/$defs/nullableText"},
        "action": {"$ref": "#/$defs/nullableText"}
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "purpose", "content", "controls"],
      "properties": {
        "id": {"$ref": "#/$defs/regionId"},
        "name": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "content": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "controls": {"type": "array", "items": {"$ref": "#/$defs/control"}}
      }
    },
    "contentChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "value"],
      "properties": {
        "target": {"$ref": "#/$defs/regionOrControlId"},
        "value": {"type": "string", "minLength": 1}
      }
    },
    "stateDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["show", "hide", "enable", "disable", "content"],
      "properties": {
        "show": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/regionOrControlId"}},
        "hide": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/regionOrControlId"}},
        "enable": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/controlId"}},
        "disable": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/controlId"}},
        "content": {"type": "array", "items": {"$ref": "#/$defs/contentChange"}}
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "control"],
      "properties": {
        "event": {"type": "string", "minLength": 1},
        "control": {"oneOf": [{"$ref": "#/$defs/controlId"}, {"type": "null"}]}
      }
    },
    "wireflowStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scenarioRef", "useCaseStepRefs", "from", "trigger", "guard", "branchLabel", "to"],
      "allOf": [
        {
          "if": {"properties": {"guard": {"type": "string"}}, "required": ["guard"]},
          "then": {"properties": {"branchLabel": {"type": "string"}}}
        }
      ],
      "properties": {
        "id": {"$ref": "#/$defs/wireflowStepId"},
        "scenarioRef": {"oneOf": [{"const": "main"}, {"$ref": "#/$defs/useCaseScenarioId"}]},
        "useCaseStepRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/useCaseStepId"}
        },
        "from": {"$ref": "#/$defs/endpoint"},
        "trigger": {"$ref": "#/$defs/trigger"},
        "guard": {"$ref": "#/$defs/nullableText"},
        "branchLabel": {"$ref": "#/$defs/nullableBranchLabel"},
        "to": {"$ref": "#/$defs/endpoint"}
      }
    },
    "nullableBranchLabel": {
      "oneOf": [
        {"type": "string", "minLength": 1, "maxLength": 20},
        {"type": "null"}
      ]
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "checked"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "label": {"type": "string", "minLength": 1},
        "checked": {"type": "boolean"}
      }
    },
    "gates": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/gate"},
      "allOf": [
        {"contains": {"type": "object", "required": ["id"], "properties": {"id": {"const": "sitemap-complete"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "required": ["id"], "properties": {"id": {"const": "upstream-valid"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "required": ["id"], "properties": {"id": {"const": "scenarios-covered"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "required": ["id"], "properties": {"id": {"const": "upstream-step-traceable"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "required": ["id"], "properties": {"id": {"const": "user-flow-generated"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "required": ["id"], "properties": {"id": {"const": "layout-tree-complete"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "required": ["id"], "properties": {"id": {"const": "wireframe-generated"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "required": ["id"], "properties": {"id": {"const": "control-placement-complete"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "required": ["id"], "properties": {"id": {"const": "state-delta-complete"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "required": ["id"], "properties": {"id": {"const": "transition-integrity"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "required": ["id"], "properties": {"id": {"const": "control-availability-valid"}}}, "minContains": 1, "maxContains": 1}
      ]
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "field", "reason"],
      "properties": {
        "id": {"type": "string", "pattern": "^GAP-[0-9]{3}$"},
        "field": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psp.dev/schemas/artifacts/product-package.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "overview", "primaryChain", "supportingArtifacts", "gates", "gaps"],
  "properties": {
    "apiVersion": {"const": "psp.dev/v1"},
    "kind": {"const": "ProductPackage"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "overview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productName", "productGoal", "targetUsers", "coreValue"],
      "properties": {
        "productName": {"$ref": "#/$defs/nullableText"},
        "productGoal": {"$ref": "#/$defs/nullableText"},
        "targetUsers": {"$ref": "#/$defs/nullableText"},
        "coreValue": {"$ref": "#/$defs/nullableText"}
      }
    },
    "primaryChain": {"const": ["capabilities", "interactions", "canonical-ui-prototype"]},
    "supportingArtifacts": {"const": []},
    "gates": {"$ref": "#/$defs/gates"},
    "gaps": {"$ref": "#/$defs/gaps"}
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "version"],
      "properties": {
        "status": {"enum": ["draft", "ready"]},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "nullableText": {"type": ["string", "null"], "minLength": 1},
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "checked"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "label": {"type": "string", "minLength": 1},
        "checked": {"type": "boolean"}
      }
    },
    "gates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/gate"}},
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "field", "reason"],
      "properties": {
        "id": {"type": "string", "pattern": "^GAP-[0-9]{3}$"},
        "field": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psp.dev/domains/product-design/canonical-ui-review-feedback-packet.schema.json",
  "title": "Canonical UI Review Feedback Packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kind", "createdAt", "actor", "draftVersion", "pageUrl", "pageKey", "viewport", "markers"],
  "properties": {
    "version": {"const": "1.0.0"},
    "kind": {"const": "CanonicalUiReviewFeedbackPacket"},
    "createdAt": {"type": "string", "format": "date-time"},
    "actor": {"type": "string", "pattern": "^ACTOR-[0-9]{3}$"},
    "draftVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "pageUrl": {"type": "string", "pattern": "^http://(?:127\\.0\\.0\\.1|localhost):[0-9]+/"},
    "pageKey": {"type": "string", "minLength": 1},
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "markers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/marker"}}
  },
  "$defs": {
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "number", "minimum": 0},
        "y": {"type": "number", "minimum": 0},
        "width": {"type": "number", "exclusiveMinimum": 0},
        "height": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "marker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "issueType", "category", "routedTo", "description", "target", "rect"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "issueType": {"enum": ["position-size", "text", "interaction", "visual"]},
        "category": {"enum": ["behavior", "visual-input", "implementation"]},
        "routedTo": {"enum": ["use-cases", "visual-spec", "canonical-ui-prototype"]},
        "description": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "rect": {"$ref": "#/$defs/rect"}
      },
      "allOf": [
        {
          "if": {"properties": {"issueType": {"const": "interaction"}}, "required": ["issueType"]},
          "then": {"properties": {"category": {"const": "behavior"}, "routedTo": {"const": "use-cases"}}}
        },
        {
          "if": {"properties": {"issueType": {"const": "visual"}}, "required": ["issueType"]},
          "then": {"properties": {"category": {"const": "visual-input"}, "routedTo": {"const": "visual-spec"}}}
        },
        {
          "if": {"properties": {"issueType": {"enum": ["position-size", "text"]}}, "required": ["issueType"]},
          "then": {"properties": {"category": {"const": "implementation"}, "routedTo": {"const": "canonical-ui-prototype"}}}
        }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psp.dev/domains/product-design/canonical-ui-repair-action-report.schema.json",
  "title": "Canonical UI Repair Action Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "status", "actor", "repairSessionId", "completedAt", "attempts", "resolvedFailures", "validationGates"],
  "properties": {
    "version": {"const": "2.0.0"},
    "status": {"const": "PASS"},
    "actor": {"type": "string", "pattern": "^ACTOR-[0-9]{3}$"},
    "repairSessionId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "completedAt": {"type": "string", "format": "date-time"},
    "attempts": {"const": 1},
    "resolvedFailures": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "https://psp.dev/domains/product-design/canonical-ui-repair-packet.schema.json#/$defs/failure"}
    },
    "validationGates": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gateId", "status"],
        "properties": {
          "gateId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "status": {"const": "PASS"},
          "evidence": {"type": "array", "items": {"type": "object"}}
        }
      }
    }
  }
}

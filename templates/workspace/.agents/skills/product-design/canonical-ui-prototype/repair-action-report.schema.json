{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psp.dev/domains/product-design/canonical-ui-repair-action-report.schema.json",
  "title": "Canonical UI Repair Action Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "status", "actor", "completedAt", "attempts", "resolvedFailures", "validationEvidence"],
  "properties": {
    "version": {"const": "1.0.0"},
    "status": {"const": "PASS"},
    "actor": {"type": "string", "pattern": "^ACTOR-[0-9]{3}$"},
    "completedAt": {"type": "string", "format": "date-time"},
    "attempts": {"type": "integer", "minimum": 1, "maximum": 3},
    "resolvedFailures": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "validationEvidence": {"type": "array", "items": {"type": "object"}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psp.dev/domains/product-design/canonical-ui-prototype.schema.json",
  "title": "Canonical UI Prototype Semantic Model",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "actor", "draft", "visualPolicy", "reviewTools", "repairPolicy", "designSources", "assets", "tokens", "routes", "screens", "components",
    "componentInventory", "componentMappings", "componentVariantDefinitions", "componentVariantCoverage", "componentContracts", "stateAxes", "stateMatrix",
    "controls", "states", "events", "actions", "scenarios", "viewports",
    "renderAssertions", "sourceParityAssertions", "componentSourceParityAssertions", "motions", "traceability", "gaps"
  ],
  "properties": {
    "version": {"const": "11.0.0"},
    "actor": {"type": "string", "pattern": "^ACTOR-[0-9]{3}$"},
    "draft": {"$ref": "#/$defs/draft"},
    "visualPolicy": {"$ref": "#/$defs/visualPolicy"},
    "reviewTools": {"$ref": "#/$defs/reviewTools"},
    "repairPolicy": {"$ref": "#/$defs/repairPolicy"},
    "designSources": {"type": "array", "items": {"$ref": "#/$defs/designSource"}},
    "assets": {"type": "array", "items": {"$ref": "#/$defs/asset"}},
    "tokens": {"type": "array", "items": {"$ref": "#/$defs/token"}},
    "routes": {"type": "array", "items": {"$ref": "#/$defs/route"}},
    "screens": {"type": "array", "items": {"$ref": "#/$defs/screen"}},
    "components": {"type": "array", "items": {"$ref": "#/$defs/component"}},
    "componentInventory": {"type": "array", "items": {"$ref": "#/$defs/componentInventoryItem"}},
    "componentMappings": {"type": "array", "items": {"$ref": "#/$defs/componentMapping"}},
    "componentVariantDefinitions": {"type": "array", "items": {"$ref": "#/$defs/componentVariantDefinition"}},
    "componentVariantCoverage": {"type": "array", "items": {"$ref": "#/$defs/componentVariantCoverage"}},
    "componentContracts": {"type": "array", "items": {"$ref": "#/$defs/componentContract"}},
    "stateAxes": {"type": "array", "items": {"$ref": "#/$defs/stateAxis"}},
    "stateMatrix": {"type": "array", "items": {"$ref": "#/$defs/stateMatrixEntry"}},
    "controls": {"type": "array", "items": {"$ref": "#/$defs/control"}},
    "states": {"type": "array", "items": {"$ref": "#/$defs/state"}},
    "events": {"type": "array", "items": {"$ref": "#/$defs/event"}},
    "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}},
    "scenarios": {"type": "array", "items": {"$ref": "#/$defs/scenario"}},
    "viewports": {"type": "array", "items": {"$ref": "#/$defs/viewport"}},
    "renderAssertions": {"type": "array", "items": {"$ref": "#/$defs/renderAssertion"}},
    "sourceParityAssertions": {"type": "array", "items": {"$ref": "#/$defs/sourceParityAssertion"}},
    "componentSourceParityAssertions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/componentSourceParityAssertion"}
    },
    "motions": {"type": "array", "items": {"$ref": "#/$defs/motion"}},
    "accessibility": {"$ref": "#/$defs/accessibility"},
    "traceability": {"type": "array", "items": {"$ref": "#/$defs/trace"}},
    "gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"},
    "ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "nonEmptyIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "nodeId": {"type": "string", "pattern": "^[0-9]+:[0-9]+$"},
    "nodeIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nodeId"}},
    "litName": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "litPropertyName": {"type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"},
    "litBindingName": {"type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$-]*$"},
    "litTagName": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
    "figmaLocation": {"type": "string", "pattern": "^https://(?:www\\.)?figma\\.com/design/[^/?#]+/[^?#]+\\?[^#]*node-id=[0-9]+[-:][0-9]+(?:&[^#]*)?$"},
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "sourceVersion": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "figma-file-version"}, "value": {"type": "string", "minLength": 1}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "remote-last-modified"}, "value": {"$ref": "#/$defs/timestamp"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "node-fingerprint"}, "value": {"$ref": "#/$defs/sha256"}}}
      ]
    },
    "bounds": {"type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"], "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}}},
    "padding": {"type": "object", "additionalProperties": false, "required": ["top", "right", "bottom", "left"], "properties": {"top": {"type": "integer", "minimum": 0}, "right": {"type": "integer", "minimum": 0}, "bottom": {"type": "integer", "minimum": 0}, "left": {"type": "integer", "minimum": 0}}},
    "dimensions": {"type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": {"width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}},
    "inputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "contentHash"],
      "properties": {
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "contentHash": {"$ref": "#/$defs/sha256"}
      }
    },
    "draft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "inputs"],
      "properties": {
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["useCases", "visualSpec"],
          "properties": {
            "useCases": {"$ref": "#/$defs/inputBinding"},
            "visualSpec": {"$ref": "#/$defs/inputBinding"}
          }
        }
      }
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "visualAspect": {"enum": ["layout", "dimensions", "typography", "color", "spacing", "shape", "shadow", "assets", "visual-hierarchy"]},
    "visualCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "screenId", "stateIds", "viewportIds", "evidenceItemIds"],
      "properties": {
        "sourceId": {"$ref": "#/$defs/id"},
        "screenId": {"$ref": "#/$defs/id"},
        "stateIds": {"$ref": "#/$defs/nonEmptyIds"},
        "viewportIds": {"$ref": "#/$defs/nonEmptyIds"},
        "evidenceItemIds": {"$ref": "#/$defs/nonEmptyIds"}
      }
    },
    "visualPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "selectedBy", "aspects", "coverage"],
      "properties": {
        "mode": {"enum": ["unresolved", "autonomous", "guided", "exact"]},
        "selectedBy": {"enum": ["user-explicit", "default-policy"]},
        "aspects": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/visualAspect"}},
        "coverage": {"type": "array", "items": {"$ref": "#/$defs/visualCoverage"}}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"enum": ["unresolved", "autonomous"]}}, "required": ["mode"]},
          "then": {"properties": {"aspects": {"type": "array", "maxItems": 0}, "coverage": {"type": "array", "maxItems": 0}}}
        },
        {
          "if": {"properties": {"mode": {"enum": ["guided", "exact"]}}, "required": ["mode"]},
          "then": {"properties": {"aspects": {"type": "array", "minItems": 1}, "coverage": {"type": "array", "minItems": 1}}}
        },
        {
          "if": {"properties": {"mode": {"const": "exact"}}, "required": ["mode"]},
          "then": {
            "properties": {
              "aspects": {
                "type": "array",
                "allOf": [
                  {"minItems": 9},
                  {"contains": {"const": "layout"}},
                  {"contains": {"const": "dimensions"}},
                  {"contains": {"const": "typography"}},
                  {"contains": {"const": "color"}},
                  {"contains": {"const": "spacing"}},
                  {"contains": {"const": "shape"}},
                  {"contains": {"const": "shadow"}},
                  {"contains": {"const": "assets"}},
                  {"contains": {"const": "visual-hierarchy"}}
                ]
              }
            }
          }
        }
      ]
    },
    "reviewTools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activation", "boundary", "tools"],
      "properties": {
        "activation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["queryParameter", "enabledValue"],
          "properties": {
            "queryParameter": {"const": "review"},
            "enabledValue": {"const": "1"}
          }
        },
        "boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["classification", "excludedProductScopes", "protectedProductFacts"],
          "properties": {
            "classification": {"const": "review-only"},
            "excludedProductScopes": {
              "type": "array",
              "uniqueItems": true,
              "minItems": 5,
              "maxItems": 5,
              "items": {
                "enum": ["requirements", "features", "pages", "controls", "downstream-implementation"]
              },
              "allOf": [
                {"contains": {"const": "requirements"}},
                {"contains": {"const": "features"}},
                {"contains": {"const": "pages"}},
                {"contains": {"const": "controls"}},
                {"contains": {"const": "downstream-implementation"}}
              ]
            },
            "protectedProductFacts": {
              "type": "array",
              "uniqueItems": true,
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "enum": ["use-cases", "interaction-flows", "visual-spec"]
              },
              "allOf": [
                {"contains": {"const": "use-cases"}},
                {"contains": {"const": "interaction-flows"}},
                {"contains": {"const": "visual-spec"}}
              ]
            }
          }
        },
        "tools": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "delivery"],
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "kind": {
                "enum": ["inconsistency-annotator", "mockcase-switcher", "interaction-branch-driver"]
              },
              "delivery": {"enum": ["built-in", "review-extension"]}
            }
          },
          "allOf": [
            {"contains": {"type": "object", "properties": {"kind": {"const": "inconsistency-annotator"}, "delivery": {"const": "built-in"}}, "required": ["kind", "delivery"]}},
            {"contains": {"type": "object", "properties": {"kind": {"const": "mockcase-switcher"}, "delivery": {"const": "review-extension"}}, "required": ["kind", "delivery"]}},
            {"contains": {"type": "object", "properties": {"kind": {"const": "interaction-branch-driver"}, "delivery": {"const": "built-in"}}, "required": ["kind", "delivery"]}}
          ]
        }
      }
    },
    "repairPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedImplementationPaths"],
      "properties": {
        "allowedImplementationPaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:index\\.html|src/(?:main\\.ts|psp-app\\.ts|product-router\\.ts|state-gallery\\.ts|matrix-mount\\.ts|[^/]+\\.css|components/.+\\.(?:ts|css)|pages/.+\\.(?:ts|css)|styles/.+\\.css))$"
          }
        }
      }
    },
    "sourceCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["screenId", "stateIds", "viewportIds", "evidenceItemIds"],
      "properties": {
        "screenId": {"$ref": "#/$defs/id"},
        "stateIds": {"$ref": "#/$defs/nonEmptyIds"},
        "viewportIds": {"$ref": "#/$defs/nonEmptyIds"},
        "evidenceItemIds": {"$ref": "#/$defs/nonEmptyIds"}
      }
    },
    "designSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "location", "status", "capturedAt", "evidence", "registration", "coverage"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["figma", "screenshot", "export", "other"]},
        "location": {"type": "string", "minLength": 1},
        "status": {"enum": ["available", "partial", "blocked"]},
        "capturedAt": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
        "evidence": {"oneOf": [{"$ref": "#/$defs/evidenceReference"}, {"type": "null"}]},
        "registration": {"oneOf": [{"$ref": "#/$defs/evidenceReference"}, {"type": "null"}]},
        "coverage": {"type": "array", "items": {"$ref": "#/$defs/sourceCoverage"}}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "figma"}}, "required": ["kind"]},
          "then": {
            "properties": {
              "location": {"$ref": "#/$defs/figmaLocation"}
            }
          },
          "else": {
            "properties": {
              "registration": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"status": {"enum": ["available", "partial"]}}, "required": ["status"]},
          "then": {
            "properties": {
              "capturedAt": {"$ref": "#/$defs/timestamp"},
              "evidence": {"$ref": "#/$defs/evidenceReference"},
              "coverage": {"type": "array", "minItems": 1}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "blocked"}}, "required": ["status"]},
          "then": {
            "properties": {
              "capturedAt": {"type": "null"},
              "evidence": {"type": "null"},
              "registration": {"type": "null"},
              "coverage": {"type": "array", "maxItems": 0}
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {"const": "figma"},
              "status": {"enum": ["available", "partial"]}
            },
            "required": ["kind", "status"]
          },
          "then": {
            "properties": {
              "registration": {"$ref": "#/$defs/evidenceReference"}
            }
          }
        }
      ]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "kind", "sourceIds", "sha256", "consumerTargets", "status"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "path": {"type": "string", "pattern": "^public/(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+"},
        "kind": {"enum": ["image", "icon", "font", "other"]},
        "sourceIds": {"$ref": "#/$defs/ids"},
        "sourceNodeId": {"$ref": "#/$defs/nodeId"},
        "sourceVersion": {"$ref": "#/$defs/sourceVersion"},
        "strategy": {"const": "asset"},
        "format": {"enum": ["png", "svg"]},
        "scale": {"type": "number", "exclusiveMinimum": 0},
        "cropBounds": {"$ref": "#/$defs/bounds"},
        "transparentPadding": {"$ref": "#/$defs/padding"},
        "expectedDimensions": {"$ref": "#/$defs/dimensions"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "downloadOperation": {"type": "string", "pattern": "^figma:[a-z][a-z0-9-]*$"},
        "consumerTargets": {"$ref": "#/$defs/nonEmptyIds"},
        "status": {"enum": ["pending", "verified", "blocked"]},
        "alt": {"type": "string"},
        "fontFamily": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "font"}}, "required": ["kind"]},
          "then": {"properties": {"fontFamily": {}}, "required": ["fontFamily"]},
          "else": {
            "properties": {
              "sourceNodeId": {},
              "sourceVersion": {},
              "strategy": {},
              "format": {},
              "scale": {},
              "cropBounds": {},
              "transparentPadding": {},
              "expectedDimensions": {},
              "downloadOperation": {}
            },
            "required": ["sourceNodeId", "sourceVersion", "strategy", "format", "scale", "cropBounds", "transparentPadding", "expectedDimensions", "downloadOperation"]
          }
        }
      ]
    },
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "value", "sourceIds", "targetIds", "cssProperty"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"enum": ["color", "spacing", "typography", "radius", "shadow", "motion", "other"]},
        "value": {"type": ["string", "number"]},
        "sourceIds": {"$ref": "#/$defs/ids"},
        "targetIds": {"$ref": "#/$defs/nonEmptyIds"},
        "cssProperty": {"type": "string", "pattern": "^--[a-z0-9-]+$"}
      }
    },
    "route": {"type": "object", "additionalProperties": false, "required": ["id", "path", "screenId"], "properties": {"id": {"$ref": "#/$defs/id"}, "path": {"type": "string", "pattern": "^/"}, "screenId": {"$ref": "#/$defs/id"}}},
    "screen": {"type": "object", "additionalProperties": false, "required": ["id", "title", "routeId", "stateIds", "componentIds"], "properties": {"id": {"$ref": "#/$defs/id"}, "title": {"type": "string", "minLength": 1}, "routeId": {"$ref": "#/$defs/id"}, "stateIds": {"$ref": "#/$defs/ids"}, "componentIds": {"$ref": "#/$defs/ids"}}},
    "component": {"type": "object", "additionalProperties": false, "required": ["id", "name", "controlIds", "stateIds"], "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1}, "controlIds": {"$ref": "#/$defs/ids"}, "stateIds": {"$ref": "#/$defs/ids"}}},
    "componentInventoryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceId", "nodeIds", "semanticRole", "structureSignatures", "decision", "rationale"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "sourceId": {"$ref": "#/$defs/id"},
        "nodeIds": {"$ref": "#/$defs/nodeIds"},
        "semanticRole": {"type": "string", "minLength": 1},
        "structureSignatures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "decision": {"enum": ["shared-component", "primitive-only", "local-structure"]},
        "rationale": {"type": "string", "minLength": 1},
        "componentId": {"$ref": "#/$defs/id"}
      },
      "allOf": [
        {
          "if": {"properties": {"decision": {"const": "shared-component"}}, "required": ["decision"]},
          "then": {"properties": {"componentId": {}}, "required": ["componentId"]},
          "else": {"not": {"required": ["componentId"]}}
        }
      ]
    },
    "componentPropertyValueMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["figmaValue", "litValue"],
      "properties": {
        "figmaValue": {"type": "string", "minLength": 1},
        "litValue": {"type": "string", "minLength": 1}
      }
    },
    "componentPropertyMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "figmaProperty", "litProperty", "litAttribute", "values"],
      "properties": {
        "kind": {"enum": ["variant", "text", "boolean", "instance-swap"]},
        "figmaProperty": {"type": "string", "minLength": 1},
        "litProperty": {"$ref": "#/$defs/litPropertyName"},
        "litAttribute": {
          "oneOf": [
            {"$ref": "#/$defs/litName"},
            {"type": "null"}
          ]
        },
        "values": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/componentPropertyValueMapping"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "variant"}}, "required": ["kind"]},
          "then": {
            "properties": {
              "litAttribute": {"$ref": "#/$defs/litName"},
              "values": {"type": "array", "minItems": 1}
            }
          }
        }
      ]
    },
    "componentSlotMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["figmaProperty", "litSlot"],
      "properties": {
        "figmaProperty": {"type": "string", "minLength": 1},
        "litSlot": {"$ref": "#/$defs/litName"}
      }
    },
    "componentMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "componentId",
        "sourceId",
        "inventoryId",
        "figmaComponentNodeId",
        "litTagName",
        "propertyMappings",
        "slotMappings",
        "eventIds"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "componentId": {"$ref": "#/$defs/id"},
        "sourceId": {"$ref": "#/$defs/id"},
        "inventoryId": {"$ref": "#/$defs/id"},
        "figmaComponentNodeId": {"$ref": "#/$defs/nodeId"},
        "litTagName": {"$ref": "#/$defs/litTagName"},
        "propertyMappings": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/componentPropertyMapping"}
        },
        "slotMappings": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/componentSlotMapping"}
        },
        "eventIds": {"$ref": "#/$defs/ids"}
      }
    },
    "litVariantAttributes": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/litName"},
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "figmaVariantProperties": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "componentVariantDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mappingId",
        "figmaComponentNodeId",
        "figmaVariantProperties",
        "litVariantAttributes"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "mappingId": {"$ref": "#/$defs/id"},
        "figmaComponentNodeId": {"$ref": "#/$defs/nodeId"},
        "figmaVariantProperties": {"$ref": "#/$defs/figmaVariantProperties"},
        "litVariantAttributes": {"$ref": "#/$defs/litVariantAttributes"}
      }
    },
    "componentVariantUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instanceNodeId", "screenId"],
      "properties": {
        "instanceNodeId": {"$ref": "#/$defs/nodeId"},
        "screenId": {"$ref": "#/$defs/id"}
      }
    },
    "componentVariantCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mappingId",
        "definitionId",
        "litSlotNames",
        "usages"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "mappingId": {"$ref": "#/$defs/id"},
        "definitionId": {"$ref": "#/$defs/id"},
        "litSlotNames": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/litName"}
        },
        "usages": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/componentVariantUsage"}
        }
      }
    },
    "componentContractProperty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "required"],
      "properties": {
        "name": {"$ref": "#/$defs/litPropertyName"},
        "type": {"enum": ["string", "boolean", "number", "object"]},
        "required": {"type": "boolean"},
        "defaultValue": {}
      }
    },
    "componentContractAttribute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "propertyName"],
      "properties": {
        "name": {"$ref": "#/$defs/litName"},
        "propertyName": {"$ref": "#/$defs/litPropertyName"}
      }
    },
    "componentPageInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "screenId", "origin"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "screenId": {"$ref": "#/$defs/id"},
        "origin": {"enum": ["figma", "local"]},
        "figmaInstanceNodeId": {"$ref": "#/$defs/nodeId"}
      },
      "allOf": [
        {
          "if": {"properties": {"origin": {"const": "figma"}}, "required": ["origin"]},
          "then": {"properties": {"figmaInstanceNodeId": {"$ref": "#/$defs/nodeId"}}, "required": ["figmaInstanceNodeId"]},
          "else": {"properties": {"figmaInstanceNodeId": false}}
        }
      ]
    },
    "stateAxisCoverageItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "status"],
      "properties": {
        "kind": {"enum": ["variant", "runtime-state", "interaction-state", "content-override"]},
        "status": {"enum": ["modeled", "not-applicable"]},
        "reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "not-applicable"}}, "required": ["status"]},
          "then": {"properties": {"reason": {"type": "string", "minLength": 1}}, "required": ["reason"]},
          "else": {"properties": {"reason": false}}
        }
      ]
    },
    "componentContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "componentId", "implementationRole", "figmaInstanceNodeIds", "litTagName", "slots",
        "properties", "attributes", "eventIds", "stateAxisCoverage", "defaultStateMatrixEntryId", "pageInstances", "implementationPaths", "testAssertions"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "componentId": {"$ref": "#/$defs/id"},
        "implementationRole": {"enum": ["app-shell", "feature-shell", "shared-component", "layout-primitive", "page-local"]},
        "mappingId": {"$ref": "#/$defs/id"},
        "figmaInstanceNodeIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nodeId"}},
        "litTagName": {"$ref": "#/$defs/litTagName"},
        "slots": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/litName"}},
        "properties": {"type": "array", "items": {"$ref": "#/$defs/componentContractProperty"}},
        "attributes": {"type": "array", "items": {"$ref": "#/$defs/componentContractAttribute"}},
        "eventIds": {"$ref": "#/$defs/ids"},
        "stateAxisCoverage": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stateAxisCoverageItem"},
          "allOf": [
            {"contains": {"type": "object", "properties": {"kind": {"const": "variant"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"type": "object", "properties": {"kind": {"const": "runtime-state"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"type": "object", "properties": {"kind": {"const": "interaction-state"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"type": "object", "properties": {"kind": {"const": "content-override"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1}
          ]
        },
        "defaultStateMatrixEntryId": {"$ref": "#/$defs/id"},
        "pageInstances": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/componentPageInstance"}},
        "implementationPaths": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^src/(?:[a-z0-9-]+|components/[a-z0-9-]+)\\.(?:ts|css)$"}
        },
        "testAssertions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/componentContractAssertion"}}
      }
    },
    "componentContractAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "targetId"],
      "properties": {
        "kind": {"enum": ["accessible-name", "focusable", "disabled", "aria"]},
        "targetId": {"$ref": "#/$defs/id"},
        "stateMatrixEntryId": {"$ref": "#/$defs/id"},
        "attribute": {"type": "string", "pattern": "^aria-[a-z-]+$"},
        "expected": {"type": ["string", "boolean"]}
      }
    },
    "stateAxisValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "value"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "value": {"type": "string", "minLength": 1},
        "stateId": {"$ref": "#/$defs/id"},
        "renderValue": {}
      }
    },
    "stateAxisRenderBinding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {"kind": {"const": "mapped-variant"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": {"const": "component-state"},
            "name": {"$ref": "#/$defs/litPropertyName"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {"kind": {"const": "workflow-state"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": {"enum": ["lit-property", "lit-attribute", "slot-text"]},
            "name": {"$ref": "#/$defs/litBindingName"}
          }
        }
      ]
    },
    "stateAxis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "componentContractId", "kind", "name", "renderBinding", "values"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "componentContractId": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["variant", "runtime-state", "interaction-state", "content-override"]},
        "name": {"type": "string", "minLength": 1},
        "renderBinding": {"$ref": "#/$defs/stateAxisRenderBinding"},
        "values": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stateAxisValue"}}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "variant"}}, "required": ["kind"]},
          "then": {"properties": {"renderBinding": {"type": "object", "properties": {"kind": {"const": "mapped-variant"}}, "required": ["kind"]}}}
        },
        {
          "if": {"properties": {"kind": {"const": "runtime-state"}}, "required": ["kind"]},
          "then": {
            "properties": {
              "renderBinding": {
                "type": "object",
                "properties": {
                  "kind": {"const": "component-state"},
                  "name": {"$ref": "#/$defs/litPropertyName"}
                },
                "required": ["kind", "name"]
              },
              "values": {
                "type": "array",
                "items": {
                  "allOf": [
                    {"$ref": "#/$defs/stateAxisValue"},
                    {"type": "object", "properties": {"renderValue": {}}, "required": ["renderValue"]}
                  ]
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "interaction-state"}}, "required": ["kind"]},
          "then": {"properties": {"renderBinding": {"type": "object", "properties": {"kind": {"const": "workflow-state"}}, "required": ["kind"]}}}
        },
        {
          "if": {"properties": {"kind": {"const": "content-override"}}, "required": ["kind"]},
          "then": {
            "properties": {
              "renderBinding": {
                "type": "object",
                "properties": {
                  "kind": {"enum": ["lit-property", "lit-attribute", "slot-text"]},
                  "name": {"$ref": "#/$defs/litBindingName"}
                },
                "required": ["kind", "name"]
              },
              "values": {
                "type": "array",
                "items": {
                  "allOf": [
                    {"$ref": "#/$defs/stateAxisValue"},
                    {"type": "object", "properties": {"renderValue": {}}, "required": ["renderValue"]}
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "stateMatrixValues": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {"$ref": "#/$defs/id"}
    },
    "stateMatrixEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "componentContractId", "values", "classification", "renderInGallery"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "componentContractId": {"$ref": "#/$defs/id"},
        "values": {"$ref": "#/$defs/stateMatrixValues"},
        "classification": {"enum": ["legal", "mutually-exclusive", "unreachable"]},
        "renderInGallery": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"classification": {"const": "legal"}}, "required": ["classification"]},
          "then": {"properties": {"renderInGallery": {"const": true}}},
          "else": {"properties": {"renderInGallery": {"const": false}, "reason": {"type": "string", "minLength": 1}}, "required": ["reason"]}
        }
      ]
    },
    "control": {"type": "object", "additionalProperties": false, "required": ["id", "componentId", "label"], "properties": {"id": {"$ref": "#/$defs/id"}, "componentId": {"$ref": "#/$defs/id"}, "label": {"type": "string", "minLength": 1}}},
    "state": {"type": "object", "additionalProperties": false, "required": ["id", "scope", "ownerId", "label"], "properties": {"id": {"$ref": "#/$defs/id"}, "scope": {"enum": ["workflow", "component"]}, "ownerId": {"$ref": "#/$defs/id"}, "label": {"type": "string", "minLength": 1}}},
    "event": {"type": "object", "additionalProperties": false, "required": ["id", "name", "controlId"], "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1}, "controlId": {"$ref": "#/$defs/id"}}},
    "action": {"type": "object", "additionalProperties": false, "required": ["id", "name", "eventId", "resultingStateIds"], "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1}, "eventId": {"$ref": "#/$defs/id"}, "resultingStateIds": {"$ref": "#/$defs/nonEmptyIds"}}},
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "useCaseId", "interactionFlowIds", "transitionIds", "recoveryStateIds", "routeId", "initialStateIds", "eventIds", "expectedStateIds", "viewportIds"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "useCaseId": {"$ref": "#/$defs/id"},
        "interactionFlowIds": {"$ref": "#/$defs/nonEmptyIds"},
        "transitionIds": {"$ref": "#/$defs/nonEmptyIds"},
        "recoveryStateIds": {"$ref": "#/$defs/ids"},
        "routeId": {"$ref": "#/$defs/id"},
        "initialStateIds": {"$ref": "#/$defs/nonEmptyIds"},
        "eventIds": {"$ref": "#/$defs/nonEmptyIds"},
        "expectedStateIds": {"$ref": "#/$defs/nonEmptyIds"},
        "viewportIds": {"$ref": "#/$defs/ids"}
      }
    },
    "viewport": {"type": "object", "additionalProperties": false, "required": ["id", "width", "height"], "properties": {"id": {"$ref": "#/$defs/id"}, "width": {"type": "integer", "minimum": 240}, "height": {"type": "integer", "minimum": 240}}},
    "targetCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "targetIds"],
      "properties": {
        "kind": {"enum": ["element-visible", "element-in-viewport", "text-no-clipping"]},
        "targetIds": {"$ref": "#/$defs/nonEmptyIds"}
      }
    },
    "visualCheck": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "document-no-horizontal-overflow"}}},
        {"$ref": "#/$defs/targetCheck"},
        {"type": "object", "additionalProperties": false, "required": ["kind", "targetIds"], "properties": {"kind": {"const": "elements-no-overlap"}, "targetIds": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "targetIds", "maxLines"], "properties": {"kind": {"const": "text-max-lines"}, "targetIds": {"$ref": "#/$defs/nonEmptyIds"}, "maxLines": {"type": "integer", "minimum": 1}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "targetId", "property", "expected"], "properties": {"kind": {"const": "computed-style"}, "targetId": {"$ref": "#/$defs/id"}, "property": {"type": "string", "pattern": "^[a-z][a-z-]*$"}, "expected": {"type": "string", "minLength": 1}}}
      ]
    },
    "renderAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "routeId", "viewportIds", "checks"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "routeId": {"$ref": "#/$defs/id"},
        "viewportIds": {"$ref": "#/$defs/nonEmptyIds"},
        "scenarioId": {"$ref": "#/$defs/id"},
        "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/visualCheck"}}
      }
    },
    "sourceParityCheck": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "screenshot-match"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "targetId", "property", "expected"], "properties": {"kind": {"const": "computed-style"}, "targetId": {"$ref": "#/$defs/id"}, "property": {"type": "string", "pattern": "^[a-z][a-z-]*$"}, "expected": {"type": "string", "minLength": 1}}}
      ]
    },
    "sourceParityAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceId", "routeId", "viewportId", "aspects", "checks"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "sourceId": {"$ref": "#/$defs/id"},
        "routeId": {"$ref": "#/$defs/id"},
        "viewportId": {"$ref": "#/$defs/id"},
        "scenarioId": {"$ref": "#/$defs/id"},
        "baselineEvidenceItemId": {"$ref": "#/$defs/id"},
        "aspects": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/visualAspect"}},
        "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceParityCheck"}}
      },
      "allOf": [
        {
          "if": {"properties": {"checks": {"type": "array", "contains": {"type": "object", "properties": {"kind": {"const": "screenshot-match"}}, "required": ["kind"]}}}, "required": ["checks"]},
          "then": {"properties": {"baselineEvidenceItemId": {"$ref": "#/$defs/id"}}, "required": ["baselineEvidenceItemId"]}
        }
      ]
    },
    "componentSourceParityAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceId",
        "componentContractId",
        "pageInstanceId",
        "stateMatrixEntryId",
        "viewportId",
        "baselineEvidenceItemId",
        "aspects",
        "checks"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "sourceId": {"$ref": "#/$defs/id"},
        "componentContractId": {"$ref": "#/$defs/id"},
        "pageInstanceId": {"$ref": "#/$defs/id"},
        "stateMatrixEntryId": {"$ref": "#/$defs/id"},
        "viewportId": {"$ref": "#/$defs/id"},
        "baselineEvidenceItemId": {"$ref": "#/$defs/id"},
        "aspects": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/visualAspect"}},
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sourceParityCheck"},
          "contains": {
            "type": "object",
            "properties": {"kind": {"const": "screenshot-match"}},
            "required": ["kind"]
          }
        }
      }
    },
    "motion": {"type": "object", "additionalProperties": false, "required": ["id", "targetId", "trigger", "durationMs", "reducedMotion"], "properties": {"id": {"$ref": "#/$defs/id"}, "targetId": {"$ref": "#/$defs/id"}, "trigger": {"type": "string", "minLength": 1}, "durationMs": {"type": "integer", "minimum": 0}, "reducedMotion": {"type": "boolean"}}},
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standard", "checks"],
      "properties": {
        "standard": {"const": "Web Content Accessibility Guidelines 2.2 AA"},
        "checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {"enum": ["automated-rules", "keyboard-operation", "visible-focus", "accessible-name", "target-size", "reduced-motion"]}
        }
      }
    },
    "trace": {"type": "object", "additionalProperties": false, "required": ["useCaseId", "interactionFlowIds", "screenIds", "controlIds", "stateIds"], "properties": {"useCaseId": {"$ref": "#/$defs/id"}, "interactionFlowIds": {"$ref": "#/$defs/nonEmptyIds"}, "screenIds": {"$ref": "#/$defs/nonEmptyIds"}, "controlIds": {"$ref": "#/$defs/nonEmptyIds"}, "stateIds": {"$ref": "#/$defs/nonEmptyIds"}}},
    "gap": {"type": "object", "additionalProperties": false, "required": ["id", "description", "owner"], "properties": {"id": {"$ref": "#/$defs/id"}, "description": {"type": "string", "minLength": 1}, "owner": {"type": "string", "minLength": 1}, "sourceIds": {"$ref": "#/$defs/nonEmptyIds"}}}
  }
}

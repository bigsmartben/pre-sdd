{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psp.dev/domains/product-design/canonical-ui-repair-packet.schema.json",
  "title": "Canonical UI Repair Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "status",
    "workspaceRoot",
    "actor",
    "repairSessionId",
    "attempt",
    "maxAttempts",
    "allowedImplementationPaths",
    "implementationPolicy",
    "failures",
    "attempts"
  ],
  "properties": {
    "version": {"const": "5.0.0"},
    "status": {"enum": ["REPAIR_REQUIRED", "BLOCKED"]},
    "workspaceRoot": {"type": "string", "minLength": 1},
    "actor": {"type": "string", "pattern": "^ACTOR-[0-9]{3}$"},
    "repairSessionId": {"$ref": "#/$defs/sessionId"},
    "attempt": {"const": 1},
    "maxAttempts": {"const": 1},
    "allowedImplementationPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "implementationPolicy": {"$ref": "#/$defs/implementationPolicy"},
    "failures": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/failure"}
    },
    "attempts": {
      "type": "array",
      "maxItems": 1,
      "items": {"$ref": "#/$defs/attempt"}
    }
  },
  "$comment": "The packet is evidence and scope guidance for one Agent-owned implementation attempt. It never authorizes source, baseline, tolerance, mock-data, or business-logic changes.",
  "$defs": {
    "sessionId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"},
    "value": {
      "oneOf": [
        {"type": "string"},
        {"type": "number"},
        {"type": "boolean"},
        {"type": "null"},
        {"type": "array", "items": {"type": ["string", "number", "boolean", "null"]}}
      ]
    },
    "implementationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceBeforeEdit",
        "sourceResolution",
        "preserveInteractiveDom",
        "preferSourceAssets",
        "allowSubjectiveApproximation",
        "minimalImplementationScope",
        "stableComparisonEnvironment",
        "fixOrder"
      ],
      "properties": {
        "evidenceBeforeEdit": {"const": true},
        "sourceResolution": {"const": "when-source-backed"},
        "preserveInteractiveDom": {"const": true},
        "preferSourceAssets": {"const": true},
        "allowSubjectiveApproximation": {"const": false},
        "minimalImplementationScope": {"const": true},
        "stableComparisonEnvironment": {"const": true},
        "fixOrder": {"const": ["structure", "geometry", "typography", "paint", "effects", "assets"]}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "routeId": {"$ref": "#/$defs/id"},
        "viewportId": {"$ref": "#/$defs/id"},
        "scenarioId": {"$ref": "#/$defs/id"},
        "assertionId": {"$ref": "#/$defs/id"},
        "componentId": {"$ref": "#/$defs/id"},
        "contractId": {"$ref": "#/$defs/id"},
        "assetId": {"$ref": "#/$defs/id"},
        "targetIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "property": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "expected": {"$ref": "#/$defs/value"},
        "actual": {"$ref": "#/$defs/value"}
      }
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": {"enum": ["actual-screenshot", "difference-screenshot", "source-baseline", "design-context", "asset"]},
        "id": {"$ref": "#/$defs/id"},
        "path": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "sourceKind", "evidenceItemIds"],
      "properties": {
        "sourceId": {"$ref": "#/$defs/id"},
        "sourceKind": {"enum": ["figma", "screenshot", "export", "other"]},
        "evidenceItemIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        }
      }
    },
    "difference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ratio", "regions"],
      "properties": {
        "ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "regions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/differenceRegion"}
        }
      }
    },
    "differenceRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "integer", "minimum": 0},
        "y": {"type": "integer", "minimum": 0},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnosticId",
        "gateId",
        "blockerCode",
        "defectClass",
        "message",
        "location",
        "scope",
        "check",
        "evidence"
      ],
      "properties": {
        "diagnosticId": {"type": "string", "pattern": "^REPAIR-DIAG-[a-f0-9]{16}$"},
        "gateId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "blockerCode": {"type": "string", "pattern": "^AIH_[A-Z0-9_]+$"},
        "defectClass": {"enum": ["source-parity", "html-structure", "css-rendering", "html-accessibility", "asset-binding", "component-contract"]},
        "message": {"type": "string", "minLength": 1},
        "location": {"type": "string", "minLength": 1},
        "scope": {"$ref": "#/$defs/scope"},
        "check": {"$ref": "#/$defs/check"},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidenceItem"}
        },
        "source": {"$ref": "#/$defs/source"},
        "difference": {"$ref": "#/$defs/difference"}
      },
      "allOf": [
        {
          "if": {"properties": {"defectClass": {"const": "source-parity"}}, "required": ["defectClass"]},
          "then": {"required": ["source"]}
        },
        {
          "if": {"properties": {"check": {"properties": {"kind": {"const": "screenshot-match"}}, "required": ["kind"]}}, "required": ["check"]},
          "then": {"required": ["difference"]}
        }
      ]
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt", "failures"],
      "properties": {
        "attempt": {"const": 1},
        "failures": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/failure"}}
      }
    }
  }
}

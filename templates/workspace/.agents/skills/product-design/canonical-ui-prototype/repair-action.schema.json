{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psp.dev/domains/product-design/canonical-ui-repair-action.schema.json",
  "title": "Canonical UI Visual Repair Action Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "attempt", "sourceResolution", "actions"],
  "properties": {
    "version": {"const": "1.0.0"},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 3},
    "sourceResolution": {"$ref": "#/$defs/sourceResolution"},
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/action"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"},
    "path": {"type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
    "sourceResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "sourceEvidenceItemIds", "rationale"],
      "properties": {
        "decision": {"enum": ["reuse-source-assets", "no-applicable-source-asset"]},
        "sourceEvidenceItemIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failureAssertionIds",
        "sourceId",
        "sourceEvidenceItemIds",
        "repairLayer",
        "modifiedPaths",
        "expectedImpact"
      ],
      "properties": {
        "failureAssertionIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "sourceId": {"$ref": "#/$defs/id"},
        "sourceEvidenceItemIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "repairLayer": {
          "enum": ["source-resolution", "structure", "geometry", "typography", "paint", "effects", "assets"]
        },
        "modifiedPaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/path"}
        },
        "expectedImpact": {"type": "string", "minLength": 1}
      }
    }
  }
}

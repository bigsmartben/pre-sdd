{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "psp.dev/mockcase-suite/v2",
  "type": "object",
  "required": ["schemaVersion", "version", "inputLock", "status", "fixtures", "scenarios"],
  "properties": {
    "schemaVersion": { "const": "psp.dev/mockcase-suite/v2" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "inputLock": {
      "type": "object",
      "required": ["uiCasesDigest"],
      "properties": {
        "uiCasesDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "status": { "enum": ["draft", "reviewed", "verified"] },
    "fixtures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fixtureId", "portId", "input", "result"],
        "properties": {
          "fixtureId": { "type": "string" },
          "portId": { "type": "string" },
          "input": {},
          "result": {}
        },
        "additionalProperties": false
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["mockCaseId", "businessCaseId", "fixtureIds"],
        "properties": {
          "mockCaseId": { "type": "string" },
          "businessCaseId": { "type": "string", "pattern": "^BUSINESS-CASE-" },
          "fixtureIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

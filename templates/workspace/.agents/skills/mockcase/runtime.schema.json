{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MockCase Runtime Projection Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "hostApiVersion", "actor", "sourceDigests", "routes", "fixtures", "behaviors", "cases"],
  "properties": {
    "schemaVersion": {"const": "2.0.0"},
    "hostApiVersion": {"const": "psp.review-extension/v1"},
    "actor": {"$ref": "#/$defs/actor"},
    "sourceDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suite", "mockdata", "mockcases", "capabilities", "canonicalUi"],
      "properties": {
        "suite": {"$ref": "#/$defs/digest"},
        "mockdata": {"$ref": "#/$defs/digest"},
        "mockcases": {"$ref": "#/$defs/digest"},
        "capabilities": {"$ref": "#/$defs/digest"},
        "canonicalUi": {"$ref": "#/$defs/digest"}
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "path": {"type": "string", "pattern": "^/"}
        }
      }
    },
    "fixtures": {
      "type": "array",
      "items": {"$ref": "mockdata.schema.json#/$defs/fixture"}
    },
    "behaviors": {
      "type": "array",
      "items": {"$ref": "mockdata.schema.json#/$defs/behavior"}
    },
    "cases": {"type": "array", "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "actor": {"type": "string", "pattern": "^ACTOR-[0-9]{3}$"},
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"},
    "ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "axisId", "valueId"],
          "properties": {
            "kind": {"const": "state-matrix"},
            "axisId": {"$ref": "#/$defs/id"},
            "valueId": {"$ref": "#/$defs/id"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "behaviorId", "fixtureId", "sourcePointer"],
          "properties": {
            "kind": {"const": "fixture"},
            "behaviorId": {"$ref": "#/$defs/id"},
            "fixtureId": {"$ref": "#/$defs/id"},
            "sourcePointer": {"type": "string"}
          }
        }
      ]
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["propertyName", "value", "sources"],
      "properties": {
        "propertyName": {"type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"},
        "value": true,
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/source"}
        }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetInstanceId",
        "componentContractId",
        "stateMatrixEntryId",
        "behaviorIds",
        "activation",
        "assignments",
        "expectedStateIds"
      ],
      "properties": {
        "targetInstanceId": {"$ref": "#/$defs/id"},
        "componentContractId": {"$ref": "#/$defs/id"},
        "stateMatrixEntryId": {"$ref": "#/$defs/id"},
        "behaviorIds": {"$ref": "#/$defs/ids"},
        "activation": {"$ref": "mockcases.schema.json#/$defs/activation"},
        "assignments": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/assignment"}
        },
        "expectedStateIds": {"$ref": "#/$defs/ids"}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label", "routeId", "effects", "isDefault", "projectionDigest"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["business", "technical"]},
        "label": {"type": "string", "minLength": 1},
        "routeId": {"$ref": "#/$defs/id"},
        "scenarioId": {"$ref": "#/$defs/id"},
        "effects": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/effect"}},
        "isDefault": {"type": "boolean"},
        "projectionDigest": {"$ref": "#/$defs/digest"}
      },
      "allOf": [{
        "if": {"properties": {"kind": {"const": "business"}}, "required": ["kind"]},
        "then": {
          "required": ["scenarioId"],
          "properties": {"scenarioId": {"$ref": "#/$defs/id"}}
        }
      }]
    }
  }
}

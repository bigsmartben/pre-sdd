{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MockCase Runtime Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "hostApiVersion", "actor", "sourceDigests", "routes", "fixtures", "behaviors", "cases"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "hostApiVersion": {"const": "psp.review-extension/v1"},
    "actor": {"$ref": "#/$defs/actor"},
    "sourceDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suite", "mockdata", "mockcases", "capabilities", "canonicalUi"],
      "properties": {
        "suite": {"$ref": "#/$defs/digest"},
        "mockdata": {"$ref": "#/$defs/digest"},
        "mockcases": {"$ref": "#/$defs/digest"},
        "capabilities": {"$ref": "#/$defs/digest"},
        "canonicalUi": {"$ref": "#/$defs/digest"}
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "path": {"type": "string", "pattern": "^/"}
        }
      }
    },
    "fixtures": {"type": "array", "items": {"$ref": "#/$defs/fixture"}},
    "behaviors": {"type": "array", "items": {"$ref": "#/$defs/behavior"}},
    "cases": {"type": "array", "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "actor": {"type": "string", "pattern": "^ACTOR-[0-9]{3}$"},
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"},
    "ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "headers": {"type": "object", "additionalProperties": {"type": "string"}},
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "payload"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "payload": true
      }
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "request", "response"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "path"],
          "properties": {
            "method": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]},
            "path": {"type": "string", "pattern": "^/"},
            "query": {"type": "object", "additionalProperties": {"type": "string"}},
            "headers": {"$ref": "#/$defs/headers"}
          }
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fixtureId", "status"],
          "properties": {
            "fixtureId": {"$ref": "#/$defs/id"},
            "status": {"type": "integer", "minimum": 100, "maximum": 599},
            "headers": {"$ref": "#/$defs/headers"},
            "delayMs": {"type": "integer", "minimum": 0, "maximum": 30000}
          }
        }
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["request", "control-event", "input"]},
        "controlId": {"$ref": "#/$defs/id"},
        "value": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "control-event"}}, "required": ["kind"]},
          "then": {
            "required": ["controlId"],
            "properties": {"controlId": {"$ref": "#/$defs/id"}}
          }
        },
        {
          "if": {"properties": {"kind": {"const": "input"}}, "required": ["kind"]},
          "then": {
            "required": ["controlId", "value"],
            "properties": {
              "controlId": {"$ref": "#/$defs/id"},
              "value": {"type": "string"}
            }
          }
        }
      ]
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetInstanceId", "behaviorIds", "activation", "expectedStateMatrixEntryId", "expectedStateIds"],
      "properties": {
        "targetInstanceId": {"$ref": "#/$defs/id"},
        "behaviorIds": {"$ref": "#/$defs/ids"},
        "activation": {"$ref": "#/$defs/activation"},
        "expectedStateMatrixEntryId": {"$ref": "#/$defs/id"},
        "expectedStateIds": {"$ref": "#/$defs/ids"}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label", "routeId", "effects", "isDefault"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["business", "technical"]},
        "label": {"type": "string", "minLength": 1},
        "routeId": {"$ref": "#/$defs/id"},
        "scenarioId": {"$ref": "#/$defs/id"},
        "effects": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/effect"}},
        "isDefault": {"type": "boolean"}
      },
      "allOf": [{
        "if": {"properties": {"kind": {"const": "business"}}, "required": ["kind"]},
        "then": {
          "required": ["scenarioId"],
          "properties": {"scenarioId": {"$ref": "#/$defs/id"}}
        }
      }]
    }
  }
}

    "test:harness": "node .psp/harness/scripts/invoke-pre-sdd.mjs harness test:harness",
    "test:product": "node .psp/harness/scripts/invoke-pre-sdd.mjs harness test:product",
    "test:architecture": "node .psp/harness/scripts/invoke-pre-sdd.mjs harness test:architecture",

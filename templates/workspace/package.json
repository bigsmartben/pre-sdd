{
  "name": "pre-sdd-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@playwright/test": "^1.61.1",
    "ajv": "^8.20.0",
    "axe-core": "^4.12.1",
    "lit": "^3.3.3",
    "msw": "^2.15.0",
    "picomatch": "^4.0.5",
    "toml": "^4.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "yaml": "^2.9.0"
  },
  "scripts": {

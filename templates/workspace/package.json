{
  "name": "pre-sdd-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@playwright/test": "^1.61.1",
    "ajv": "^8.20.0",
    "axe-core": "^4.12.1",
    "lit": "^3.3.3",
    "msw": "^2.15.0",
    "picomatch": "^4.0.5",
    "toml": "^4.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "yaml": "^2.9.0"
  },
  "scripts": {
    "workspace:build": "node .agents/skills/lit-ui/scripts/build.mjs --mode product",
    "build": "npm run workspace:build",
    "build:review": "node .agents/skills/lit-ui/scripts/build.mjs --mode review",
    "typecheck": "tsc --noEmit --project .agents/skills/lit-ui/template/tsconfig.json",
    "validate": "npm run validate:product",
    "validate:strict": "npm run validate:product:strict",
    "validate:product": "node .agents/skills/product-design/scripts/validate.mjs",
    "validate:use-cases": "node .agents/skills/product-design/scripts/validate.mjs --step use-cases",
    "validate:functional-delivery-baseline": "node .agents/skills/product-design/scripts/validate.mjs --step functional-delivery-baseline",
    "validate:product:strict": "node .agents/skills/product-design/scripts/validate.mjs --strict",
    "generate:visual-spec": "node .agents/skills/visual-spec/scripts/generate.mjs",
    "validate:visual-spec": "node .agents/skills/visual-spec/scripts/validate.mjs",
    "authorize:visual-spec": "node .agents/skills/visual-spec/scripts/authorize.mjs",
    "init:user-path-cases": "node .agents/skills/user-path-cases/scripts/initialize.mjs",
    "generate:user-path-plan": "node .agents/skills/user-path-cases/scripts/generate.mjs",
    "validate:user-path-plan": "node .agents/skills/user-path-cases/scripts/validate.mjs",
    "bind:figma-evidence": "node .agents/skills/figma-workflow/scripts/bind.mjs",
    "validate:figma-evidence": "node .agents/skills/figma-workflow/scripts/validate.mjs",
    "prepare:mockcase": "node .agents/skills/mockcase/scripts/workflow.mjs --operation prepare",
    "validate:mockcase": "node .agents/skills/mockcase/scripts/workflow.mjs --operation validate",
    "validate:lit-l1-l2": "node .agents/skills/lit-ui/scripts/validate.mjs --phase review",
    "prepare:visual-delivery": "node .agents/skills/lit-ui/scripts/prepare-delivery.mjs",
    "mark:visual-finding": "node .agents/skills/lit-ui/scripts/mark-finding.mjs",
    "accept:visual-delivery": "node .agents/skills/lit-ui/scripts/accept-delivery.mjs",
    "validate:visual-delivery": "node .agents/skills/lit-ui/scripts/validate.mjs --phase delivery",
    "validate:uihtml": "node .agents/skills/lit-ui/scripts/validate-delivery.mjs",
    "repair:visual-route": "node .agents/skills/repair-visual-delivery/scripts/route.mjs",
    "repair:visual-transition": "node .agents/skills/repair-visual-delivery/scripts/transition.mjs",
    "validate:architecture": "node .agents/skills/architecture-design/scripts/validate.mjs",
    "validate:architecture:strict": "node .agents/skills/architecture-design/scripts/validate.mjs --strict",
    "validate:system-boundary": "node .agents/skills/architecture-design/scripts/validate.mjs --step system-boundary",
    "validate:conceptual-model": "node .agents/skills/architecture-design/scripts/validate.mjs --step conceptual-model",
    "validate:technical-validation": "node .agents/skills/architecture-design/scripts/validate.mjs --step technical-validation",
    "validate:architecture-package": "node .agents/skills/architecture-design/scripts/validate.mjs --step architecture-package",
    "init:product": "node .agents/skills/product-design/scripts/initialize.mjs",
    "init:architecture": "node .agents/skills/architecture-design/scripts/initialize.mjs",
    "apply:product-artifact": "node .agents/skills/product-design/scripts/apply-artifact.mjs --operation apply-product-artifact",
    "apply:architecture-artifact": "node .agents/skills/architecture-design/scripts/apply-artifact.mjs --operation apply-architecture-artifact",
    "hash:uihtml": "node .agents/skills/lit-ui/scripts/hash-uihtml.mjs",
    "render:product": "node .agents/skills/product-design/scripts/render.mjs",
    "render:architecture": "node .agents/skills/architecture-design/scripts/render.mjs",
    "check:outputs": "node .agents/skills/product-design/scripts/render.mjs --check",
    "check:architecture-outputs": "node .agents/skills/architecture-design/scripts/render.mjs --check",
    "test:visual-spec": "node --test .agents/skills/visual-spec/tests/*.test.mjs",
    "test:user-path-cases": "node --test .agents/skills/user-path-cases/tests/*.test.mjs",
    "test:figma-workflow": "node --test .agents/skills/figma-workflow/tests/*.test.mjs",
    "test:lit-ui": "node --test .agents/skills/lit-ui/tests/*.test.mjs",
    "test:mockcase": "node --test .agents/skills/mockcase/tests/*.test.mjs",
    "test:repair-visual-delivery": "node --test .agents/skills/repair-visual-delivery/tests/*.test.mjs",
    "test:product": "npm run test:visual-spec && npm run test:user-path-cases && npm run test:figma-workflow && npm run test:lit-ui && npm run test:repair-visual-delivery",
    "test:architecture": "node --test .agents/skills/architecture-design/tests/*.test.mjs",
    "test": "npm run test:product && npm run test:mockcase && npm run test:architecture",
    "check": "npm test && npm run validate:product && npm run validate:architecture",
    "check:strict": "npm test && npm run validate:product:strict && npm run validate:visual-spec && npm run validate:figma-evidence && npm run validate:user-path-plan && npm run validate:mockcase && npm run validate:visual-delivery && npm run validate:uihtml && npm run validate:architecture:strict"
  }
}

    "repair:canonical-ui": "node .psp/harness/scripts/invoke-pre-sdd.mjs harness repair:canonical-ui",
    "render:product": "node .psp/harness/scripts/invoke-pre-sdd.mjs harness render:product",
    "render:architecture": "node .psp/harness/scripts/invoke-pre-sdd.mjs harness render:architecture",
    "check:outputs": "node .psp/harness/scripts/invoke-pre-sdd.mjs harness check:outputs",

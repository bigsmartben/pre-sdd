{
  "$schema": "./schemas/harness-manifest.schema.json",
  "name": "psp-repository-ai-coding-harness",
  "version": "9.0.0",
  "runtime": {
    "protocol": "pre-sdd-harness/v1",
    "command": "pre-sdd",
    "fallbackPackage": "git+https://github.com/bigsmartben/pre-sdd.git"
  },
  "entrypoints": {
    "instructions": "AGENTS.md",
    "protocol": ".psp/harness/HARNESS.md",
    "project": "psp.project.yaml",
    "manifest": ".psp/harness/harness.manifest.json",
    "repository": "README.md"
  },
  "schemas": {
    "manifest": ".psp/harness/schemas/harness-manifest.schema.json",
    "project": ".psp/harness/schemas/project.schema.json",
    "contract": ".psp/harness/schemas/artifact-contract.schema.json"
  },
  "codex": {
    "projectConfig": ".codex/config.toml",
    "hookConfig": ".codex/hooks.json",
    "hookScripts": [".codex/hooks/validate-harness.mjs"],
    "repositorySkills": [
      ".agents/skills/apply-repository-harness/SKILL.md",
      ".agents/skills/build-product-html-mock/SKILL.md"
    ]
  },
  "readOrder": [
    "AGENTS.md",
    ".psp/harness/HARNESS.md",
    "psp.project.yaml",
    ".psp/harness/harness.manifest.json"
  ],
  "artifactRegistry": [
    {
      "id": "product-package",
      "stage": "product-design",
      "format": "yaml",
      "contract": ".psp/harness/contracts/product-package.contract.yaml",
      "schema": ".psp/harness/schemas/artifacts/product-package.schema.json",
      "template": ".psp/harness/templates/product-package.template.yaml",
      "renderer": "product-package-markdown"
    },
    {
      "id": "capabilities",
      "stage": "product-design",
      "format": "yaml",
      "contract": ".psp/harness/contracts/capabilities.contract.yaml",
      "schema": ".psp/harness/schemas/artifacts/capabilities.schema.json",
      "template": ".psp/harness/templates/capabilities.template.yaml",
      "renderer": "capabilities-markdown"
    },
    {
      "id": "interactions",
      "stage": "product-design",
      "format": "yaml",
      "contract": ".psp/harness/contracts/interactions.contract.yaml",
      "schema": ".psp/harness/schemas/artifacts/interactions.schema.json",
      "template": ".psp/harness/templates/interactions.template.yaml",
      "renderer": "interactions-markdown"
    },
    {
      "id": "ui-spec",
      "stage": "product-design",
      "format": "yaml",
      "contract": ".psp/harness/contracts/ui-spec.contract.yaml",
      "schema": ".psp/harness/schemas/artifacts/ui-spec.schema.json",
      "template": ".psp/harness/templates/ui-spec.template.yaml",
      "renderer": "ui-spec-markdown"
    },
    {
      "id": "component-catalog",
      "stage": "product-design",
      "format": "yaml",
      "contract": ".psp/harness/contracts/component-catalog.contract.yaml",
      "schema": ".psp/harness/schemas/artifacts/component-catalog.schema.json",
      "template": ".psp/harness/templates/component-catalog.template.yaml",
      "renderer": "component-catalog-markdown"
    },
    {
      "id": "traceability",
      "stage": "product-design",
      "format": "json",
      "contract": ".psp/harness/contracts/traceability.contract.yaml",
      "schema": ".psp/harness/schemas/artifacts/traceability.schema.json",
      "template": ".psp/harness/templates/traceability.template.json",
      "renderer": "traceability-typescript"
    },
    {
      "id": "architecture-package",
      "stage": "architecture-design",
      "format": "yaml",
      "contract": ".psp/harness/contracts/architecture-package.contract.yaml",
      "schema": ".psp/harness/schemas/artifacts/architecture-package.schema.json",
      "template": ".psp/harness/templates/architecture-package.template.yaml",
      "renderer": "architecture-package-markdown"
    },
    {
      "id": "system-boundary",
      "stage": "architecture-design",
      "format": "yaml",
      "contract": ".psp/harness/contracts/system-boundary.contract.yaml",
      "schema": ".psp/harness/schemas/artifacts/system-boundary.schema.json",
      "template": ".psp/harness/templates/system-boundary.template.yaml",
      "renderer": "system-boundary-markdown"
    },
    {
      "id": "conceptual-model",
      "stage": "architecture-design",
      "format": "yaml",
      "contract": ".psp/harness/contracts/conceptual-model.contract.yaml",
      "schema": ".psp/harness/schemas/artifacts/conceptual-model.schema.json",
      "template": ".psp/harness/templates/conceptual-model.template.yaml",
      "renderer": "conceptual-model-markdown"
    },
    {
      "id": "technical-validation",
      "stage": "architecture-design",
      "format": "yaml",
      "contract": ".psp/harness/contracts/technical-validation.contract.yaml",
      "schema": ".psp/harness/schemas/artifacts/technical-validation.schema.json",
      "template": ".psp/harness/templates/technical-validation.template.yaml",
      "renderer": "technical-validation-markdown"
    }
  ],
  "operations": [
    {
      "id": "initialize-workspace",
      "kind": "workspace",
      "npmScript": "init:workspace",
      "run": "npm run init:workspace",
      "executor": {"kind": "module", "path": ".psp/harness/scripts/init-workspace.mjs"}
    },
    {
      "id": "initialize-product",
      "kind": "stage",
      "npmScript": "init:product",
      "run": "npm run init:product",
      "executor": {"kind": "module", "path": ".psp/harness/scripts/init-product.mjs"},
      "stage": "product-design",
      "fromState": "uninitialized",
      "toState": "active",
      "areaTemplates": {
        "html-mock": ".psp/harness/templates/ui-prototype"
      }
    },
    {
      "id": "initialize-architecture",
      "kind": "stage",
      "npmScript": "init:architecture",
      "run": "npm run init:architecture",
      "executor": {"kind": "module", "path": ".psp/harness/scripts/init-architecture.mjs"},
      "stage": "architecture-design",
      "fromState": "uninitialized",
      "toState": "active",
      "areaTemplates": {
        "technical-validation": ".psp/harness/templates/technical-validation"
      }
    }
  ],
  "commands": [
    {
      "id": "harness",
      "npmScript": "validate:harness",
      "run": "npm run validate:harness",
      "purpose": "校验 Harness、项目绑定、Contract、Codex 接入与 resolver",
      "blocking": true,
      "executor": {"kind": "module", "path": ".psp/harness/scripts/validate-harness.mjs"}
    },
    {
      "id": "workspace-structure",
      "npmScript": "validate:workspace",
      "run": "npm run validate:workspace",
      "purpose": "校验纯脚手架目录骨架、阶段空状态和用户实例隔离",
      "blocking": true,
      "executor": {"kind": "module", "path": ".psp/harness/scripts/init-workspace.mjs", "args": ["--dry-run"]}
    },
    {
      "id": "test-harness",
      "npmScript": "test:harness",
      "run": "npm run test:harness",
      "purpose": "运行 Harness contract tests",
      "blocking": true,
      "executor": {"kind": "node-test", "paths": [".psp/harness/tests/harness/*.test.mjs"]}
    },
    {
      "id": "test-product",
      "npmScript": "test:product",
      "run": "npm run test:product",
      "purpose": "运行 UC、Wireflow Mid、HTML Mock 与支撑追溯的 contract tests",
      "blocking": true,
      "executor": {"kind": "node-test", "paths": [".psp/harness/tests/product/*.test.mjs"]}
    },
    {
      "id": "product-structure",
      "npmScript": "validate:product",
      "run": "npm run validate:product",
      "purpose": "校验 UC → Wireflow Mid → HTML Mock 结构、场景覆盖、代码入口和生成一致性，允许显式 draft gap",
      "blocking": true,
      "executor": {"kind": "module", "path": ".psp/harness/scripts/validate-product.mjs"}
    },
    {
      "id": "product-strict",
      "npmScript": "validate:product:strict",
      "run": "npm run validate:product:strict",
      "purpose": "校验产品 Markdown 用户产物与 HTML Mock 可执行证据是否达到下游可消费状态",
      "blocking": true,
      "executor": {"kind": "module", "path": ".psp/harness/scripts/validate-product.mjs", "args": ["--strict"]}
    },
    {
      "id": "html-mock-input",
      "npmScript": "validate:html-mock-input",
      "run": "npm run validate:html-mock-input",
      "purpose": "在 HTML 编码前校验 Product Package、Use Case、Wireflow 与设计来源证据已可消费",
      "blocking": true,
      "executor": {"kind": "module", "path": ".psp/harness/scripts/validate-html-mock-input.mjs"}
    },
    {
      "id": "typecheck",
      "npmScript": "typecheck",
      "run": "npm run typecheck",
      "purpose": "校验绑定的 HTML Mock TypeScript",
      "blocking": true,
      "executor": {"kind": "runtime", "capability": "typecheck"}
    },
    {
      "id": "build",
      "npmScript": "build",
      "run": "npm run build",
      "purpose": "构建绑定的 HTML Mock",
      "blocking": true,
      "executor": {"kind": "runtime", "capability": "build"}
    },
    {
      "id": "html-mock-runtime",
      "npmScript": "validate:html-mock-runtime",
      "run": "npm run validate:html-mock-runtime",
      "purpose": "在全部必测视口运行 HTML 场景、检查 DOM/状态/反馈/资源使用并生成截图证据",
      "blocking": true,
      "executor": {"kind": "runtime", "capability": "html-mock-runtime"}
    },
    {
      "id": "test-architecture",
      "npmScript": "test:architecture",
      "run": "npm run test:architecture",
      "purpose": "运行架构 Markdown 用户产物、内部模型、技术选型与代码验证脚手架 contract tests",
      "blocking": true,
      "executor": {"kind": "node-test", "paths": [".psp/harness/tests/architecture/*.test.mjs"]}
    },
    {
      "id": "architecture-structure",
      "npmScript": "validate:architecture",
      "run": "npm run validate:architecture",
      "purpose": "校验架构实例结构、上游引用、代码证据和生成一致性，允许显式 draft gap",
      "blocking": true,
      "executor": {"kind": "module", "path": ".psp/harness/scripts/validate-architecture.mjs"}
    },
    {
      "id": "architecture-strict",
      "npmScript": "validate:architecture:strict",
      "run": "npm run validate:architecture:strict",
      "purpose": "校验架构 Markdown 用户产物是否达到 Spec-Kit 可消费状态",
      "blocking": true,
      "executor": {"kind": "module", "path": ".psp/harness/scripts/validate-architecture.mjs", "args": ["--strict"]}
    },
    {
      "id": "html-mock-dev",
      "npmScript": "dev",
      "run": "npm run dev",
      "purpose": "启动绑定的 HTML Mock 开发服务器",
      "blocking": true,
      "executor": {"kind": "runtime", "capability": "dev"}
    },
    {
      "id": "install-browser",
      "npmScript": "install:browser",
      "run": "npm run install:browser",
      "purpose": "显式安装 Playwright Chromium 浏览器运行时",
      "blocking": true,
      "executor": {"kind": "runtime", "capability": "install-browser"}
    },
    {
      "id": "render-product",
      "npmScript": "render:product",
      "run": "npm run render:product",
      "purpose": "从内部模型生成产品 Markdown 与机器支撑",
      "blocking": true,
      "executor": {"kind": "module", "path": ".psp/harness/scripts/render-artifacts.mjs"}
    },
    {
      "id": "render-architecture",
      "npmScript": "render:architecture",
      "run": "npm run render:architecture",
      "purpose": "从内部模型生成架构 Markdown",
      "blocking": true,
      "executor": {"kind": "module", "path": ".psp/harness/scripts/render-architecture.mjs"}
    },
    {
      "id": "check-product-outputs",
      "npmScript": "check:outputs",
      "run": "npm run check:outputs",
      "purpose": "检查产品生成结果漂移",
      "blocking": true,
      "executor": {"kind": "module", "path": ".psp/harness/scripts/render-artifacts.mjs", "args": ["--check"]}
    },
    {
      "id": "check-architecture-outputs",
      "npmScript": "check:architecture-outputs",
      "run": "npm run check:architecture-outputs",
      "purpose": "检查架构生成结果漂移",
      "blocking": true,
      "executor": {"kind": "module", "path": ".psp/harness/scripts/render-architecture.mjs", "args": ["--check"]}
    },
    {
      "id": "verify-architecture",
      "npmScript": "verify:architecture",
      "run": "npm run verify:architecture",
      "purpose": "运行绑定的架构技术验证脚本",
      "blocking": true,
      "executor": {"kind": "area-script", "area": "technical-validation", "script": "verify"}
    },
    {
      "id": "harness-resolve",
      "npmScript": "harness:resolve",
      "run": "npm run harness:resolve",
      "purpose": "解析变更路径对应的 Scope 与 Profile",
      "blocking": true,
      "executor": {"kind": "module", "path": ".psp/harness/scripts/resolve-validation.mjs"}
    }
  ],
  "validationProfiles": [
    {
      "id": "workspace-scaffold",
      "commands": ["harness", "workspace-structure", "test-harness", "test-product", "product-structure", "test-architecture", "architecture-structure"]
    },
    {
      "id": "repository-harness",
      "commands": ["harness", "test-harness"]
    },
    {
      "id": "product-framework",
      "commands": ["harness", "test-product", "product-structure"]
    },
    {
      "id": "product-uninitialized",
      "commands": ["harness", "test-product", "product-structure"]
    },
    {
      "id": "product-structure",
      "commands": ["harness", "product-structure"]
    },
    {
      "id": "product-delivery",
      "commands": ["harness", "test-product", "product-structure", "html-mock-input", "typecheck", "build", "html-mock-runtime", "product-strict"]
    },
    {
      "id": "html-mock",
      "commands": ["harness", "product-structure", "html-mock-input", "typecheck", "build", "html-mock-runtime"]
    },
    {
      "id": "architecture-framework",
      "commands": ["harness", "test-architecture", "architecture-structure"]
    },
    {
      "id": "architecture-uninitialized",
      "commands": ["harness", "test-architecture", "architecture-structure"]
    },
    {
      "id": "architecture-structure",
      "commands": ["harness", "architecture-structure"]
    },
    {
      "id": "architecture-delivery",
      "commands": ["harness", "test-architecture", "architecture-structure", "architecture-strict"]
    },
    {
      "id": "technical-validation",
      "commands": ["harness", "test-architecture", "architecture-structure"]
    }
  ],
  "scopes": [
    {
      "id": "workspace-scaffold",
      "kind": "workspace",
      "selectionGroup": "workspace",
      "priority": 300,
      "status": "active",
      "selector": {
        "type": "workspace",
        "marker": ".gitkeep"
      },
      "defaultProfile": "workspace-scaffold",
      "readinessProfile": "workspace-scaffold"
    },
    {
      "id": "repository-harness",
      "kind": "repository",
      "selectionGroup": "repository",
      "priority": 100,
      "status": "active",
      "selector": {
        "type": "static",
        "paths": [
          "AGENTS.md",
          "README.md",
          "package.json",
          "package-lock.json",
          "psp.project.yaml",
          ".codex/**",
          ".agents/skills/**",
          ".psp/harness/**"
        ]
      },
      "defaultProfile": "repository-harness",
      "readinessProfile": "repository-harness"
    },
    {
      "id": "product-framework",
      "kind": "validator",
      "selectionGroup": "product-framework",
      "priority": 200,
      "status": "active",
      "selector": {
        "type": "static",
        "paths": [
          ".psp/harness/contracts/product-package.contract.yaml",
          ".psp/harness/contracts/capabilities.contract.yaml",
          ".psp/harness/contracts/interactions.contract.yaml",
          ".psp/harness/contracts/ui-spec.contract.yaml",
          ".psp/harness/contracts/component-catalog.contract.yaml",
          ".psp/harness/contracts/traceability.contract.yaml",
          ".psp/harness/schemas/artifacts/product-package.schema.json",
          ".psp/harness/schemas/artifacts/capabilities.schema.json",
          ".psp/harness/schemas/artifacts/interactions.schema.json",
          ".psp/harness/schemas/artifacts/ui-spec.schema.json",
          ".psp/harness/schemas/artifacts/component-catalog.schema.json",
          ".psp/harness/schemas/artifacts/traceability.schema.json",
          ".psp/harness/templates/product-package.template.yaml",
          ".psp/harness/templates/capabilities.template.yaml",
          ".psp/harness/templates/interactions.template.yaml",
          ".psp/harness/templates/ui-spec.template.yaml",
          ".psp/harness/templates/component-catalog.template.yaml",
          ".psp/harness/templates/traceability.template.json",
          ".psp/harness/templates/ui-prototype/**",
          ".psp/harness/scripts/validate-product.mjs",
          ".psp/harness/scripts/validate-html-mock-input.mjs",
          ".psp/harness/scripts/validate-html-mock-runtime.mjs",
          ".psp/harness/scripts/lib/html-mock-evidence.mjs",
          ".psp/harness/scripts/init-product.mjs",
          ".psp/harness/scripts/render-artifacts.mjs",
          ".psp/harness/scripts/lib/rendering.mjs",
          ".psp/harness/tests/product/**"
        ]
      },
      "defaultProfile": "product-framework",
      "readinessProfile": "product-framework"
    },
    {
      "id": "architecture-framework",
      "kind": "validator",
      "selectionGroup": "architecture-framework",
      "priority": 200,
      "status": "active",
      "selector": {
        "type": "static",
        "paths": [
          ".psp/harness/contracts/architecture-package.contract.yaml",
          ".psp/harness/contracts/system-boundary.contract.yaml",
          ".psp/harness/contracts/conceptual-model.contract.yaml",
          ".psp/harness/contracts/technical-validation.contract.yaml",
          ".psp/harness/schemas/artifacts/architecture-package.schema.json",
          ".psp/harness/schemas/artifacts/system-boundary.schema.json",
          ".psp/harness/schemas/artifacts/conceptual-model.schema.json",
          ".psp/harness/schemas/artifacts/technical-validation.schema.json",
          ".psp/harness/templates/architecture-package.template.yaml",
          ".psp/harness/templates/system-boundary.template.yaml",
          ".psp/harness/templates/conceptual-model.template.yaml",
          ".psp/harness/templates/technical-validation.template.yaml",
          ".psp/harness/templates/technical-validation/**",
          ".psp/harness/scripts/validate-architecture.mjs",
          ".psp/harness/scripts/init-architecture.mjs",
          ".psp/harness/scripts/render-architecture.mjs",
          ".psp/harness/scripts/lib/rendering.mjs",
          ".psp/harness/tests/architecture/**"
        ]
      },
      "defaultProfile": "architecture-framework",
      "readinessProfile": "architecture-framework"
    },
    {
      "id": "product-design",
      "kind": "stage",
      "selectionGroup": "product-design",
      "priority": 100,
      "status": "active",
      "selector": {
        "type": "stage",
        "stage": "product-design"
      },
      "defaultProfile": "product-structure",
      "readinessProfile": "product-delivery",
      "uninitializedProfile": "product-uninitialized"
    },
    {
      "id": "html-mock",
      "kind": "subtree",
      "selectionGroup": "product-design",
      "priority": 200,
      "status": "active",
      "selector": {
        "type": "area",
        "stage": "product-design",
        "area": "html-mock"
      },
      "defaultProfile": "html-mock",
      "readinessProfile": "product-delivery",
      "uninitializedProfile": "product-uninitialized",
      "dependencies": ["product-design"]
    },
    {
      "id": "architecture-design",
      "kind": "stage",
      "selectionGroup": "architecture-design",
      "priority": 100,
      "status": "active",
      "selector": {
        "type": "stage",
        "stage": "architecture-design"
      },
      "defaultProfile": "architecture-structure",
      "readinessProfile": "architecture-delivery",
      "uninitializedProfile": "architecture-uninitialized",
      "dependencies": ["product-design"]
    },
    {
      "id": "technical-validation",
      "kind": "subtree",
      "selectionGroup": "architecture-design",
      "priority": 200,
      "status": "active",
      "selector": {
        "type": "area",
        "stage": "architecture-design",
        "area": "technical-validation"
      },
      "defaultProfile": "technical-validation",
      "readinessProfile": "architecture-delivery",
      "uninitializedProfile": "architecture-uninitialized",
      "dependencies": ["architecture-design"]
    }
  ],
  "capabilities": {
    "test": {"status": "available", "command": "test"},
    "lint": {"status": "unavailable", "reason": "仓库尚未声明 lint script"},
    "typecheck": {"status": "available", "command": "typecheck"},
    "build": {"status": "available", "command": "build"}
  },
  "handoff": {
    "requiredFields": ["scope", "changes", "validation", "residuals"],
    "validationStates": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"]
  },
  "blockers": [
    {"code": "AIH_PROJECT_BINDING_INVALID", "severity": "blocker", "owner": "repository-harness", "meaning": "项目绑定缺失、越界、重复或引用未知逻辑对象"},
    {"code": "AIH_CONTRACT_INVALID", "severity": "blocker", "owner": "repository-harness", "meaning": "Artifact Contract 缺失、结构非法或与 registry 不一致"},
    {"code": "AIH_ARTIFACT_SCHEMA_FAILED", "severity": "high", "owner": "product-framework", "meaning": "Harness 内部结构化模型不符合对应 Schema"},
    {"code": "AIH_ARTIFACT_INCOMPLETE", "severity": "blocker", "owner": "product-design", "meaning": "规格内容仍是 draft、存在 gap 或未满足严格门禁"},
    {"code": "AIH_SOURCE_INTEGRITY_FAILED", "severity": "high", "owner": "product-framework", "meaning": "设计来源缺少可复现本地证据、证据不可读或内容哈希不匹配"},
    {"code": "AIH_REFERENCE_UNRESOLVED", "severity": "high", "owner": "product-design", "meaning": "跨产物标识符引用无法解析"},
    {"code": "AIH_GENERATED_DRIFT", "severity": "high", "owner": "product-framework", "meaning": "Markdown 用户产物或机器生成支撑与内部模型不一致，或 output 被单独修改"},
    {"code": "AIH_UPSTREAM_NOT_READY", "severity": "blocker", "owner": "product-design", "meaning": "下游工作要求的上游严格门禁未通过"},
    {"code": "AIH_ARCHITECTURE_UNAVAILABLE", "severity": "blocker", "owner": "repository-harness", "meaning": "项目将架构阶段显式绑定为 unavailable，架构写入被阻断"},

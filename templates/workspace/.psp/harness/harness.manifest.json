{
  "$schema": "./schemas/harness-manifest.schema.json",
  "name": "psp-repository-ai-coding-harness",
  "version": "13.0.0",
  "runtime": {
    "protocol": "pre-sdd-harness/v2",
    "authority": "generated-workspace-local",
    "entrypoint": ".psp/runtime/pre-sdd/bin/pre-sdd.mjs",
    "dependencyLock": "package-lock.json",
    "dependencyCache": "os-temporary-directory"
  },
  "entrypoints": {
    "instructions": "AGENTS.md",
    "protocol": ".psp/harness/HARNESS.md",
    "boundary": ".psp/harness/HARNESS-BOUNDARY.md",
    "project": "psp.project.yaml",
    "manifest": ".psp/harness/harness.manifest.json",
    "repository": "README.md"
  },
  "schemas": {
    "manifest": ".psp/harness/schemas/harness-manifest.schema.json",
    "project": ".psp/harness/schemas/project.schema.json",
    "contract": ".psp/harness/schemas/artifact-contract.schema.json"
  },
  "codex": {
    "projectConfig": ".codex/config.toml",
    "hookConfig": ".codex/hooks.json",
    "hookScripts": [
      ".codex/hooks/validate-harness.mjs"
    ],
    "repositorySkills": [
      ".agents/skills/apply-repository-harness/SKILL.md",
      ".agents/skills/product-design/SKILL.md",
      ".agents/skills/architecture-design/SKILL.md",
      ".agents/skills/capture-figma-design-source/SKILL.md",
      ".agents/skills/organize-figma-assets/SKILL.md",
      ".agents/skills/figma-component-from-design/SKILL.md",
      ".agents/skills/implement-figma-lit-page/SKILL.md",
      ".agents/skills/repair-canonical-ui-visual/SKILL.md"
    ]
  },
  "readOrder": [
    "AGENTS.md",
    ".psp/harness/HARNESS.md",
    ".psp/harness/HARNESS-BOUNDARY.md",
    "psp.project.yaml",
    ".psp/harness/harness.manifest.json"
  ],
  "artifactRegistry": [
    {
      "id": "capabilities",
      "stage": "product-design",
      "domain": "product-design",
      "authorityKind": "internal-model",
      "format": "yaml",
      "contract": ".agents/skills/product-design/capabilities/contract.yaml",
      "schema": ".agents/skills/product-design/capabilities/schema.json",
      "template": ".agents/skills/product-design/capabilities/template.yaml",
      "projections": [
        {
          "id": "use-cases-document",
          "renderer": "capabilities-markdown"
        }
      ]
    },
    {
      "id": "interactions",
      "stage": "product-design",
      "domain": "product-design",
      "authorityKind": "internal-model-set",
      "format": "yaml",
      "contract": ".agents/skills/product-design/interactions/contract.yaml",
      "schema": ".agents/skills/product-design/interactions/schema.json",
      "template": ".agents/skills/product-design/interactions/template.yaml",
      "projections": [
        {
          "id": "wireflow-index",
          "renderer": "wireflow-index"
        },
        {
          "id": "interactions-markdown",
          "renderer": "interactions-markdown"
        }
      ]
    },
    {
      "id": "canonical-ui-prototype",
      "stage": "product-design",
      "domain": "product-design",
      "authorityKind": "area-set",
      "format": "typescript",
      "contract": ".agents/skills/product-design/canonical-ui-prototype/contract.yaml",
      "schema": ".agents/skills/product-design/canonical-ui-prototype/schema.json",
      "projector": "render-product"
    },
    {
      "id": "architecture-package",
      "stage": "architecture-design",
      "domain": "architecture-design",
      "authorityKind": "internal-model",
      "format": "yaml",
      "contract": ".agents/skills/architecture-design/architecture-package/contract.yaml",
      "schema": ".agents/skills/architecture-design/architecture-package/schema.json",
      "template": ".agents/skills/architecture-design/architecture-package/template.yaml",
      "renderer": "architecture-package-markdown"
    },
    {
      "id": "system-boundary",
      "stage": "architecture-design",
      "domain": "architecture-design",
      "authorityKind": "internal-model",
      "format": "yaml",
      "contract": ".agents/skills/architecture-design/system-boundary/contract.yaml",
      "schema": ".agents/skills/architecture-design/system-boundary/schema.json",
      "template": ".agents/skills/architecture-design/system-boundary/template.yaml",
      "renderer": "system-boundary-markdown"
    },
    {
      "id": "conceptual-model",
      "stage": "architecture-design",
      "domain": "architecture-design",
      "authorityKind": "internal-model",
      "format": "yaml",
      "contract": ".agents/skills/architecture-design/conceptual-model/contract.yaml",
      "schema": ".agents/skills/architecture-design/conceptual-model/schema.json",
      "template": ".agents/skills/architecture-design/conceptual-model/template.yaml",
      "renderer": "conceptual-model-markdown"
    },
    {
      "id": "technical-validation",
      "stage": "architecture-design",
      "domain": "architecture-design",
      "authorityKind": "internal-model",
      "format": "yaml",
      "contract": ".agents/skills/architecture-design/technical-validation/contract.yaml",
      "schema": ".agents/skills/architecture-design/technical-validation/schema.json",
      "template": ".agents/skills/architecture-design/technical-validation/template.yaml",
      "renderer": "technical-validation-markdown"
    }
  ],
  "operations": [
    {
      "id": "initialize-workspace",
      "kind": "workspace",
      "npmScript": "init:workspace",
      "run": "npm run init:workspace",
      "executor": {
        "kind": "module",
        "path": ".psp/harness/scripts/init-workspace.mjs"
      }
    },
    {
      "id": "initialize-product",
      "kind": "stage",
      "npmScript": "init:product",
      "run": "npm run init:product",
      "executor": {
        "kind": "module",
        "path": ".psp/harness/scripts/initialize-stage.mjs",
        "args": [
          "--operation",
          "initialize-product"
        ]
      },
      "stage": "product-design",
      "fromState": "uninitialized",
      "toState": "active",
      "areaTemplates": {},
      "commands": [
        "render-product",
        "product-structure"
      ]
    },
    {
      "id": "initialize-architecture",
      "kind": "stage",
      "npmScript": "init:architecture",
      "run": "npm run init:architecture",
      "executor": {
        "kind": "module",
        "path": ".psp/harness/scripts/initialize-stage.mjs",
        "args": [
          "--operation",
          "initialize-architecture"
        ]
      },
      "stage": "architecture-design",
      "fromState": "uninitialized",
      "toState": "active",
      "areaTemplates": {
        "technical-validation": ".agents/skills/architecture-design/technical-validation/template-area"
      },
      "commands": [
        "render-architecture",
        "architecture-structure"
      ],
      "upstreamScopes": [
        "use-cases"
      ]
    },
    {
      "id": "apply-product-artifact",
      "kind": "artifact",
      "npmScript": "apply:product-artifact",
      "run": "npm run apply:product-artifact",
      "executor": {
        "kind": "module",
        "path": ".agents/skills/product-design/scripts/apply-artifact.mjs",
        "args": [
          "--operation",
          "apply-product-artifact"
        ]
      },
      "domain": "product-design",
      "stage": "product-design",
      "artifacts": [
        "capabilities",
        "interactions"
      ]
    },
    {
      "id": "apply-architecture-artifact",
      "kind": "artifact",
      "npmScript": "apply:architecture-artifact",
      "run": "npm run apply:architecture-artifact",
      "executor": {
        "kind": "module",
        "path": ".agents/skills/architecture-design/scripts/apply-artifact.mjs",
        "args": [
          "--operation",
          "apply-architecture-artifact"
        ]
      },
      "domain": "architecture-design",
      "stage": "architecture-design",
      "artifacts": [
        "architecture-package",
        "system-boundary",
        "conceptual-model",
        "technical-validation"
      ]
    },
    {
      "id": "canonical-ui-repair",
      "kind": "repair",
      "npmScript": "repair:canonical-ui",
      "run": "npm run repair:canonical-ui",
      "executor": {
        "kind": "module",
        "path": ".agents/skills/product-design/canonical-ui-prototype/scripts/repair.mjs",
        "args": [
          "--json"
        ]
      },
      "domain": "product-design",
      "stage": "product-design",
      "artifact": "canonical-ui-prototype"
    },
    {
      "id": "handoff",
      "kind": "handoff",
      "npmScript": "handoff",
      "run": "npm run handoff",
      "executor": {
        "kind": "module",
        "path": ".psp/harness/scripts/run-handoff.mjs"
      }
    }
  ],
  "commands": [
    {
      "id": "harness",
      "npmScript": "validate:harness",
      "run": "npm run validate:harness",
      "purpose": "校验 Harness、项目绑定、Contract、Codex 接入与 resolver",
      "blocking": true,
      "executor": {
        "kind": "module",
        "path": ".psp/harness/scripts/validate-harness.mjs"
      }
    },
    {
      "id": "workspace-structure",
      "npmScript": "validate:workspace",
      "run": "npm run validate:workspace",
      "purpose": "校验纯脚手架目录骨架、阶段空状态和用户实例隔离",
      "blocking": true,
      "executor": {
        "kind": "module",
        "path": ".psp/harness/scripts/init-workspace.mjs",
        "args": [
          "--dry-run"
        ]
      }
    },
    {
      "id": "test-harness",
      "npmScript": "test:harness",
      "run": "npm run test:harness",
      "purpose": "运行 Harness contract tests",
      "blocking": true,
      "executor": {
        "kind": "node-test",
        "paths": [
          ".psp/harness/tests/harness/*.test.mjs"
        ]
      }
    },
    {
      "id": "test-product",
      "npmScript": "test:product",
      "run": "npm run test:product",
      "purpose": "运行 Product Design Domain contract tests",
      "blocking": true,
      "domain": "product-design",
      "executor": {
        "kind": "node-test",
        "paths": [
          ".agents/skills/product-design/tests/*.test.mjs"
        ]
      }
    },
    {
      "id": "product-structure",
      "npmScript": "validate:product",
      "run": "npm run validate:product",
      "purpose": "校验产品领域结构、语义引用和投影一致性，允许显式 draft gap",
      "blocking": true,
      "domain": "product-design",
      "executor": {
        "kind": "module",
        "path": ".agents/skills/product-design/scripts/validate.mjs"
      }
    },
    {
      "id": "product-strict",
      "npmScript": "validate:product:strict",
      "run": "npm run validate:product:strict",
      "purpose": "校验完整产品设计是否达到确定移交条件",
      "blocking": true,
      "domain": "product-design",
      "executor": {
        "kind": "module",
        "path": ".agents/skills/product-design/scripts/validate.mjs",
        "args": [
          "--strict"
        ]
      }
    },
    {
      "id": "use-cases-strict",
      "npmScript": "validate:use-cases",
      "run": "npm run validate:use-cases",
      "purpose": "校验 Use Cases 是否可移交给 Wireflow",
      "blocking": true,
      "domain": "product-design",
      "executor": {
        "kind": "module",
        "path": ".agents/skills/product-design/scripts/validate.mjs",
        "args": [
          "--step",
          "use-cases"
        ]
      }
    },
    {
      "id": "wireflow-strict",
      "npmScript": "validate:wireflow",
      "run": "npm run validate:wireflow",
      "purpose": "校验按参与者拆分的 Wireflow 集合、全局标识与 Use Case 覆盖是否可移交给独立 Canonical UI 应用",
      "blocking": true,
      "domain": "product-design",
      "executor": {
        "kind": "module",
        "path": ".agents/skills/product-design/scripts/validate.mjs",
        "args": [
          "--step",
          "wireflow"
        ]
      }
    },
    {
      "id": "canonical-ui-input",
      "npmScript": "validate:canonical-ui-input",
      "run": "npm run validate:canonical-ui-input",
      "purpose": "校验 Canonical UI Prototype 上游输入、设计来源证据清单、内容哈希与覆盖关系",
      "blocking": true,
      "domain": "product-design",
      "executor": {
        "kind": "module",
        "path": ".agents/skills/product-design/canonical-ui-prototype/scripts/validate-input.mjs"
      }
    },
    {
      "id": "canonical-ui-typecheck",
      "npmScript": "typecheck",
      "run": "npm run typecheck",
      "purpose": "逐个校验参与者 Canonical UI 独立应用的 TypeScript",
      "blocking": true,
      "domain": "product-design",
      "executor": {
        "kind": "module",
        "path": ".agents/skills/product-design/canonical-ui-prototype/scripts/runtime.mjs",
        "args": [
          "--capability",
          "typecheck"
        ]
      }
    },
    {
      "id": "canonical-ui-build",
      "npmScript": "workspace:build",
      "run": "npm run workspace:build",
      "purpose": "逐个构建参与者 Canonical UI 独立应用",
      "blocking": true,
      "domain": "product-design",
      "executor": {
        "kind": "module",
        "path": ".agents/skills/product-design/canonical-ui-prototype/scripts/runtime.mjs",
        "args": [
          "--capability",
          "build"
        ]
      }
    },
    {
      "id": "canonical-ui-runtime",
      "npmScript": "validate:canonical-ui-runtime",
      "run": "npm run validate:canonical-ui-runtime",
      "purpose": "逐个验证参与者 Canonical UI 独立应用的路由、交互、视口、网络、控制台、资源、视觉断言与无障碍要求",
      "blocking": true,
      "domain": "product-design",
      "executor": {
        "kind": "module",
        "path": ".agents/skills/product-design/canonical-ui-prototype/scripts/validate-runtime.mjs"
      }
    },
    {
      "id": "test-architecture",
      "npmScript": "test:architecture",
      "run": "npm run test:architecture",
      "purpose": "运行 Architecture Design Domain contract tests",
      "blocking": true,
      "domain": "architecture-design",
      "executor": {
        "kind": "node-test",
        "paths": [
          ".agents/skills/architecture-design/tests/*.test.mjs"
        ]
      }
    },
    {
      "id": "architecture-structure",
      "npmScript": "validate:architecture",
      "run": "npm run validate:architecture",
      "purpose": "校验架构领域结构、上游引用和生成一致性",
      "blocking": true,
      "domain": "architecture-design",
      "executor": {
        "kind": "module",
        "path": ".agents/skills/architecture-design/scripts/validate.mjs"
      }
    },
    {
      "id": "architecture-strict",
      "npmScript": "validate:architecture:strict",
      "run": "npm run validate:architecture:strict",
      "purpose": "校验架构产物是否达到当前工作区的严格交付状态",
      "blocking": true,
      "domain": "architecture-design",
      "executor": {
        "kind": "module",
        "path": ".agents/skills/architecture-design/scripts/validate.mjs",
        "args": [
          "--strict"
        ]
      }
    },
    {
      "id": "canonical-ui-dev",
      "npmScript": "dev",
      "run": "npm run dev",
      "purpose": "用 --actor ACTOR-NNN 启动一个参与者 Canonical UI 独立应用并输出带不一致标记工具的实际 HTTP 评审地址，不以前置视觉修复或正式就绪为条件",
      "blocking": true,
      "domain": "product-design",
      "executor": {
        "kind": "module",
        "path": ".agents/skills/product-design/canonical-ui-prototype/scripts/runtime.mjs",
        "args": [
          "--capability",
          "dev"
        ]
      }
    },
    {
      "id": "canonical-ui-install-browser",
      "npmScript": "install:browser",
      "run": "npm run install:browser",
      "purpose": "安装 Canonical UI Prototype 浏览器验证运行时",
      "blocking": true,
      "domain": "product-design",
      "executor": {
        "kind": "module",
        "path": ".agents/skills/product-design/canonical-ui-prototype/scripts/runtime.mjs",
        "args": [
          "--capability",
          "install-browser"
        ]
      }
    },
    {
      "id": "render-product",
      "npmScript": "render:product",
      "run": "npm run render:product",
      "purpose": "由产品领域能力生成产品投影",
      "blocking": true,
      "domain": "product-design",
      "executor": {
        "kind": "module",
        "path": ".agents/skills/product-design/scripts/render.mjs"
      }
    },
    {
      "id": "render-architecture",
      "npmScript": "render:architecture",
      "run": "npm run render:architecture",
      "purpose": "由架构领域能力生成架构投影",
      "blocking": true,
      "domain": "architecture-design",
      "executor": {
        "kind": "module",
        "path": ".agents/skills/architecture-design/scripts/render.mjs"
      }
    },
    {
      "id": "check-product-outputs",
      "npmScript": "check:outputs",
      "run": "npm run check:outputs",
      "purpose": "检查产品投影漂移",
      "blocking": true,
      "domain": "product-design",
      "executor": {
        "kind": "module",
        "path": ".agents/skills/product-design/scripts/render.mjs",
        "args": [
          "--check"
        ]
      }
    },
    {
      "id": "check-architecture-outputs",
      "npmScript": "check:architecture-outputs",
      "run": "npm run check:architecture-outputs",
      "purpose": "检查架构投影漂移",
      "blocking": true,
      "domain": "architecture-design",
      "executor": {
        "kind": "module",
        "path": ".agents/skills/architecture-design/scripts/render.mjs",
        "args": [
          "--check"
        ]
      }
    },
    {
      "id": "verify-architecture",
      "npmScript": "verify:architecture",
      "run": "npm run verify:architecture",
      "purpose": "运行绑定的架构技术验证脚本",
      "blocking": true,
      "executor": {
        "kind": "area-script",
        "area": "technical-validation",
        "script": "verify"
      },
      "domain": "architecture-design"
    },
    {
      "id": "architecture-system-boundary",
      "npmScript": "validate:system-boundary",
      "run": "npm run validate:system-boundary",
      "purpose": "校验 System Boundary 是否达到独立 readiness",
      "blocking": true,
      "domain": "architecture-design",
      "executor": {
        "kind": "module",
        "path": ".agents/skills/architecture-design/scripts/validate.mjs",
        "args": [
          "--step",
          "system-boundary"
        ]
      }
    },
    {
      "id": "architecture-conceptual-model",
      "npmScript": "validate:conceptual-model",
      "run": "npm run validate:conceptual-model",
      "purpose": "校验 Conceptual Model 是否达到独立 readiness",
      "blocking": true,
      "domain": "architecture-design",
      "executor": {
        "kind": "module",
        "path": ".agents/skills/architecture-design/scripts/validate.mjs",
        "args": [
          "--step",
          "conceptual-model"
        ]
      }
    },
    {
      "id": "architecture-technical-validation",
      "npmScript": "validate:technical-validation",
      "run": "npm run validate:technical-validation",
      "purpose": "校验 Technical Validation 是否达到独立 readiness",
      "blocking": true,
      "domain": "architecture-design",
      "executor": {
        "kind": "module",
        "path": ".agents/skills/architecture-design/scripts/validate.mjs",
        "args": [
          "--step",
          "technical-validation"
        ]
      }
    },
    {
      "id": "architecture-package-readiness",
      "npmScript": "validate:architecture-package",
      "run": "npm run validate:architecture-package",
      "purpose": "校验 Architecture Overview 是否达到独立 readiness",
      "blocking": true,
      "domain": "architecture-design",
      "executor": {
        "kind": "module",
        "path": ".agents/skills/architecture-design/scripts/validate.mjs",
        "args": [
          "--step",
          "architecture-package"
        ]
      }
    },
    {
      "id": "harness-resolve",
      "npmScript": "harness:resolve",
      "run": "npm run harness:resolve",
      "purpose": "解析变更路径对应的 Scope 与 Profile",
      "blocking": true,
      "executor": {
        "kind": "module",
        "path": ".psp/harness/scripts/resolve-validation.mjs"
      }
    }
  ],

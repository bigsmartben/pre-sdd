{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psp.dev/schemas/project.schema.json",
  "title": "PSP Project Binding",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "harness", "stages"],
  "properties": {
    "apiVersion": {"const": "psp.dev/v1"},
    "kind": {"const": "PSPProject"},
    "harness": {"type": "object", "additionalProperties": false, "required": ["manifest"], "properties": {"manifest": {"$ref": "#/$defs/path"}}},
    "stages": {"type": "object", "minProperties": 1, "propertyNames": {"$ref": "#/$defs/identifier"}, "additionalProperties": {"$ref": "#/$defs/stage"}}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "blockerCode": {"type": "string", "pattern": "^AIH_[A-Z0-9_]+$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[*!?\\[\\]{}]).+$"},
    "internalModelPath": {"allOf": [{"$ref": "#/$defs/path"}, {"type": "string", "pattern": "^\\.psp/models/.+\\.(yaml|json)$"}]},
    "projection": {"type": "object", "additionalProperties": false, "required": ["path", "role"], "properties": {"path": {"$ref": "#/$defs/path"}, "role": {"enum": ["user-artifact", "generated-support"]}, "projection": {"$ref": "#/$defs/identifier"}}, "allOf": [{"if": {"properties": {"role": {"const": "user-artifact"}}}, "then": {"properties": {"path": {"type": "string", "pattern": "\\.md$"}}}}, {"if": {"properties": {"role": {"const": "generated-support"}}}, "then": {"properties": {"path": {"type": "string", "pattern": "^\\.psp/models/"}}}}]},
    "artifactBinding": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["internalModel", "outputs"], "properties": {"inputRoot": {"$ref": "#/$defs/path"}, "internalModel": {"$ref": "#/$defs/internalModelPath"}, "outputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/projection"}}}},
      {"type": "object", "additionalProperties": false, "required": ["authority", "projections"], "properties": {"authority": {"type": "object", "additionalProperties": false, "required": ["kind", "area", "semanticEntry"], "properties": {"kind": {"const": "area"}, "area": {"$ref": "#/$defs/identifier"}, "semanticEntry": {"$ref": "#/$defs/path"}}}, "projections": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/projection"}}}}
    ]},
    "areaBinding": {"type": "object", "additionalProperties": false, "required": ["root"], "properties": {"root": {"$ref": "#/$defs/path"}}},
    "availableStage": {"type": "object", "additionalProperties": false, "required": ["status", "root", "artifacts"], "properties": {"status": {"enum": ["active", "uninitialized"]}, "root": {"$ref": "#/$defs/path"}, "artifacts": {"type": "object", "minProperties": 1, "propertyNames": {"$ref": "#/$defs/identifier"}, "additionalProperties": {"$ref": "#/$defs/artifactBinding"}}, "areas": {"type": "object", "propertyNames": {"$ref": "#/$defs/identifier"}, "additionalProperties": {"$ref": "#/$defs/areaBinding"}}}},
    "unavailableStage": {"type": "object", "additionalProperties": false, "required": ["status", "root", "blockerCode"], "properties": {"status": {"const": "unavailable"}, "root": {"$ref": "#/$defs/path"}, "blockerCode": {"$ref": "#/$defs/blockerCode"}}},
    "stage": {"oneOf": [{"$ref": "#/$defs/availableStage"}, {"$ref": "#/$defs/unavailableStage"}]}
  }
}

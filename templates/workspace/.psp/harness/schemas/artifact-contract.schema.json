{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psp.dev/schemas/artifact-contract.schema.json",
  "title": "PSP Artifact Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "psp.dev/v1"},
    "kind": {"const": "ArtifactContract"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "internalModelFormat", "outputRole", "purpose", "owns", "excludes", "domainRules", "readiness"],
      "properties": {
        "stage": {"$ref": "#/$defs/identifier"},
        "internalModelFormat": {"enum": ["yaml", "json", "typescript"]},
        "outputRole": {"enum": ["user-artifact", "generated-support"]},
        "purpose": {"type": "string", "minLength": 1},
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifacts", "directoryRole"],
          "properties": {
            "artifacts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
            "directoryRole": {"const": "supporting-input"}
          }
        },
        "owns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "excludes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "domainRules": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "projections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "outputRole", "readOnly", "sources"],
            "properties": {
              "id": {"$ref": "#/$defs/identifier"},
              "outputRole": {"enum": ["user-artifact", "generated-support"]},
              "readOnly": {"const": true},
              "sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            }
          }
        },
        "visualParity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["channelTolerance", "maxDifferentPixelRatio"],
          "properties": {
            "channelTolerance": {"type": "integer", "minimum": 0, "maximum": 255},
            "maxDifferentPixelRatio": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "repair": {
          "type": "object",
          "additionalProperties": false,
          "required": ["orchestrator", "validatorRole", "maxAttempts", "packetSchema", "implementationPolicy"],
          "properties": {
            "orchestrator": {"const": "agent"},
            "validatorRole": {"const": "decision-and-evidence-only"},
            "maxAttempts": {"const": 3},
            "packetSchema": {"type": "string", "minLength": 1},
            "implementationPolicy": {"$ref": "#/$defs/visualRepairImplementationPolicy"}
          }
        },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requiredStatus", "requireNoGaps", "requireAllGates"],
          "properties": {
            "requiredStatus": {"enum": ["ready", "not-applicable"]},
            "requireNoGaps": {"type": "boolean"},
            "requireAllGates": {"type": "boolean"}
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "visualRepairImplementationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceBeforeEdit",
        "requireSourceResolution",
        "preserveInteractiveDom",
        "preferSourceAssets",
        "allowSubjectiveApproximation",
        "minimalImplementationScope",
        "stableComparisonEnvironment",
        "fixOrder"
      ],
      "properties": {
        "evidenceBeforeEdit": {"const": true},
        "requireSourceResolution": {"const": true},
        "preserveInteractiveDom": {"const": true},
        "preferSourceAssets": {"const": true},
        "allowSubjectiveApproximation": {"const": false},
        "minimalImplementationScope": {"const": true},
        "stableComparisonEnvironment": {"const": true},
        "fixOrder": {"const": ["source-resolution", "structure", "geometry", "typography", "paint", "effects", "assets"]}
      }
    }
  }
}

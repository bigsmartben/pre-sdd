{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psp.dev/schemas/v3/consistency-report.schema.json",
  "title": "Harness Standard v3 Consistency Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "status", "scope", "dependencies", "diagnostics", "acceptedRisks", "suggestedOperations", "changes", "validation", "residuals", "sideEffects", "handoff"],
  "properties": {
    "protocol": {"const": "pre-sdd-harness/v3"},
    "status": {"$ref": "#/$defs/state"},
    "mode": {"enum": ["scoped", "full-project"]},
    "scope": {"$ref": "#/$defs/scope"},
    "dependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}},
    "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
    "acceptedRisks": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "suggestedOperations": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "changes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/dependency"}},
    "impact": {"$ref": "#/$defs/impact"},
    "validation": {"type": "array", "items": {"$ref": "#/$defs/validation"}},
    "residuals": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
    "optionalActions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "sideEffects": {"$ref": "#/$defs/sideEffects"},
    "handoff": {"const": "NOT_RUN"},
    "initialization": {"const": "NOT_RUN"},
    "publication": {"const": "NOT_RUN"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "state": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"]},
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "pattern": "^AIH_[A-Z0-9_]+$"},
        "message": {"type": "string", "minLength": 1},
        "location": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "node": {"$ref": "#/$defs/identifier"},
        "gateClass": {"enum": ["safety-structure", "domain-diagnostic", "ci-cd-policy"]}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "selected"],
      "properties": {
        "requested": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "selected": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "topologicalOrder": {"type": "array", "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true}
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "status"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "type": {"const": "dependency"},
        "status": {"$ref": "#/$defs/state"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
        "contractInputs": {"type": "array", "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true},
        "impact": {"type": "array", "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true},
        "optionalActions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "command": {"type": ["string", "null"]},
        "status": {"$ref": "#/$defs/state"},
        "blockers": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}}
      }
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validator", "command", "status", "blockers", "warnings"],
      "properties": {
        "validator": {"type": ["string", "null"]},
        "command": {"type": ["string", "null"]},
        "status": {"$ref": "#/$defs/state"},
        "blockers": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
        "warnings": {"type": "array", "items": {"oneOf": [{"type": "string"}, {"$ref": "#/$defs/diagnostic"}]}}
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "contract", "inputArtifacts"],
      "properties": {
        "artifact": {"$ref": "#/$defs/identifier"},
        "contract": {"type": "string", "minLength": 1},
        "inputArtifacts": {"type": "array", "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true},
        "blocker": {"$ref": "#/$defs/diagnostic"}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "stage", "status", "validators", "contracts", "evidence", "impact", "optionalActions"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "kind": {"enum": ["stage", "artifact"]},
        "stage": {"$ref": "#/$defs/identifier"},
        "status": {"$ref": "#/$defs/state"},
        "validators": {"type": "array", "items": {"$ref": "#/$defs/validator"}},
        "contracts": {"type": "array", "items": {"$ref": "#/$defs/contract"}},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
        "impact": {"type": "array", "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true},
        "optionalActions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "affectedNodes", "affectedEdges"],
      "properties": {
        "requested": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "affectedNodes": {"type": "array", "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true},
        "affectedEdges": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9-]+->[a-z0-9-]+$"}, "uniqueItems": true}
      }
    },
    "sideEffects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "changedPaths"],
      "properties": {
        "status": {"$ref": "#/$defs/state"},
        "changedPaths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psp.dev/schemas/v3/handoff-receipt.schema.json",
  "title": "Harness Standard v3 Handoff Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "standardVersion", "id", "from", "to", "dependencyClosure", "profile", "source", "validation", "decision", "receipt", "downstreamAction", "integrity"],
  "properties": {
    "protocol": {"const": "pre-sdd-harness/v3"},
    "standardVersion": {"$ref": "#/$defs/version"},
    "id": {"type": "string", "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"},
    "from": {"$ref": "#/$defs/identifier"},
    "to": {"$ref": "#/$defs/identifier"},
    "dependencyClosure": {"type": "array", "items": {"$ref": "#/$defs/identifier"}, "minItems": 1, "uniqueItems": true},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "version": {"$ref": "#/$defs/version"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "digest", "paths"],
      "properties": {
        "version": {"$ref": "#/$defs/version"},
        "digest": {"$ref": "#/$defs/digest"},
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {"$ref": "#/$defs/path"},
              "sha256": {"$ref": "#/$defs/digest"}
            }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "commands", "blockers"],
      "properties": {
        "status": {"$ref": "#/$defs/validationState"},
        "commands": {"type": "array", "items": {"$ref": "#/$defs/commandEvidence"}},
        "blockers": {"type": "array", "items": {"$ref": "#/$defs/blocker"}}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "actor", "confirmedAt", "acceptedRisks"],
      "properties": {
        "status": {"const": "CONFIRMED"},
        "actor": {"type": "string", "minLength": 1, "maxLength": 256},
        "confirmedAt": {"$ref": "#/$defs/dateTime"},
        "acceptedRisks": {"type": "array", "items": {"$ref": "#/$defs/blockerCode"}, "uniqueItems": true}
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "createdAt", "revokedAt", "revokeReason"],
      "properties": {
        "status": {"enum": ["VALID", "STALE", "REVOKED", "INVALID"]},
        "createdAt": {"$ref": "#/$defs/dateTime"},
        "revokedAt": {"oneOf": [{"$ref": "#/$defs/dateTime"}, {"type": "null"}]},
        "revokeReason": {"type": ["string", "null"]},
        "revokedBy": {"type": "string", "minLength": 1, "maxLength": 256}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "REVOKED"}}},
          "then": {
            "required": ["revokedBy"],
            "properties": {
              "revokedBy": {"type": "string", "minLength": 1, "maxLength": 256},
              "revokedAt": {"$ref": "#/$defs/dateTime"},
              "revokeReason": {"type": "string", "minLength": 1}
            }
          },
          "else": {
            "properties": {
              "revokedAt": {"type": "null"},
              "revokeReason": {"type": "null"}
            }
          }
        }
      ]
    },
    "downstreamAction": {"const": "NOT_RUN"},
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:|/|.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "dateTime": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$"},
    "validationState": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"]},
    "blockerCode": {"type": "string", "pattern": "^AIH_[A-Z0-9_]+$"},
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "gateClass", "source"],
      "properties": {
        "code": {"$ref": "#/$defs/blockerCode"},
        "message": {"type": "string", "minLength": 1},
        "gateClass": {"enum": ["safety-structure", "domain-diagnostic", "ci-cd-policy"]},
        "source": {"type": "string", "minLength": 1}
      }
    },
    "commandEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command", "status", "blockers", "durationMs"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "command": {"type": ["string", "null"]},
        "status": {"$ref": "#/$defs/validationState"},
        "exitCode": {"type": "integer"},
        "startedAt": {"$ref": "#/$defs/dateTime"},
        "finishedAt": {"$ref": "#/$defs/dateTime"},
        "durationMs": {"type": "integer", "minimum": 0},
        "blockers": {"type": "array", "items": {"$ref": "#/$defs/blockerCode"}, "uniqueItems": true},
        "stdout": {"type": "string"},
        "stderr": {"type": "string"}
      }
    }
  }
}

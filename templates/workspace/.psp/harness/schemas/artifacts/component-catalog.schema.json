{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psp.dev/schemas/artifacts/component-catalog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "components", "gates", "gaps"],
  "properties": {
    "apiVersion": {"const": "psp.dev/v1"},
    "kind": {"const": "ComponentCatalog"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "htmlMocks", "responsibility", "inputs", "outputs", "states", "variants", "accessibility", "prototype"],
        "properties": {
          "id": {"type": "string", "pattern": "^COMPONENT-[0-9]{3}$"},
          "htmlMocks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^HTML-MOCK-[0-9]{3}$"}},
          "responsibility": {"type": "string", "minLength": 1},
          "inputs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "outputs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "states": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "variants": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "accessibility": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "prototype": {"type": "string", "minLength": 1}
        }
      }
    },
    "gates": {"$ref": "#/$defs/gates"},
    "gaps": {"$ref": "#/$defs/gaps"}
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "version", "upstreamArtifact"],
      "properties": {
        "status": {"enum": ["draft", "ready"]},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "upstreamArtifact": {"const": "ui-spec"}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "checked"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "label": {"type": "string", "minLength": 1},
        "checked": {"type": "boolean"}
      }
    },
    "gates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/gate"}},
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "field", "reason"],
      "properties": {
        "id": {"type": "string", "pattern": "^GAP-[0-9]{3}$"},
        "field": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psp.dev/schemas/artifacts/traceability.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "links"],
  "properties": {
    "$schema": {"const": "https://psp.dev/schemas/artifacts/traceability.schema.json"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["useCase", "wireflows", "htmlMocks"],
        "properties": {
          "useCase": {"type": "string", "pattern": "^UC-[0-9]{3}$"},
          "wireflows": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^WF-[0-9]{3}$"}},
          "htmlMocks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^HTML-MOCK-[0-9]{3}$"}}
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psp.dev/schemas/artifacts/ui-spec.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion", "kind", "metadata", "designSources", "assetBindings", "htmlMocks", "interactionScenarios", "visualRules",
    "mockBehaviors", "viewports", "accessibility", "gates", "gaps"
  ],
  "properties": {
    "apiVersion": {"const": "psp.dev/v1"},
    "kind": {"const": "HTMLMockSpecification"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "designSources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "location", "nodeId", "scope", "status", "evidence"],
        "properties": {
          "id": {"$ref": "#/$defs/designSourceId"},
          "type": {"enum": ["figma", "image", "export"]},
          "location": {"type": "string", "minLength": 1},
          "nodeId": {"$ref": "#/$defs/nullableText"},
          "scope": {"type": "string", "minLength": 1},
          "status": {"enum": ["available", "partial", "blocked"]},
          "evidence": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sourceEvidence"}]}
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "available"}}, "required": ["status"]},
            "then": {"properties": {"evidence": {"$ref": "#/$defs/sourceEvidence"}}}
          },
          {
            "if": {"properties": {"type": {"const": "figma"}}, "required": ["type"]},
            "then": {
              "properties": {
                "location": {"type": "string", "pattern": "^https://([A-Za-z0-9-]+\\.)*figma\\.com/(design|file|proto)/.+"},
                "nodeId": {"type": "string", "minLength": 1}
              }
            }
          }
        ]
      }
    },
    "assetBindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "source", "sourceNode", "localPath", "htmlMocks", "usages", "status"],
        "properties": {
          "id": {"$ref": "#/$defs/assetBindingId"},
          "kind": {"enum": ["image", "icon", "logo", "illustration", "font", "other"]},
          "source": {"$ref": "#/$defs/designSourceId"},
          "sourceNode": {"$ref": "#/$defs/nullableText"},
          "localPath": {"$ref": "#/$defs/nullableText"},
          "htmlMocks": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/htmlMockId"}
          },
          "usages": {
            "type": "array",
            "items": {"$ref": "#/$defs/assetUsage"}
          },
          "status": {"enum": ["localized", "blocked", "out-of-scope"]}
        },
        "allOf": [{
          "if": {"properties": {"status": {"const": "localized"}}, "required": ["status"]},
          "then": {
            "properties": {
              "localPath": {"type": "string", "minLength": 1},
              "usages": {"type": "array", "minItems": 1}
            }
          }
        }]
      }
    },
    "htmlMocks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "useCases", "wireflows", "designSources", "entry", "route", "screens", "components"],
        "properties": {
          "id": {"$ref": "#/$defs/htmlMockId"},
          "name": {"type": "string", "minLength": 1},
          "useCases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/useCaseId"}},
          "wireflows": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/wireflowId"}},
          "designSources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/designSourceId"}},
          "entry": {"type": "string", "minLength": 1},
          "route": {"type": "string", "minLength": 1},
          "screens": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["screen", "selector", "purpose"],
              "properties": {
                "screen": {"$ref": "#/$defs/screenId"},
                "selector": {"type": "string", "minLength": 1},
                "purpose": {"type": "string", "minLength": 1}
              }
            }
          },
          "components": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/componentId"}}
        }
      }
    },
    "interactionScenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "htmlMock", "wireflow", "ucScenario", "name", "startRoute", "steps"],
        "properties": {
          "id": {"$ref": "#/$defs/htmlScenarioId"},
          "htmlMock": {"$ref": "#/$defs/htmlMockId"},
          "wireflow": {"$ref": "#/$defs/wireflowId"},
          "ucScenario": {"oneOf": [{"const": "main"}, {"$ref": "#/$defs/useCaseScenarioId"}]},
          "name": {"type": "string", "minLength": 1},
          "startRoute": {"type": "string", "minLength": 1},
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "action", "target", "input", "expectedScreen", "expectedState", "expectedFeedback"],
              "properties": {
                "id": {"$ref": "#/$defs/htmlStepId"},
                "action": {"enum": ["click", "fill", "select", "press", "check", "uncheck"]},
                "target": {"type": "string", "minLength": 1},
                "input": {"$ref": "#/$defs/nullableText"},
                "expectedScreen": {"$ref": "#/$defs/screenId"},
                "expectedState": {"$ref": "#/$defs/stateId"},
                "expectedFeedback": {"type": "string", "minLength": 1}
              },
              "allOf": [{
                "if": {"properties": {"action": {"enum": ["fill", "select", "press"]}}, "required": ["action"]},
                "then": {"properties": {"input": {"type": "string", "minLength": 1}}}
              }]
            }
          }
        }
      }
    },
    "visualRules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scope", "specification", "intent", "sourceRefs"],
        "properties": {
          "id": {"type": "string", "pattern": "^VISUAL-RULE-[0-9]{3}$"},
          "scope": {"type": "string", "minLength": 1},
          "specification": {"type": "string", "minLength": 1},
          "intent": {"type": "string", "minLength": 1},
          "sourceRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/designSourceId"}}
        }
      }
    },
    "mockBehaviors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scenario", "trigger", "fixture", "latencyMs", "resultState"],
        "properties": {
          "id": {"type": "string", "pattern": "^MOCK-BEHAVIOR-[0-9]{3}$"},
          "scenario": {"$ref": "#/$defs/htmlScenarioId"},
          "trigger": {"type": "string", "minLength": 1},
          "fixture": {"type": "string", "minLength": 1},
          "latencyMs": {"type": "integer", "minimum": 0},
          "resultState": {"$ref": "#/$defs/stateId"}
        }
      }
    },
    "viewports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "width", "height", "required"],
        "properties": {
          "id": {"type": "string", "pattern": "^VIEWPORT-[0-9]{3}$"},
          "name": {"type": "string", "minLength": 1},
          "width": {"type": "integer", "minimum": 240},
          "height": {"type": "integer", "minimum": 240},
          "required": {"type": "boolean"}
        }
      }
    },
    "accessibility": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "requirement", "verification"],
        "properties": {
          "id": {"type": "string", "pattern": "^A11Y-[0-9]{3}$"},
          "requirement": {"type": "string", "minLength": 1},
          "verification": {"type": "string", "minLength": 1}
        }
      }
    },
    "gates": {"$ref": "#/$defs/gates"},
    "gaps": {"$ref": "#/$defs/gaps"}
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "version", "upstreamArtifact"],
      "properties": {
        "status": {"enum": ["draft", "ready"]},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "upstreamArtifact": {"const": "interactions"}
      }
    },
    "nullableText": {"type": ["string", "null"], "minLength": 1},
    "useCaseId": {"type": "string", "pattern": "^UC-[0-9]{3}$"},
    "useCaseScenarioId": {"type": "string", "pattern": "^UC-[0-9]{3}-(ALT|EXC)-[0-9]{2}$"},
    "wireflowId": {"type": "string", "pattern": "^WF-[0-9]{3}$"},
    "screenId": {"type": "string", "pattern": "^SCREEN-[0-9]{3}$"},
    "stateId": {"type": "string", "pattern": "^WF-STATE-[0-9]{3}$"},
    "componentId": {"type": "string", "pattern": "^COMPONENT-[0-9]{3}$"},
    "designSourceId": {"type": "string", "pattern": "^DESIGN-SOURCE-[0-9]{3}$"},
    "assetBindingId": {"type": "string", "pattern": "^ASSET-BINDING-[0-9]{3}$"},
    "htmlMockId": {"type": "string", "pattern": "^HTML-MOCK-[0-9]{3}$"},
    "htmlScenarioId": {"type": "string", "pattern": "^HTML-SCENARIO-[0-9]{3}$"},
    "htmlStepId": {"type": "string", "pattern": "^HTML-STEP-[0-9]{3}$"},
    "sourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "capturedAt"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "capturedAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
      }
    },
    "assetUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["htmlMock", "scenario", "entry", "reference", "selector"],
      "properties": {
        "htmlMock": {"$ref": "#/$defs/htmlMockId"},
        "scenario": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/htmlScenarioId"}]},
        "entry": {"type": "string", "minLength": 1},
        "reference": {"type": "string", "minLength": 1},
        "selector": {"type": "string", "minLength": 1}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "checked"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "label": {"type": "string", "minLength": 1},
        "checked": {"type": "boolean"}
      }
    },
    "gates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/gate"}},
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "field", "reason"],
      "properties": {
        "id": {"type": "string", "pattern": "^GAP-[0-9]{3}$"},
        "field": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}}
  }
}

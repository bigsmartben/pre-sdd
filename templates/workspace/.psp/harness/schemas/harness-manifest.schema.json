{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psp.dev/schemas/harness-manifest.schema.json",
  "title": "PSP Repository Harness Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "name", "version", "standard", "runtime", "entrypoints", "schemas", "codex", "readOrder", "domainRegistry", "artifactRegistry", "projectDag", "operations", "commands", "validationProfiles", "scopes", "evidenceReport", "blockers"],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "name": {"$ref": "#/$defs/identifier"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "standard": {"type": "object", "additionalProperties": false, "required": ["protocol", "version", "profile", "normativeAuthority", "projection"], "properties": {"protocol": {"const": "pre-sdd-harness/v3"}, "version": {"const": "3.0.0"}, "profile": {"const": "user"}, "normativeAuthority": {"const": "pre-sdd://harness-standard/v3"}, "projection": {"const": ".psp/harness/HARNESS-BOUNDARY.md"}}},
    "runtime": {"type": "object", "additionalProperties": false, "required": ["protocol", "authority", "entrypoint", "dependencyLock", "dependencyCache"], "properties": {"protocol": {"const": "pre-sdd-harness/v3"}, "authority": {"const": "generated-workspace-local"}, "entrypoint": {"const": ".psp/runtime/pre-sdd/bin/pre-sdd.mjs"}, "dependencyLock": {"const": "package-lock.json"}, "dependencyCache": {"const": "os-temporary-directory"}}},
    "entrypoints": {"type": "object", "additionalProperties": false, "required": ["instructions", "protocol", "boundary", "project", "manifest", "repository"], "properties": {"instructions": {"$ref": "#/$defs/path"}, "protocol": {"$ref": "#/$defs/path"}, "boundary": {"$ref": "#/$defs/path"}, "project": {"$ref": "#/$defs/path"}, "manifest": {"$ref": "#/$defs/path"}, "repository": {"$ref": "#/$defs/path"}}},
    "schemas": {"type": "object", "additionalProperties": false, "required": ["manifest", "project", "contract", "handoffReceipt", "consistencyReport", "evidenceReport"], "properties": {"manifest": {"$ref": "#/$defs/path"}, "project": {"$ref": "#/$defs/path"}, "contract": {"$ref": "#/$defs/path"}, "handoffReceipt": {"$ref": "#/$defs/path"}, "consistencyReport": {"$ref": "#/$defs/path"}, "evidenceReport": {"$ref": "#/$defs/path"}}},
    "codex": {"type": "object", "additionalProperties": false, "required": ["projectConfig", "hookConfig", "hookScripts", "repositorySkills"], "properties": {"projectConfig": {"$ref": "#/$defs/path"}, "hookConfig": {"$ref": "#/$defs/path"}, "hookScripts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/path"}}, "repositorySkills": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/path"}}}},
    "readOrder": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/path"}},
    "domainRegistry": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/domain"}},
    "artifactRegistry": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "projectDag": {"$ref": "#/$defs/projectDag"},
    "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/operation"}},
    "commands": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/command"}},
    "validationProfiles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/profile"}},
    "scopes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scope"}},
    "evidenceReport": {"type": "object", "additionalProperties": false, "required": ["schema", "requiredFields", "validationStates", "metrics"], "properties": {"schema": {"$ref": "#/$defs/path"}, "requiredFields": {"type": "array", "items": {"type": "string"}}, "validationStates": {"type": "array", "items": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"]}}, "metrics": {"type": "array", "items": {"type": "string"}}}},
    "blockers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/blocker"}}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "blockerCode": {"type": "string", "pattern": "^AIH_[A-Z0-9_]+$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[*!?\\[\\]{}]).+$"},
    "globPath": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+$"},
    "context": {"enum": ["local-edit", "explicit-consistency", "handoff", "pull-request", "main", "release"]},
    "cachePolicy": {"type": "object", "additionalProperties": false, "required": ["mode"], "properties": {"mode": {"enum": ["disabled", "operation", "content-addressed"]}}},
    "domain": {"type": "object", "additionalProperties": false, "required": ["id", "skill", "root"], "properties": {"id": {"$ref": "#/$defs/identifier"}, "skill": {"$ref": "#/$defs/identifier"}, "root": {"$ref": "#/$defs/path"}, "mirrors": {"type": "array", "items": {"$ref": "#/$defs/path"}}}},
    "artifactBase": {"type": "object", "properties": {"id": {"$ref": "#/$defs/identifier"}, "stage": {"$ref": "#/$defs/identifier"}, "domain": {"$ref": "#/$defs/identifier"}, "format": {"enum": ["yaml", "json", "typescript"]}, "contract": {"$ref": "#/$defs/path"}, "schema": {"$ref": "#/$defs/path"}}},
    "artifact": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["id", "stage", "domain", "authorityKind", "format", "contract", "schema", "template"], "properties": {"id": {"$ref": "#/$defs/identifier"}, "stage": {"$ref": "#/$defs/identifier"}, "domain": {"$ref": "#/$defs/identifier"}, "authorityKind": {"enum": ["internal-model", "internal-model-set"]}, "format": {"enum": ["yaml", "json"]}, "contract": {"$ref": "#/$defs/path"}, "schema": {"$ref": "#/$defs/path"}, "template": {"$ref": "#/$defs/path"}, "renderer": {"$ref": "#/$defs/identifier"}, "projections": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "renderer"], "properties": {"id": {"$ref": "#/$defs/identifier"}, "renderer": {"$ref": "#/$defs/identifier"}}}}}, "anyOf": [{"required": ["renderer"], "properties": {"renderer": {"$ref": "#/$defs/identifier"}}}, {"required": ["projections"], "properties": {"projections": {"type": "array", "minItems": 1}}}]},
      {"type": "object", "additionalProperties": false, "required": ["id", "stage", "domain", "authorityKind", "format", "contract", "schema", "projector"], "properties": {"id": {"$ref": "#/$defs/identifier"}, "stage": {"$ref": "#/$defs/identifier"}, "domain": {"$ref": "#/$defs/identifier"}, "authorityKind": {"enum": ["area", "area-set"]}, "format": {"enum": ["typescript", "json"]}, "contract": {"$ref": "#/$defs/path"}, "schema": {"$ref": "#/$defs/path"}, "memberSchemas": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/path"}}, "projector": {"$ref": "#/$defs/identifier"}, "projections": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "renderer"], "properties": {"id": {"$ref": "#/$defs/identifier"}, "renderer": {"$ref": "#/$defs/identifier"}}}}}}
    ]},
    "executor": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["kind", "path"], "properties": {"kind": {"const": "module"}, "path": {"$ref": "#/$defs/path"}, "args": {"type": "array", "items": {"type": "string"}}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "paths"], "properties": {"kind": {"const": "node-test"}, "paths": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/globPath"}}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "area", "script"], "properties": {"kind": {"const": "area-script"}, "area": {"$ref": "#/$defs/identifier"}, "script": {"$ref": "#/$defs/identifier"}}}
    ]},
    "command": {"type": "object", "additionalProperties": false, "required": ["id", "npmScript", "run", "purpose", "blocking", "executor", "allowedContexts", "costClass", "timeoutMs", "cache"], "properties": {"id": {"$ref": "#/$defs/identifier"}, "npmScript": {"type": "string", "minLength": 1}, "run": {"type": "string", "pattern": "^npm run "}, "purpose": {"type": "string", "minLength": 1}, "blocking": {"type": "boolean"}, "domain": {"$ref": "#/$defs/identifier"}, "executor": {"$ref": "#/$defs/executor"}, "allowedContexts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/context"}}, "costClass": {"enum": ["quick", "standard", "full"]}, "timeoutMs": {"type": "integer", "minimum": 1000}, "cache": {"$ref": "#/$defs/cachePolicy"}}},
    "operation": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["id", "kind", "npmScript", "run", "executor"], "properties": {"id": {"$ref": "#/$defs/identifier"}, "kind": {"const": "workspace"}, "npmScript": {"type": "string"}, "run": {"type": "string"}, "executor": {"$ref": "#/$defs/executor"}}},
      {"type": "object", "additionalProperties": false, "required": ["id", "kind", "npmScript", "run", "executor", "stage", "fromState", "toState", "areaTemplates", "commands"], "properties": {"id": {"$ref": "#/$defs/identifier"}, "kind": {"const": "stage"}, "npmScript": {"type": "string"}, "run": {"type": "string"}, "executor": {"$ref": "#/$defs/executor"}, "stage": {"$ref": "#/$defs/identifier"}, "fromState": {"const": "uninitialized"}, "toState": {"const": "active"}, "areaTemplates": {"type": "object", "additionalProperties": {"$ref": "#/$defs/path"}}, "commands": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identifier"}}}},
      {"type": "object", "additionalProperties": false, "required": ["id", "kind", "npmScript", "run", "executor", "domain", "stage", "artifacts"], "properties": {"id": {"$ref": "#/$defs/identifier"}, "kind": {"const": "artifact"}, "npmScript": {"type": "string"}, "run": {"type": "string"}, "executor": {"$ref": "#/$defs/executor"}, "domain": {"$ref": "#/$defs/identifier"}, "stage": {"$ref": "#/$defs/identifier"}, "artifacts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}}},
      {"type": "object", "additionalProperties": false, "required": ["id", "kind", "npmScript", "run", "executor", "domain", "stage", "artifact", "outputRole"], "properties": {"id": {"$ref": "#/$defs/identifier"}, "kind": {"const": "projection-refresh"}, "npmScript": {"type": "string"}, "run": {"type": "string"}, "executor": {"$ref": "#/$defs/executor"}, "domain": {"$ref": "#/$defs/identifier"}, "stage": {"$ref": "#/$defs/identifier"}, "artifact": {"$ref": "#/$defs/identifier"}, "outputRole": {"enum": ["generated-support", "runtime-projection"]}}},
      {"type": "object", "additionalProperties": false, "required": ["id", "kind", "npmScript", "run", "executor", "domain", "stage", "artifact", "packetSchemas"], "properties": {"id": {"$ref": "#/$defs/identifier"}, "kind": {"const": "ingest"}, "npmScript": {"type": "string"}, "run": {"type": "string"}, "executor": {"$ref": "#/$defs/executor"}, "domain": {"$ref": "#/$defs/identifier"}, "stage": {"$ref": "#/$defs/identifier"}, "artifact": {"$ref": "#/$defs/identifier"}, "packetSchemas": {"type": "object", "additionalProperties": false, "required": ["capturePlan", "acquisition", "receipt", "registration"], "properties": {"capturePlan": {"$ref": "#/$defs/path"}, "acquisition": {"$ref": "#/$defs/path"}, "receipt": {"$ref": "#/$defs/path"}, "registration": {"$ref": "#/$defs/path"}}}}},
      {"type": "object", "additionalProperties": false, "required": ["id", "kind", "npmScript", "run", "executor", "domain", "stage", "artifact", "prerequisiteCommands", "repairCommands"], "properties": {"id": {"$ref": "#/$defs/identifier"}, "kind": {"const": "repair"}, "npmScript": {"type": "string"}, "run": {"type": "string"}, "executor": {"$ref": "#/$defs/executor"}, "domain": {"$ref": "#/$defs/identifier"}, "stage": {"$ref": "#/$defs/identifier"}, "artifact": {"$ref": "#/$defs/identifier"}, "prerequisiteCommands": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}, "repairCommands": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}}},
      {"type": "object", "additionalProperties": false, "required": ["id", "kind", "npmScript", "run", "executor", "domain", "stage", "artifact", "profile", "evidenceVersion"], "properties": {"id": {"$ref": "#/$defs/identifier"}, "kind": {"const": "review"}, "npmScript": {"type": "string"}, "run": {"type": "string"}, "executor": {"$ref": "#/$defs/executor"}, "domain": {"$ref": "#/$defs/identifier"}, "stage": {"$ref": "#/$defs/identifier"}, "artifact": {"$ref": "#/$defs/identifier"}, "profile": {"$ref": "#/$defs/identifier"}, "evidenceVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}}},
      {"type": "object", "additionalProperties": false, "required": ["id", "kind", "npmScript", "run", "executor", "domain", "stage", "artifact", "profile", "evidenceVersion"], "properties": {"id": {"$ref": "#/$defs/identifier"}, "kind": {"const": "verification"}, "npmScript": {"type": "string"}, "run": {"type": "string"}, "executor": {"$ref": "#/$defs/executor"}, "domain": {"$ref": "#/$defs/identifier"}, "stage": {"$ref": "#/$defs/identifier"}, "artifact": {"$ref": "#/$defs/identifier"}, "profile": {"$ref": "#/$defs/identifier"}, "evidenceVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}}},
      {"type": "object", "additionalProperties": false, "required": ["id", "kind", "npmScript", "run", "executor", "domain", "stage", "artifact", "profile", "fromState", "toState", "receipt"], "properties": {"id": {"$ref": "#/$defs/identifier"}, "kind": {"const": "publish"}, "npmScript": {"type": "string"}, "run": {"type": "string"}, "executor": {"$ref": "#/$defs/executor"}, "domain": {"$ref": "#/$defs/identifier"}, "stage": {"$ref": "#/$defs/identifier"}, "artifact": {"$ref": "#/$defs/identifier"}, "profile": {"$ref": "#/$defs/identifier"}, "fromState": {"const": "active"}, "toState": {"const": "published"}, "receipt": {"$ref": "#/$defs/path"}}},
      {"type": "object", "additionalProperties": false, "required": ["id", "kind", "npmScript", "run", "executor", "domain", "stage", "artifact", "fromState", "toState", "receipt"], "properties": {"id": {"$ref": "#/$defs/identifier"}, "kind": {"const": "reopen"}, "npmScript": {"type": "string"}, "run": {"type": "string"}, "executor": {"$ref": "#/$defs/executor"}, "domain": {"$ref": "#/$defs/identifier"}, "stage": {"$ref": "#/$defs/identifier"}, "artifact": {"$ref": "#/$defs/identifier"}, "fromState": {"const": "published"}, "toState": {"const": "active"}, "receipt": {"$ref": "#/$defs/path"}}},
      {"type": "object", "additionalProperties": false, "required": ["id", "kind", "npmScript", "run", "executor", "receiptDirectory", "receiptSchema"], "properties": {"id": {"const": "handoff"}, "kind": {"const": "handoff"}, "npmScript": {"const": "handoff"}, "run": {"const": "npm run handoff"}, "executor": {"$ref": "#/$defs/executor"}, "receiptDirectory": {"const": ".psp/handoffs/receipts"}, "receiptSchema": {"const": ".psp/harness/schemas/handoff-receipt.schema.json"}}}
    ]},
    "profile": {"type": "object", "additionalProperties": false, "required": ["id", "version", "commands", "allowedContexts", "costClass", "timeoutMs", "cache"], "properties": {"id": {"$ref": "#/$defs/identifier"}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "commands": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}, "allowedContexts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/context"}}, "handoffSource": {"$ref": "#/$defs/identifier"}, "costClass": {"enum": ["quick", "standard", "full"]}, "timeoutMs": {"type": "integer", "minimum": 1000}, "cache": {"$ref": "#/$defs/cachePolicy"}}},
    "selector": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["type", "paths"], "properties": {"type": {"const": "static"}, "paths": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/globPath"}}}},
      {"type": "object", "additionalProperties": false, "required": ["type", "marker"], "properties": {"type": {"const": "workspace"}, "marker": {"$ref": "#/$defs/path"}}},
      {"type": "object", "additionalProperties": false, "required": ["type", "domain"], "properties": {"type": {"const": "domain"}, "domain": {"$ref": "#/$defs/identifier"}}},
      {"type": "object", "additionalProperties": false, "required": ["type", "stage"], "properties": {"type": {"const": "stage"}, "stage": {"$ref": "#/$defs/identifier"}}},
      {"type": "object", "additionalProperties": false, "required": ["type", "stage", "area"], "properties": {"type": {"const": "area"}, "stage": {"$ref": "#/$defs/identifier"}, "area": {"$ref": "#/$defs/identifier"}}},
      {"type": "object", "additionalProperties": false, "required": ["type", "stage", "artifacts"], "properties": {"type": {"const": "artifact"}, "stage": {"$ref": "#/$defs/identifier"}, "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identifier"}}, "areas": {"type": "array", "items": {"$ref": "#/$defs/identifier"}}}}
    ]},
    "scope": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "selectionGroup", "priority", "status", "selector", "defaultProfile", "consistencyProfile", "handoffProfile", "checkpointProfile", "mainProfile", "readinessProfile"], "properties": {"id": {"$ref": "#/$defs/identifier"}, "kind": {"enum": ["workspace", "repository", "domain", "stage", "artifact", "subtree"]}, "domain": {"$ref": "#/$defs/identifier"}, "selectionGroup": {"$ref": "#/$defs/identifier"}, "priority": {"type": "integer", "minimum": 0}, "status": {"enum": ["active", "unsupported"]}, "selector": {"$ref": "#/$defs/selector"}, "defaultProfile": {"$ref": "#/$defs/identifier"}, "consistencyProfile": {"$ref": "#/$defs/identifier"}, "handoffProfile": {"$ref": "#/$defs/identifier"}, "checkpointProfile": {"$ref": "#/$defs/identifier"}, "mainProfile": {"$ref": "#/$defs/identifier"}, "readinessProfile": {"$ref": "#/$defs/identifier"}, "uninitializedProfile": {"$ref": "#/$defs/identifier"}, "blockerCode": {"$ref": "#/$defs/blockerCode"}}},
    "dagNode": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["id", "kind", "stage", "validators"], "properties": {"id": {"$ref": "#/$defs/identifier"}, "kind": {"const": "stage"}, "stage": {"$ref": "#/$defs/identifier"}, "validators": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}}},
      {"type": "object", "additionalProperties": false, "required": ["id", "kind", "stage", "validators"], "properties": {"id": {"$ref": "#/$defs/identifier"}, "kind": {"const": "artifact"}, "stage": {"$ref": "#/$defs/identifier"}, "validators": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}}}
    ]},
    "dagEdge": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["from", "to", "type", "analysisCommand"], "properties": {"from": {"$ref": "#/$defs/identifier"}, "to": {"$ref": "#/$defs/identifier"}, "type": {"const": "dependency"}, "analysisCommand": {"const": "project-consistency"}}}, {"type": "object", "additionalProperties": false, "required": ["from", "to", "type", "profile"], "properties": {"from": {"$ref": "#/$defs/identifier"}, "to": {"$ref": "#/$defs/identifier"}, "type": {"const": "handoff"}, "profile": {"$ref": "#/$defs/identifier"}}}]},
    "projectDag": {"type": "object", "additionalProperties": false, "required": ["nodes", "edges"], "properties": {"nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/dagNode"}}, "edges": {"type": "array", "items": {"$ref": "#/$defs/dagEdge"}}}},
    "blocker": {"type": "object", "additionalProperties": false, "required": ["code", "severity", "owner", "gateClass", "meaning"], "properties": {"code": {"$ref": "#/$defs/blockerCode"}, "severity": {"enum": ["blocker", "high", "medium", "low"]}, "owner": {"$ref": "#/$defs/identifier"}, "domain": {"$ref": "#/$defs/identifier"}, "gateClass": {"enum": ["safety-structure", "domain-diagnostic", "ci-cd-policy"]}, "meaning": {"type": "string", "minLength": 1}}}
  }
}

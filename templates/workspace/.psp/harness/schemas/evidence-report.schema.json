{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psp.dev/schemas/v3/evidence-report.schema.json",
  "title": "Harness Standard v3 Evidence Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "executionContext", "status", "scope", "changes", "validation", "residuals", "metrics"],
  "properties": {
    "protocol": {"const": "pre-sdd-harness/v3"},
    "executionContext": {"$ref": "#/$defs/executionContext"},
    "status": {"$ref": "#/$defs/validationState"},
    "scope": {
      "oneOf": [
        {"type": "array", "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true},
        {"type": "object"}
      ]
    },
    "changes": {
      "type": "array",
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/path"},
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "kind"],
            "properties": {
              "path": {"$ref": "#/$defs/path"},
              "kind": {"enum": ["added", "modified", "deleted", "renamed"]}
            }
          }
        ]
      }
    },
    "validation": {"type": "array", "items": {"$ref": "#/$defs/commandEvidence"}},
    "residuals": {"type": "array", "items": {"$ref": "#/$defs/blocker"}},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plannedCommandCount", "executedCommandCount", "cacheHitCount", "notRunCount", "totalDurationMs"],
      "properties": {
        "plannedCommandCount": {"type": "integer", "minimum": 0},
        "executedCommandCount": {"type": "integer", "minimum": 0},
        "cacheHitCount": {"type": "integer", "minimum": 0},
        "notRunCount": {"type": "integer", "minimum": 0},
        "totalDurationMs": {"type": "integer", "minimum": 0}
      }
    },
    "credential": {"const": "validated-scaffold-change"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:|/|.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "executionContext": {"enum": ["local-edit", "explicit-consistency", "handoff", "pull-request", "main", "release"]},
    "validationState": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"]},
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": {"type": "string", "pattern": "^AIH_[A-Z0-9_]+$"},
        "message": {"type": "string", "minLength": 1},
        "gateClass": {"enum": ["safety-structure", "domain-diagnostic", "ci-cd-policy"]},
        "source": {"type": "string", "minLength": 1},
        "location": {"type": "string", "minLength": 1}
      }
    },
    "cacheBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standardDigest", "profileDigest", "executorDigest", "sourceDigest", "dependencyDigest", "runtimeDigest"],
      "properties": {
        "standardDigest": {"$ref": "#/$defs/digest"},
        "profileDigest": {"$ref": "#/$defs/digest"},
        "executorDigest": {"$ref": "#/$defs/digest"},
        "sourceDigest": {"$ref": "#/$defs/digest"},
        "dependencyDigest": {"$ref": "#/$defs/digest"},
        "runtimeDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "cacheEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "policy", "status", "reason", "bindings"],
      "properties": {
        "key": {"$ref": "#/$defs/digest"},
        "policy": {"enum": ["content-addressed", "disabled"]},
        "status": {"enum": ["HIT", "MISS", "BYPASS"]},
        "reason": {"type": "string", "minLength": 1},
        "bindings": {"$ref": "#/$defs/cacheBindings"}
      }
    },
    "commandEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commandId", "command", "selectedBy", "sourceScope", "scopeExpansionPath", "executionContext", "costClass", "timeoutMs", "inputDigest", "profileVersion", "cache", "status", "durationMs", "blockers"],
      "properties": {
        "commandId": {"$ref": "#/$defs/identifier"},
        "command": {"type": "string", "minLength": 1},
        "selectedBy": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
        "sourceScope": {"oneOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
        "scopeExpansionPath": {"type": "array", "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true},
        "executionContext": {"$ref": "#/$defs/executionContext"},
        "costClass": {"enum": ["quick", "standard", "full"]},
        "timeoutMs": {"type": "integer", "minimum": 1},
        "inputDigest": {"$ref": "#/$defs/digest"},
        "profileVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "cache": {"$ref": "#/$defs/cacheEvidence"},
        "status": {"$ref": "#/$defs/validationState"},
        "durationMs": {"type": "integer", "minimum": 0},
        "blockers": {"type": "array", "items": {"$ref": "#/$defs/blocker"}}
      }
    }
  }
}
